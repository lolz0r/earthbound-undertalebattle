diff --git a/include/bullet_hell.asm b/include/bullet_hell.asm
new file mode 100644
index 00000000..76fdf413
--- /dev/null
+++ b/include/bullet_hell.asm
@@ -0,0 +1,378 @@
+; ---------------------------------------------------------------------------
+; Bullet-hell (Undertale-style) dodge phase - shared constants.
+;
+; RAM usage:
+;   BH_DP       - 224 bytes in bank $7E low RAM (mirrored into bank 0), used as
+;                 the engine's direct page (D = BH_DP while engine code runs).
+;   BH_BULLETS  - overlays LOADED_COLLISION_TILES, an overworld-only buffer that
+;                 is rebuilt when the map reloads after every battle.
+; ---------------------------------------------------------------------------
+
+BH_MAX_BULLETS   = 32
+BH_BULLET_SIZE   = 16
+BH_IFRAME_LEN    = 40          ; invincibility frames after a hit
+BH_HIT_WINDDOWN  = 24          ; frames the box stays open after the hit that ends the phase
+BH_BOX_BOTTOM    = 144         ; screen y of the box's bottom edge (tile-aligned, just above the HP windows)
+BH_HEART_HALF    = 3           ; half size of the heart's hit box
+BH_ATTR_BASE     = $3E         ; OAM attribute: priority 3, palette 7
+BH_OBJ_PALETTE   = $1E0        ; byte offset of OBJ palette 7 inside PALETTES
+BH_NUM_PIECES    = 9           ; 32x32 tile pieces uploaded to sprite VRAM (a piece that finds no free slot gets tile $FFFF)
+BH_PIECE_BYTES   = 512
+
+; ---- direct page layout (offsets from BH_DP; all fields are 16-bit) ----
+BH_ACTIVE        = $00   ; nonzero while the dodge box is on screen
+BH_PHASE         = $02   ; 0 idle, 1 dodge running
+BH_YSHIFT        = $04   ; pixels enemy sprites are currently raised by
+BH_YSHIFT_TGT    = $06
+BH_TIMER         = $08   ; frames left in the dodge phase
+BH_HITS          = $0A
+BH_IFRAMES       = $0C
+; $0E-$11 reserved: pointer parameter slot used by EarthBound routines (LOADPTR x, $0E)
+BH_HEART_X       = $12   ; heart sprite top-left, screen pixels
+BH_HEART_Y       = $14
+BH_BOX_X0        = $16   ; box outer rectangle (x1/y1 exclusive)
+BH_BOX_Y0        = $18
+BH_BOX_X1        = $1A
+BH_BOX_Y1        = $1C
+BH_PAT_PTR       = $1E   ; 24-bit pointer to pattern bytecode ($1E-$20), $21 unused
+BH_PAT_WAIT      = $22   ; frames until the next opcode ($FFFF = pattern finished)
+BH_LOOP_PC       = $24
+BH_LOOP_CNT      = $26
+BH_CALLER_D      = $28   ; direct page of the EarthBound caller (a valid C stack frame)
+BH_FRAME         = $2A
+BH_SPEED         = $2C   ; bullet speed scale, 16 = 1.0
+BH_RESULT        = $2E
+BH_HEART_SPD     = $30
+; $32-$3D: minigame state (see below)
+BH_DMG_PCT       = $3E   ; damage percent for the action being resolved (0 = unscaled)
+BH_MOVED         = $50   ; heart moved this frame (blue/orange bullets)
+BH_MODE          = $52   ; 0 = dodge phase, 1 = FIGHT timing gauge, 2 rhythm, 3 focus, 4 mash, 5 slots, 6 combo
+BH_CURSOR_X      = $54   ; gauge cursor x (screen px of the 2px line)
+BH_FIGHT_STATE   = $56   ; 0 sweeping, 1 pressed (blinking)
+BH_FIGHT_TIMER   = $58
+BH_TBOX_X0       = $5A   ; final box rectangle while the box is animating open/closed
+BH_TBOX_Y0       = $5C
+BH_TBOX_X1       = $5E
+BH_TBOX_Y1       = $60
+BH_ANIM          = $62   ; nonzero while the box is opening/closing (heart and bullets hidden)
+BH_ENEMY_TYPE    = $64   ; attacking enemy's bullet types (from its record)
+BH_ENEMY_TYPE2   = $66
+BH_TEMPO         = $68   ; WAIT scale, 16 = 1.0
+BH_BOX_W_OVR     = $6A   ; box size overrides from the record (0 = pattern default)
+BH_BOX_H_OVR     = $6C
+BH_FIGHT_DIR     = $6E   ; reticle direction (+/- speed)
+BH_FIGHT_TIME    = $70   ; frames the reticle has been bouncing
+BH_THEME_TILE    = $72   ; VRAM tile of the attacking enemy's theme sheet ($FFFF = not loaded)
+BH_THEME_HB      = $74   ; 4 x (half width, half height) of the theme sprites ($74-$7B)
+BH_ENEMY_THEME   = $7C
+BH_THEME_PAL     = $7E   ; OBJ palette slot of the attacking enemy's sprite (0-3)
+BH_SHEET_ID      = $80   ; 4 words: enemy ids whose bullet sheets are in VRAM ($FFFF = none)
+BH_SHEET_TILE    = $88   ; 4 words: VRAM tile of each uploaded sheet
+BH_SPAWN_MODE    = $90   ; motion mode given to bullets spawned by the current opcode
+BH_FIGHT_RESULT  = $92   ; 0 = no gauge for this action, 1 = green hit (SMAAAASH), 2 = anything else (no crit)
+BH_THEME_BIG     = $94   ; nonzero when the attacking enemy's bullet sheet is one 32x32 sprite
+BH_FORCE         = $96   ; hit/miss override for the action being resolved: 0 normal, 1 always hits, 2 always misses
+BH_SAVED_ROLL    = $98   ; DISABLE_HPPP_ROLLING value to restore after a minigame
+BH_FORCE_PAT     = $9A   ; test hook: 0 = pattern by action type, 1 = force the physical program, 2 = force the PSI one
+BH_MG_PRESS      = $9E   ; word: low byte = lane (A B X Y = 0-3) of the last press, high byte = highlight frames left
+BH_PRESS_FRAMES  = 10    ; how long a press lights its icon (it also pops up 2 px for the first half)
+BH_FORCE_MG      = $9C   ; test hook: 0 = random, 1 gauge, 2 rhythm, 3 focus (attacks); 4 focus block, 5 dodge (enemy attacks)
+; ---- minigame state ($32-$3D; initialised by the minigame that uses it) ----
+; the rhythm game also uses BH_FIGHT_DIR (note speed, 12.4); the focus game BH_FIGHT_DIR (closing
+; speed, 12.4); the combo game BH_FIGHT_TIME (next step). Per-note / reel / step tables live in
+; the bullet table (idle during a minigame).
+BH_MG_COUNT      = $32   ; word: notes / reels stopped / steps; focus: 1 = blocking an enemy attack; mash: presses
+BH_MG_SCORE      = $34   ; word: points, fill, correct steps; focus: result 0 perfect, 1 good, 2 ok, 3 miss
+BH_MG_FB_TIMER   = $36   ; word: frames the floating grade label (or a reel bounce) stays
+BH_MG_FB_KIND    = $38   ; word: grade shown by the label (0 perfect, 1 good, 2 ok, 3 miss)
+BH_MG_FB_X       = $3A   ; word: rhythm: lane of the label; slots: reel that bounces
+BH_MG_DIST       = $3C   ; word: focus bracket distance from the centre, 12.4 fixed
+BH_PIECE_TILE    = $A0   ; 9 words ($A0-$B1): VRAM tile number of each uploaded piece ($FFFF = no free slot)
+BH_HINT_TILE     = $B2   ; 3 words: VRAM tiles of the current instruction line's pieces ($FFFF = no room)
+BH_HINT_LEN      = $B8   ; word: sprites in the current instruction line
+BH_HINT_PIECES   = 3
+BH_SHEET_END     = $BE   ; word: first sprite VRAM slot after the enemy sheets (the hint line goes there)
+BH_SAVED_FOCUS   = $BA   ; word: CURRENT_FOCUS_WINDOW before the box window opened
+BH_WIN_OPEN      = $BC   ; word: 1 while the box is a real game window (else the sprite border is drawn)
+BH_BOX_MAX_W     = 240   ; a game window holds at most 28 interior tiles per row
+BH_BOX_MAX_H     = 88    ; and the box must stay below the battle text window
+BHW_CFG          = 80    ; in BH_BULLETS: 4 words x, y, w, h in tiles, read by CREATE_WINDOW for the borrowed id
+BH_WINDOW_ID     = WINDOW::FILE_SELECT_NAMING_CONFIRMATION_MESSAGE  ; only used on the naming screen
+BH_WINDOW_BLANK  = 64    ; the window system's blank interior tile
+; the Set Up option "Battle games: Standard / Per attack" lives in an event flag the game
+; never uses (FLG_GUMI_8_BOOK), so it is saved with the file and existing saves read as off
+BH_OPT_FLAG      = 431
+BH_OPT_BYTE      = (BH_OPT_FLAG - 1) / 8
+BH_OPT_MASK      = 1 << ((BH_OPT_FLAG - 1) & 7)
+; the frame tiles are opaque and in front of every sprite; BG3 sits one line
+; above the sprite grid, so the visible interior is x0+8..x1-9, y0+7..y1-10
+BH_FRAME_LEFT    = 8
+BH_FRAME_RIGHT   = 8
+BH_FRAME_TOP     = 7
+BH_FRAME_BOTTOM  = 9
+BHR_D            = 0     ; rhythm: 5 words, distance of each note to its target, 12.4 fixed (negative = past it)
+BHR_ST           = 16    ; rhythm: 5 words, lane in the high byte, state in the low byte (0 pending, 1-4 graded, 4 also = unused)
+BHS_SYM          = 32    ; slots: 3 words, symbol shown by each reel (0-3)
+BHS_STOP         = 40    ; slots: 3 words, 1 once the reel is stopped
+BHC_SEQ          = 48    ; combo: 5 words, lane of each step
+BHC_ST           = 64    ; combo: 5 words, 0 pending, 1 right, 2 wrong, 3 out of time
+BH_MASH_FRAMES   = 150
+BH_MASH_FULL     = 144   ; nine blocks of 16
+BH_SLOTS_STEP    = 6     ; frames per symbol while a reel spins
+BH_SLOTS_FRAMES  = 240   ; the reels stop by themselves afterwards
+BH_COMBO_FRAMES  = 180
+BH_RHYTHM_BOX_W  = 176
+BH_RHYTHM_BOX_H  = 88
+BH_FOCUS_BOX_W   = 160
+BH_FOCUS_BOX_H   = 88
+BH_FOCUS_START   = 32    ; bracket distance (px) the focus game starts from
+BH_FOCUS_TARGET  = 8     ; bracket distance (px) that means "in focus"
+BH_NOTE_PERFECT  = 4     ; px from the hit line
+BH_NOTE_GOOD     = 10
+BH_NOTE_OK       = 18
+BH_FOCUS_PERFECT = 2
+BH_FOCUS_GOOD    = 6
+BH_FOCUS_OK      = 12
+BH_FIGHT_YELLOW  = 40    ; half width of the zone (green + yellow) that always connects
+BH_RED_MISS_CHANCE = 179 ; out of 256: a press in the red misses 70% of the time
+BH_BOX_ANIM_FRAMES = 8
+BH_RISE_STEP     = 8    ; px per frame the enemies slide up/down
+BH_HIDE_MARGIN   = 40   ; how far above the screen enemies go during a dodge phase
+BH_T0            = $40   ; scratch
+BH_T1            = $42
+BH_T2            = $44
+BH_T3            = $46
+BH_T4            = $48
+BH_T5            = $4A
+BH_T6            = $4C
+BH_T7            = $4E
+BH_DP_SIZE       = $C0   ; bytes cleared at battle start (everything below the persistent area)
+; --- persistent part of the block (not cleared): PPU mirrors and HDMA table ---
+BH_W12SEL_MIRROR = $C0   ; byte
+BH_WOBJSEL_MIRROR= $C1   ; byte
+BH_TMW_MIRROR    = $C2   ; byte
+BH_HDMA_WHICH    = $C3   ; byte: which of the two HDMA tables is in use
+BH_HDMA_TABLE    = $C4   ; 2 x 12 bytes: double-buffered window 2 HDMA tables ($C4, $D0)
+BH_HDMA_TABLE_B  = $D0
+BH_SLOT_LIMIT    = $DE   ; word: sprite VRAM slots usable by the engine (32, or 16 where BG2 shares the OBJ area)
+BH_GFX_SLOT      = $DC   ; word: enemy piece slot count when our tiles were uploaded ($FFFF = never)
+BH_HDMA_CHANNEL  = $80   ; HDMAEN bit for channel 7 (the game uses 0-6: backgrounds, letterbox, swirl and oval windows)
+
+; ---- enemy record (bh_enemies.asm) ----
+BHE_PAT_PHYS     = 0    ; word
+BHE_PAT_PSI      = 2    ; word
+BHE_TYPE         = 4
+BHE_TYPE2        = 5
+BHE_SPEED        = 6
+BHE_TEMPO        = 7
+BHE_BOX_W        = 8
+BHE_BOX_H        = 9
+BHE_CATEGORY     = 10
+BHE_FLAGS        = 11
+BHE_SIZE         = 12
+
+; ---- bullet record ----
+BHB_X            = 0     ; 12.4 fixed point screen x of the sprite's top-left
+BHB_Y            = 2
+BHB_VX           = 4
+BHB_VY           = 6
+BHB_TYPE         = 8     ; 0 = free slot
+BHB_LIFE         = 9     ; frames until removal, 0 = until off screen
+BHB_ATTR         = 10    ; extra OAM attribute bits (flips)
+BHB_MODE         = 11    ; motion: 0 straight, 1 wave (life = phase), 2 seek the heart, 3 gravity
+BHB_TILE         = 12    ; resolved once at spawn: OAM tile (word), hit box half width/height
+BHB_HW           = 14
+BHB_HH           = 15
+BH_MODE_WAVE     = 1
+BH_MODE_SEEK     = 2
+BH_MODE_GRAVITY  = 3
+BH_MODE_BIG      = $80  ; bit 7 of the mode byte: 32x32 bullet (big enemies' own sprite)
+
+; ---- bullet / sprite types (index into BH_TYPE_TABLE, 1-based) ----
+BH_TYPE_HEART    = 1
+BH_TYPE_ROUND    = 2
+BH_TYPE_FLAME    = 3
+BH_TYPE_DOT      = 4
+BH_TYPE_BONE_TOP = 5
+BH_TYPE_BONE     = 6
+BH_TYPE_BLUE     = 7
+BH_TYPE_ORANGE   = 8
+BH_TYPE_GAUGE_RED = 9
+BH_TYPE_GAUGE_YEL = 10
+BH_TYPE_GAUGE_GRN = 11
+BH_TYPE_CURSOR   = 12
+BH_TYPE_THEME0   = 13   ; the four sprites of the attacking enemy's theme sheet
+BH_TYPE_BRACKET  = 17
+BH_TYPE_CROSSHAIR= 18
+BH_TYPE_BUTTON_A = 19    ; lane buttons: A, then B (22), X (23), Y (24)
+BH_TYPE_SPARK    = 20
+BH_TYPE_VLINE    = 21
+BH_TYPE_BUTTON_B = 22
+BH_TYPE_BUTTON_X = 23
+BH_TYPE_BUTTON_Y = 24
+BH_TYPE_LBL_PER  = 25
+BH_TYPE_LBL_FEC  = 26
+BH_TYPE_LBL_T    = 27
+BH_TYPE_LBL_GOO  = 28
+BH_TYPE_LBL_D    = 29
+BH_TYPE_LBL_OK   = 30
+BH_TYPE_LBL_MIS  = 31
+BH_TYPE_LBL_S    = 32
+BH_TYPE_SLOT_CHERRY = 33  ; slot symbols: cherry, bell, seven, star
+BH_TYPE_RING     = 37    ; white ring drawn over a button icon while its button is pressed
+BH_TYPE_HLINE16  = 38    ; 16 px horizontal line
+BH_TYPE_ARROW_U  = 39    ; up arrow (OAM v-flip: down)
+BH_TYPE_ARROW_R  = 40    ; right arrow (OAM h-flip: left)
+
+; ---- attack-specific games (bh_attack_games.asm): BH_AG_STATE layout ----
+BH_MODE_ATTACK   = 7     ; BH_MODE while one plays
+BHAG_BLOCK       = 0     ; the mechanic (BH_BLK_*)
+BHAG_MOD         = 1     ; a modifier mechanic on top, or 0
+BHAG_P0          = 2     ; four parameter bytes (meaning per block, see the generator)
+BHAG_P1          = 3
+BHAG_P2          = 4
+BHAG_P3          = 5     ; the modifier's parameter
+BHAG_HINT        = 6     ; instruction line
+BHAG_TEST        = 7     ; test hook: nonzero = play this block with default parameters
+BHAG_TIMER       = 8     ; word: frames left before the game resolves on its own
+BHAG_HITS        = 10    ; word: hits taken
+BHAG_STEP        = 12    ; word: block-specific phase/step
+BHAG_A           = 14    ; words: block-specific state
+BHAG_B           = 16
+BHAG_C           = 18
+BHAG_D           = 20
+BHAG_E           = 22
+BHAG_F           = 24
+BHAG_ARR         = 26    ; 16 bytes: sequences, cells
+BHAG_Q0          = 42    ; words: the four parameters unpacked at the start of the game
+BHAG_Q1          = 44
+BHAG_Q2          = 46
+BHAG_Q3          = 48
+BHAG_AMOD        = 50    ; word: the modifier block in force (0 none; also during a standard dodge phase)
+BHAG_LIGHT       = 52    ; word: 1 while sprites outside the spotlight are being skipped (BH_OAM_PUT)
+BHAG_H2X         = 54    ; words: the second heart (two hearts)
+BHAG_H2Y         = 56
+BHAG_WALL        = 58    ; word: closing walls' inset in px
+BHAG_FRZ         = 60    ; word: freeze state 0 idle / 1 warning / 2 frozen
+BHAG_FRZT        = 62    ; word: frames left in that state
+BHAG_MODARR      = 64    ; 16 bytes: the lag ring (scrambled controls) - separate from the block's BHAG_ARR
+BHAG_TESTMOD     = 80    ; byte: test hook, a modifier forced onto the forced block (see BHAG_TEST)
+BHAG_SIZE        = 82
+BH_BLK_DODGE     = 1
+BH_BLK_BRACKET   = 2
+BH_BLK_CELLS     = 3
+BH_BLK_SWEEPS    = 4
+BH_BLK_HOLD      = 5
+BH_BLK_ARROWS    = 6
+BH_BLK_SCRAMBLE  = 7
+BH_BLK_PULL      = 8
+BH_BLK_WALLS     = 9
+BH_BLK_CATCH     = 10
+BH_BLK_SPOTLIGHT = 11
+BH_BLK_WIGGLE    = 12
+BH_BLK_COUNTER   = 13
+BH_BLK_BEAT      = 14
+BH_BLK_FACE      = 15
+BH_BLK_PICK      = 16
+BH_BLK_FREEZE    = 17
+BH_BLK_COPY      = 18
+BH_BLK_STEPS     = 19
+BH_BLK_TWO       = 20
+BH_AG_MAX_BLOCK  = 20
+BH_TYPE_THEME1   = 14
+BH_TYPE_THEME2   = 15
+BH_TYPE_THEME3   = 16
+BH_TYPE_ENEMY    = $FE  ; in patterns: the enemy record's bullet type
+BH_TYPE_ENEMY2   = $FD  ; in patterns: the enemy record's secondary bullet type
+BH_THEME_COUNT   = 10
+BH_BASE_PIECES   = 5    ; pieces uploaded for every battle; theme sheets follow in bh_tiles.bin
+
+BH_FIGHT_BOX_W   = 160
+BH_FIGHT_BOX_H   = 56
+BH_FIGHT_CURSOR_SPEED = 3
+BH_FIGHT_TIMEOUT = 240  ; frames the reticle bounces before the attack whiffs
+BH_FIGHT_GREEN   = 8    ; half width of the perfect (green) zone in pixels
+
+; ---- pattern bytecode opcodes ----
+BH_OP_END        = 0
+BH_OP_WAIT       = 1
+BH_OP_SPAWN      = 2
+BH_OP_LOOP       = 3
+BH_OP_ENDLOOP    = 4
+BH_OP_AIMED      = 5
+BH_OP_RAIN       = 6
+BH_OP_SIDE       = 7
+BH_OP_RWAIT      = 8
+BH_OP_WALL       = 9
+BH_OP_RISE       = 10
+BH_OP_RING       = 11
+BH_OP_WAVE       = 12   ; like SIDE, but the bullet slithers up and down
+BH_OP_SEEK       = 13   ; like AIMED, but the bullet keeps steering towards the heart
+BH_OP_DROP       = 14   ; like RAIN, but the bullet accelerates downwards
+
+BH_EDGE_TOP      = 0
+BH_EDGE_BOTTOM   = 1
+BH_EDGE_LEFT     = 2
+BH_EDGE_RIGHT    = 3
+BH_EDGE_ANY      = 4
+
+; ---- pattern authoring macros ----
+.MACRO BH_HEADER w, h, frames
+	.BYTE w, h
+	.WORD frames
+.ENDMACRO
+.MACRO BH_WAIT n
+	.BYTE BH_OP_WAIT, n
+.ENDMACRO
+.MACRO BH_SPAWN type, xx, yy, vx, vy
+	.BYTE BH_OP_SPAWN, type, <(xx), <(yy)
+	.WORD .LOWORD(vx), .LOWORD(vy)
+.ENDMACRO
+.MACRO BH_LOOP n
+	.BYTE BH_OP_LOOP, n
+.ENDMACRO
+.MACRO BH_ENDLOOP
+	.BYTE BH_OP_ENDLOOP
+.ENDMACRO
+.MACRO BH_AIMED type, edge, speed
+	.BYTE BH_OP_AIMED, type, edge, speed
+.ENDMACRO
+.MACRO BH_RAIN type, speed
+	.BYTE BH_OP_RAIN, type, speed
+.ENDMACRO
+.MACRO BH_SIDE type, speed
+	.BYTE BH_OP_SIDE, type, speed
+.ENDMACRO
+.MACRO BH_RWAIT lo, hi
+	.BYTE BH_OP_RWAIT, lo, hi
+.ENDMACRO
+.MACRO BH_WALL type, gap, speed
+	.BYTE BH_OP_WALL, type, gap, speed
+.ENDMACRO
+.MACRO BH_RISE type, speed
+	.BYTE BH_OP_RISE, type, speed
+.ENDMACRO
+.MACRO BH_RING type, count, speed
+	.BYTE BH_OP_RING, type, count, speed
+.ENDMACRO
+.MACRO BH_WAVE type, speed
+	.BYTE BH_OP_WAVE, type, speed
+.ENDMACRO
+.MACRO BH_SEEK type, edge, speed
+	.BYTE BH_OP_SEEK, type, edge, speed
+.ENDMACRO
+.MACRO BH_DROP type, speed
+	.BYTE BH_OP_DROP, type, speed
+.ENDMACRO
+.MACRO BH_END
+	.BYTE BH_OP_END
+.ENDMACRO
+
+; HDMA channel 7 registers (hardware.asm only names channels 0-5)
+.IFNDEF DMAP7
+DMAP7  = $4370
+BBAD7  = $4371
+A1T7L  = $4372
+A1B7   = $4374
+DASB7  = $4377
+.ENDIF
diff --git a/include/config.asm b/include/config.asm
index e3afab7e..bb4dbd84 100644
--- a/include/config.asm
+++ b/include/config.asm
@@ -141,7 +141,14 @@
 	.DEFINE PSI_CATEGORY_NAME_SIZE 8
 	.DEFINE PSI_NAME_SIZE 25
 .ELSE
-	.DEFINE DEBUG_BUILD 0
+	.IF .DEFINED(BH_DEBUG)
+		.DEFINE DEBUG_BUILD 1
+	.ELSE
+		.DEFINE DEBUG_BUILD 0
+	.ENDIF
+	; the hack is a modified 4 MB ROM: skip the copy-protection checks (SRAM mirror test,
+	; region test, and the two checksums of that code that swarm enemies / freeze Giygas)
+	.DEFINE NO_ANTIPIRACY 1
 
