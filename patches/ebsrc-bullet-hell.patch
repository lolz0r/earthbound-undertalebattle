+; Sprite graphics for the bullet-hell dodge phase (generated by tools/gen_bh_gfx.py)
+BH_TILES:
+	.INCBIN "bin/bh/bh_tiles.bin"
+BH_PALETTE:
+	.INCBIN "bin/bh/bh_palette.bin"
+
+; Per sprite type: piece index, tile offset inside the piece, size (0=16x16, 1=32x32),
+; hit box half width, hit box half height, extra attribute bits.
+BH_TYPE_TABLE:
+	.BYTE 0,  0, 0, 3, 3, 0    ; 1 heart
+	.BYTE 0,  2, 0, 3, 3, 0    ; 2 round bullet
+	.BYTE 0, 32, 0, 3, 5, 0    ; 3 flame
+	.BYTE 0, 34, 0, 1, 1, 0    ; 4 dot
+	.BYTE 4,  0, 0, 3, 6, 0    ; 5 bone top
+	.BYTE 4,  2, 0, 2, 8, 0    ; 6 bone shaft
+	.BYTE 4, 32, 0, 3, 3, 0    ; 7 blue block
+	.BYTE 4, 34, 0, 3, 3, 0    ; 8 orange block
+	.BYTE 3,  0, 0, 0, 0, 0    ; 9 gauge red block
+	.BYTE 3,  2, 0, 0, 0, 0    ; 10 gauge yellow block
+	.BYTE 3, 32, 0, 0, 0, 0    ; 11 gauge green block
+	.BYTE 3, 34, 0, 0, 0, 0    ; 12 gauge cursor
+	.BYTE $80,  0, 0, 3, 3, 0  ; 13 theme sprite 0 (piece $80 = the enemy's theme sheet; hit box from the theme)
+	.BYTE $80,  2, 0, 3, 3, 0  ; 14 theme sprite 1
+	.BYTE $80, 32, 0, 3, 3, 0  ; 15 theme sprite 2
+	.BYTE $80, 34, 0, 3, 3, 0  ; 16 theme sprite 3
+	.BYTE 5,  0, 0, 0, 0, 0    ; 17 focus bracket (top-left corner; flips give the others)
