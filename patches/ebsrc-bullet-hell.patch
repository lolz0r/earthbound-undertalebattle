diff --git a/src/battle/bullet_hell/bh_ag_engine.asm b/src/battle/bullet_hell/bh_ag_engine.asm
new file mode 100644
index 00000000..c2e54740
--- /dev/null
+++ b/src/battle/bullet_hell/bh_ag_engine.asm
@@ -0,0 +1,3639 @@
+; ===========================================================================
+; Attack-specific minigames ("Battle games: Per attack" in Set Up).
+;   BH_AG_LOOKUP finds the entry for the attacking enemy and its action in the
+;   generated table (bank $30) and copies it into BH_AG_STATE; BH_ATTACK_GAME
+;   then runs the block named there. Blocks share the minigame scaffolding
+;   (BH_MG_START_NOOPEN / BH_MG_FRAME / BH_MG_FINISH), the heart and its input,
+;   and grade like the timed block: PERFECT dodges the attack, GOOD/OK scale
+;   it to 50 % / 75 %, MISS lets it land in full.
+; ===========================================================================
+
+; A = 1 when BH_AG_STATE was filled for CURRENT_ATTACKER's enemy id (BH_T3) and action
+BH_AG_LOOKUP:
+	LDA BH_AG_STATE + BHAG_TEST
+	AND #$00FF
+	BNE @forced
+	LDA z:BH_T3
+	ASL
+	TAX
+	LDA f:BH_AG_INDEX,X
+	CMP #$FFFF
+	BEQ @none
+	TAX
+	LDA f:BH_AG_DATA,X
+	AND #$00FF
+	STA z:BH_T7             ; entries
+	INX
+	LDY CURRENT_ATTACKER
+	LDA a:battler::current_action,Y
+	STA z:BH_T5
+@scan:
+	LDA f:BH_AG_DATA,X
+	CMP z:BH_T5
+	BEQ @found
+	TXA
+	CLC
+	ADC #9
+	TAX
+	DEC z:BH_T7
+	BNE @scan
+@none:
+	LDA #0
+	RTS
+@found:
+	INX
+	INX                     ; the seven bytes after the action word
+	LDY #0
+@copy:
+	LDA f:BH_AG_DATA,X
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_BLOCK,Y
+	REP #PROC_FLAGS::ACCUM8
+	INX
+	INY
+	CPY #7
+	BCC @copy
+	LDA #1
+	RTS
+@forced:
+	; test hook: the block in BHAG_TEST with the defaults of BH_AG_DEFAULTS
+	AND #$00FF
+	STA z:BH_T5
+	DEC
+	ASL
+	STA z:BH_T6
+	ASL
+	CLC
+	ADC z:BH_T6             ; (block-1)*6
+	TAX
+	LDY #0
+@dcopy:
+	LDA f:BH_AG_DEFAULTS,X
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_MOD,Y
+	REP #PROC_FLAGS::ACCUM8
+	INX
+	INY
+	CPY #6
+	BCC @dcopy
+	LDA z:BH_T5
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_BLOCK
+	; a forced modifier block plays the dodge box with that modifier; BHAG_TESTMOD
+	; lays a modifier (and its default p3) over any forced block
+	LDA BH_AG_STATE + BHAG_TESTMOD
+	BNE @test_mod
+	LDA z:BH_T5
+	CMP #BH_BLK_SCRAMBLE
+	BEQ @as_mod
+	CMP #BH_BLK_PULL
+	BEQ @as_mod
+	CMP #BH_BLK_WALLS
+	BEQ @as_mod
+	CMP #BH_BLK_SPOTLIGHT
+	BEQ @as_mod
+	CMP #BH_BLK_FREEZE
+	BEQ @as_mod
+	CMP #BH_BLK_TWO
+	BNE @forced_done
+@as_mod:
+	STA BH_AG_STATE + BHAG_MOD
+	LDA #BH_BLK_DODGE
+	STA BH_AG_STATE + BHAG_BLOCK
+	BRA @forced_done
+@test_mod:
+	STA BH_AG_STATE + BHAG_MOD
+	REP #PROC_FLAGS::ACCUM8
+	AND #$00FF
+	DEC
+	ASL
+	STA z:BH_T6
+	ASL
+	CLC
+	ADC z:BH_T6
+	TAX
+	LDA f:BH_AG_DEFAULTS + 4,X
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_P3
+@forced_done:
+	REP #PROC_FLAGS::ACCUM8
+	LDA #1
+	RTS
+
+; per block: modifier, p0, p1, p2, p3, hint (the test hook's defaults)
+BH_AG_DEFAULTS:
+	.BYTE 0, 0, 0, 0, 0, 6      ; 1 dodge
+	.BYTE 0, 0, 0, 0, 0, 2      ; 2 bracket
+	.BYTE 0, 24, 48, 4, 0, 7    ; 3 hop: wave speed, frames between waves, waves
+	.BYTE 0, 4, 32, 4, 0, 8     ; 4 sweeps: alternate left/right, 32 px gap, 4 bars
+	.BYTE 0, 3, 14, 60, 0, 9    ; 5 hold
+	.BYTE 0, 4, 10, 0, 0, 10    ; 6 arrows
+	.BYTE 0, 0, 0, 0, 0, 19     ; 7 scramble
+	.BYTE 0, 0, 0, 0, $21, 20    ; 8 pull
+	.BYTE 0, 0, 0, 0, 1, 21     ; 9 walls
+	.BYTE 0, 3, 5, 16, 0, 11    ; 10 catch
+	.BYTE 0, 0, 0, 0, 48, 22    ; 11 spotlight
+	.BYTE 0, 32, 1, 180, 0, 12  ; 12 wiggle
+	.BYTE 0, 2, 20, 0, 0, 13    ; 13 counter
+	.BYTE 0, 6, 0, 8, 0, 14     ; 14 beat
+	.BYTE 0, 3, 30, 0, 0, 15    ; 15 face
+	.BYTE 0, 4, 14, 2, 0, 16    ; 16 pick
+	.BYTE 0, 0, 0, 0, 90, 23    ; 17 freeze
+	.BYTE 0, 4, 24, 0, 0, 17    ; 18 copy
+	.BYTE 0, 16, 4, 240, 0, 18  ; 19 steps
+	.BYTE 0, 0, 0, 0, 0, 24     ; 20 two hearts
+
+; ---------------------------------------------------------------------------
+; BH_ATTACK_GAME - play the block in BH_AG_STATE (called like BH_RUN_PHASE)
+; ---------------------------------------------------------------------------
+BH_ATTACK_GAME:
+	STZ z:BH_HITS
+	STZ z:BH_IFRAMES
+	STZ z:BH_DMG_PCT
+	; the block's state (timer, hits, step, A-F, the array) starts clear: a stale
+	; column count from the last game once drew a grid far outside the box
+	LDX #BHAG_TIMER
+:	STZ BH_AG_STATE,X
+	INX
+	INX
+	CPX #BHAG_Q0
+	BCC :-
+	LDA #176
+	STA z:BH_T0
+	LDA #80
+	STA z:BH_T1             ; default box, blocks may change it
+	LDA BH_AG_STATE + BHAG_HINT
+	AND #$00FF
+	STA z:BH_HINT_LEN
+	; the parameter bytes as words, for comparisons and multiplies
+	LDX #0
+@unpack:
+	LDA BH_AG_STATE + BHAG_P0,X
+	AND #$00FF
+	STA z:BH_T2
+	TXA
+	ASL
+	TAY
+	LDA z:BH_T2
+	STA BH_AG_STATE + BHAG_Q0,Y
+	INX
+	CPX #4
+	BCC @unpack
+	LDA BH_AG_STATE + BHAG_MOD
+	AND #$00FF
+	STA BH_AG_STATE + BHAG_AMOD
+	JSR BH_AG_MOD_INIT
+	LDA BH_AG_STATE + BHAG_BLOCK
+	AND #$00FF
+	BEQ @fallback
+	CMP #BH_AG_MAX_BLOCK + 1
+	BCS @fallback
+	CMP #BH_BLK_DODGE
+	BEQ @dodge              ; the enemy's own bullet pattern, with the modifier
+	CMP #BH_BLK_BRACKET
+	BEQ @bracket
+	ASL
+	TAX
+	JSR (.LOWORD(BH_AG_INIT_TABLE),X)
+	BNE @ready
+@fallback:
+	STZ BH_AG_STATE + BHAG_AMOD
+@dodge:
+	JMP BH_RUN_PHASE
+@bracket:
+	STZ BH_AG_STATE + BHAG_AMOD
+	LDA z:BH_PIECE_TILE + 10
+	CMP #$FFFF
+	BEQ @dodge
+	LDA #1
+	JMP BH_FOCUS_PHASE      ; the timed block
+@ready:
+	LDA #BH_MODE_ATTACK
+	JSR BH_MG_START_NOOPEN
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_MG_FRAME
+	BNE @alive
+	JMP BH_MG_FINISH
+@alive:
+	LDA z:BH_FIGHT_STATE
+	BNE @loop               ; resolved: winding down
+	LDA z:BH_IFRAMES
+	BEQ :+
+	DEC z:BH_IFRAMES
+:	LDA BH_AG_STATE + BHAG_TIMER
+	BEQ :+
+	DEC BH_AG_STATE + BHAG_TIMER
+:	LDA BH_AG_STATE + BHAG_BLOCK
+	AND #$00FF
+	ASL
+	TAX
+	JSR (.LOWORD(BH_AG_UPDATE_TABLE),X)
+	LDA z:BH_FIGHT_STATE
+	BNE @loop
+	JSR BH_AG_MOD_UPDATE
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #34                 ; the heart stays above the instruction line
+	CMP z:BH_HEART_Y
+	BCS @loop
+	STA z:BH_HEART_Y
+	BRA @loop
+
+; the block's outcome: A = grade (0 perfect .. 3 miss) -> label, sound, damage, wind-down
+BH_AG_RESOLVE:
+	STA z:BH_MG_SCORE
+	JSR BH_GRADE_FEEDBACK
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #36
+	STA z:BH_FIGHT_TIMER
+	LDA z:BH_MG_SCORE
+	ASL
+	TAX
+	LDA f:BH_FOCUS_DEF_PCT,X
+	STA z:BH_DMG_PCT
+	BEQ @dodged
+	LDA #1
+	STA z:BH_HITS
+	RTS
+@dodged:
+	STZ z:BH_HITS
+	RTS
+
+; hits taken -> grade: none = PERFECT, one GOOD, two OK, more MISS
+BH_AG_RESOLVE_BY_HITS:
+	LDA BH_AG_STATE + BHAG_HITS
+	CMP #3
+	BCC :+
+	LDA #3
+:	JMP BH_AG_RESOLVE
+
+; a hit on the heart (with the dodge box's invincibility frames and sound)
+BH_AG_HIT:
+	LDA z:BH_IFRAMES
+	BNE @done
+	INC BH_AG_STATE + BHAG_HITS
+	LDA #BH_IFRAME_LEN
+	STA z:BH_IFRAMES
+	PHX
+	LDA #SFX::TOOK_DAMAGE
+	JSL PLAY_SOUND
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PLX
+@done:
+	RTS
+
+; the heart at its position (blinking while invincible) and the grade label above it
+BH_AG_DRAW_HEART:
+	LDA z:BH_IFRAMES
+	BEQ @draw
+	AND #4
+	BNE @label
+@draw:
+	LDA z:BH_HEART_X
+	STA z:BH_T0
+	LDA z:BH_HEART_Y
+	STA z:BH_T1
+	LDA z:BH_PIECE_TILE + 0
+	STA z:BH_T2
+	STZ z:BH_T3
+	LDA #BH_ATTR_BASE
+	STA z:BH_T4
+	JSR BH_OAM_PUT
+@label:
+	LDA z:BH_MG_FB_TIMER
+	BEQ @done
+	LDA z:BH_HEART_X
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_HEART_Y
+	SEC
+	SBC #14
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+@done:
+	RTS
+
+; the enemy's own bullet sprite when its sheet is loaded, else the given line type
+; A = fallback type -> tile scratch resolved
+BH_AG_SEGMENT_TILE:
+	LDX z:BH_THEME_TILE
+	CPX #$FFFF
+	BEQ :+
+	LDA #BH_TYPE_THEME0
+:	JMP BH_TILE_FOR_TYPE
+
+; A = 0..255 random -> A = 0..(BH_T7 - 1)
+BH_AG_RAND_BELOW:
+	JSL RAND
+	LDY z:BH_T7
+	JSL MULT168
+	XBA
+	AND #$00FF
+	RTS
+
+BH_RENDER_ATTACK:
+	LDA #1
+	STA BH_AG_STATE + BHAG_LIGHT   ; the spotlight, when one is in force, hides the block's sprites
+	LDA BH_AG_STATE + BHAG_BLOCK
+	AND #$00FF
+	ASL
+	TAX
+	JSR (.LOWORD(BH_AG_RENDER_TABLE),X)
+	STZ BH_AG_STATE + BHAG_LIGHT
+	JMP BH_AG_MOD_RENDER
+
+BH_AG_INIT_NONE:
+	LDA #0
+	RTS
+BH_AG_NOP:
+	RTS
+
+BH_AG_INIT_TABLE:
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 0
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 1 dodge (the standard phase)
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 2 bracket
+	.WORD .LOWORD(BH_AG_HOP_INIT)  ; 3 cells
+	.WORD .LOWORD(BH_AG_SWEEPS_INIT) ; 4 sweeps
+	.WORD .LOWORD(BH_AG_HOLD_INIT)   ; 5 hold
+	.WORD .LOWORD(BH_AG_ARROWS_INIT) ; 6 arrows
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 7
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 8
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 9
+	.WORD .LOWORD(BH_AG_CATCH_INIT)  ; 10 catch
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 11
+	.WORD .LOWORD(BH_AG_WIGGLE_INIT) ; 12 wiggle
+	.WORD .LOWORD(BH_AG_COUNTER_INIT) ; 13 counter
+	.WORD .LOWORD(BH_AG_BEAT_INIT)   ; 14 beat
+	.WORD .LOWORD(BH_AG_FACE_INIT)   ; 15 face
+	.WORD .LOWORD(BH_AG_PICK_INIT)   ; 16 pick
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 17
+	.WORD .LOWORD(BH_AG_COPY_INIT)   ; 18 copy
+	.WORD .LOWORD(BH_AG_STEPS_INIT)  ; 19 steps
+	.WORD .LOWORD(BH_AG_INIT_NONE)   ; 20
+BH_AG_UPDATE_TABLE:
+	.WORD .LOWORD(BH_AG_NOP), .LOWORD(BH_AG_NOP), .LOWORD(BH_AG_NOP)
+	.WORD .LOWORD(BH_AG_HOP_UPDATE)      ; 3
+	.WORD .LOWORD(BH_AG_SWEEPS_UPDATE)     ; 4
+	.WORD .LOWORD(BH_AG_HOLD_UPDATE)       ; 5
+	.WORD .LOWORD(BH_AG_ARROWS_UPDATE)     ; 6
+	.WORD .LOWORD(BH_AG_NOP), .LOWORD(BH_AG_NOP), .LOWORD(BH_AG_NOP)
+	.WORD .LOWORD(BH_AG_CATCH_UPDATE)      ; 10
+	.WORD .LOWORD(BH_AG_NOP)
+	.WORD .LOWORD(BH_AG_WIGGLE_UPDATE)     ; 12
+	.WORD .LOWORD(BH_AG_COUNTER_UPDATE)    ; 13
+	.WORD .LOWORD(BH_AG_BEAT_UPDATE)       ; 14
+	.WORD .LOWORD(BH_AG_FACE_UPDATE)       ; 15
+	.WORD .LOWORD(BH_AG_PICK_UPDATE)       ; 16
+	.WORD .LOWORD(BH_AG_NOP)
+	.WORD .LOWORD(BH_AG_COPY_UPDATE)       ; 18
+	.WORD .LOWORD(BH_AG_STEPS_UPDATE)      ; 19
+	.WORD .LOWORD(BH_AG_NOP)
+BH_AG_RENDER_TABLE:
+	.WORD .LOWORD(BH_AG_DRAW_HEART), .LOWORD(BH_AG_DRAW_HEART), .LOWORD(BH_AG_DRAW_HEART)
+	.WORD .LOWORD(BH_AG_HOP_RENDER)      ; 3
+	.WORD .LOWORD(BH_AG_SWEEPS_RENDER)     ; 4
+	.WORD .LOWORD(BH_AG_HOLD_RENDER)       ; 5
+	.WORD .LOWORD(BH_AG_ARROWS_RENDER)     ; 6
+	.WORD .LOWORD(BH_AG_DRAW_HEART), .LOWORD(BH_AG_DRAW_HEART), .LOWORD(BH_AG_DRAW_HEART)
+	.WORD .LOWORD(BH_AG_CATCH_RENDER)      ; 10
+	.WORD .LOWORD(BH_AG_DRAW_HEART)
+	.WORD .LOWORD(BH_AG_WIGGLE_RENDER)     ; 12
+	.WORD .LOWORD(BH_AG_COUNTER_RENDER)    ; 13
+	.WORD .LOWORD(BH_AG_BEAT_RENDER)       ; 14
+	.WORD .LOWORD(BH_AG_FACE_RENDER)       ; 15
+	.WORD .LOWORD(BH_AG_PICK_RENDER)       ; 16
+	.WORD .LOWORD(BH_AG_DRAW_HEART)
+	.WORD .LOWORD(BH_AG_COPY_RENDER)       ; 18
+	.WORD .LOWORD(BH_AG_STEPS_RENDER)      ; 19
+	.WORD .LOWORD(BH_AG_DRAW_HEART)
+
+; ===========================================================================
+; B4 Sweeps - a bar with a gap crosses the box; be in the gap when it passes.
+;   p0 direction: 0 left->right, 1 right->left, 2 top->bottom, 3 bottom->top,
+;      4 alternate 0/1, 5 alternate 2/3; p1 gap in px (16-aligned); p2 bars.
+;   State: STEP 1 while a bar moves, A its position (12.4 px), B the gap's
+;   first px, C bars left, D direction, E frames until the next bar.
+; ===========================================================================
+BH_AG_SWEEPS_INIT:
+	LDA BH_AG_STATE + BHAG_Q2
+	AND #$00FF
+	STA BH_AG_STATE + BHAG_C
+	LDA #40
+	STA BH_AG_STATE + BHAG_E
+	LDA BH_AG_STATE + BHAG_Q2
+	AND #$00FF
+	ASL
+	ASL
+	ASL
+	ASL
+	ASL
+	ASL                     ; 64 frames a bar
+	CLC
+	ADC #240
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #1
+	RTS
+
+BH_AG_SWEEPS_UPDATE:
+	JSR BH_INPUT
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP BH_AG_RESOLVE_BY_HITS
+:	LDA BH_AG_STATE + BHAG_STEP
+	BEQ :+
+	JMP @moving
+:	; between bars
+	LDA BH_AG_STATE + BHAG_E
+	BEQ @next_bar
+	DEC BH_AG_STATE + BHAG_E
+	RTS
+@next_bar:
+	LDA BH_AG_STATE + BHAG_C
+	BNE @start
+	JMP BH_AG_RESOLVE_BY_HITS
+@start:
+	DEC BH_AG_STATE + BHAG_C
+	; direction from the mode
+	LDA BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	CMP #4
+	BCC @dir_ok
+	AND #$0001
+	ASL                     ; 4 -> 0/1, 5 -> 2/3 by the bar's parity
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_C
+	AND #$0001
+	ORA z:BH_T0
+@dir_ok:
+	STA BH_AG_STATE + BHAG_D
+	; the gap: 16-aligned somewhere along the perpendicular axis, inside the frame
+	CMP #2
+	BCS @horizontal
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	BRA @have_len
+@horizontal:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+@have_len:
+	SEC
+	SBC #16                 ; the frame
+	SEC
+	SBC BH_AG_STATE + BHAG_Q1
+	LSR
+	LSR
+	LSR
+	LSR
+	INC
+	STA z:BH_T7             ; possible gap slots
+	JSR BH_AG_RAND_BELOW
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC #8
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_D
+	CMP #2
+	BCS @gap_x
+	LDA z:BH_T0
+	CLC
+	ADC z:BH_BOX_Y0
+	BRA @gap_ok
+@gap_x:
+	LDA z:BH_T0
+	CLC
+	ADC z:BH_BOX_X0
+@gap_ok:
+	STA BH_AG_STATE + BHAG_B
+	; start position just outside the box
+	LDA BH_AG_STATE + BHAG_D
+	ASL
+	TAX
+	JSR (.LOWORD(@start_table),X)
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_AG_STATE + BHAG_A
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+	RTS
+@start_table:
+	.WORD .LOWORD(@s0), .LOWORD(@s1), .LOWORD(@s2), .LOWORD(@s3)
+@s0:	LDA z:BH_BOX_X0
+	SEC
+	SBC #16
+	RTS
+@s1:	LDA z:BH_BOX_X1
+	RTS
+@s2:	LDA z:BH_BOX_Y0
+	SEC
+	SBC #16
+	RTS
+@s3:	LDA z:BH_BOX_Y1
+	RTS
+@moving:
+	LDA BH_AG_STATE + BHAG_D
+	AND #$0001
+	BNE @backwards
+	LDA BH_AG_STATE + BHAG_A
+	CLC
+	ADC z:BH_SPEED
+	BRA @stored
+@backwards:
+	LDA BH_AG_STATE + BHAG_A
+	SEC
+	SBC z:BH_SPEED
+@stored:
+	STA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	STA z:BH_T0             ; position in px
+	; past the far edge?
+	LDA BH_AG_STATE + BHAG_D
+	ASL
+	TAX
+	JSR (.LOWORD(@end_table),X)
+	BCC @check
+	STZ BH_AG_STATE + BHAG_STEP
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	RTS
+@end_table:
+	.WORD .LOWORD(@e0), .LOWORD(@e1), .LOWORD(@e2), .LOWORD(@e3)
+@e0:	LDA z:BH_T0
+	CMP z:BH_BOX_X1
+	RTS                     ; carry set once past
+@e1:	LDA z:BH_BOX_X0
+	SEC
+	SBC #16
+	CMP z:BH_T0
+	RTS
+@e2:	LDA z:BH_T0
+	CMP z:BH_BOX_Y1
+	RTS
+@e3:	LDA z:BH_BOX_Y0
+	SEC
+	SBC #16
+	CMP z:BH_T0
+	RTS
+@check:
+	; the heart's centre inside the bar's 16 px band and outside the gap: a hit
+	LDA BH_AG_STATE + BHAG_D
+	CMP #2
+	BCS @band_y
+	LDA z:BH_HEART_X
+	CLC
+	ADC #8
+	STA z:BH_T1             ; along the motion
+	LDA z:BH_HEART_Y
+	CLC
+	ADC #8
+	STA z:BH_T2             ; across
+	BRA @band
+@band_y:
+	LDA z:BH_HEART_Y
+	CLC
+	ADC #8
+	STA z:BH_T1
+	LDA z:BH_HEART_X
+	CLC
+	ADC #8
+	STA z:BH_T2
+@band:
+	LDA z:BH_T1
+	SEC
+	SBC z:BH_T0
+	CMP #16
+	BCS @clear              ; not in the band (negative wraps high)
+	LDA z:BH_T2
+	SEC
+	SBC BH_AG_STATE + BHAG_B
+	CMP BH_AG_STATE + BHAG_Q1
+	BCC @clear              ; inside the gap
+	JMP BH_AG_HIT
+@clear:
+	RTS
+
+BH_AG_SWEEPS_RENDER:
+	JSR BH_AG_DRAW_HEART
+	LDA BH_AG_STATE + BHAG_STEP
+	BNE :+
+	RTS
+:
+	LDA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	STA z:BH_LOOP_PC        ; bar position (scratch: no pattern runs)
+	LDA BH_AG_STATE + BHAG_D
+	CMP #2
+	BCS @horizontal
+	; vertical bar: segments down the box, holes over the gap; the segment that
+	; reaches the instruction line is a thin line so the text stays readable
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #8
+	STA z:BH_PAT_WAIT       ; segment start
+@vseg:
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #16
+	CMP z:BH_BOX_Y1
+	BEQ :+
+	BCC :+
+	JMP @done
+:	LDA z:BH_PAT_WAIT
+	SEC
+	SBC BH_AG_STATE + BHAG_B
+	CMP BH_AG_STATE + BHAG_Q1
+	BCC @vnext              ; a hole
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #16 + 20
+	CMP z:BH_BOX_Y1
+	BCS @thin
+	LDA #BH_TYPE_VLINE
+	JSR BH_AG_SEGMENT_TILE
+	BRA @vput
+@thin:
+	LDA #BH_TYPE_VLINE
+	JSR BH_TILE_FOR_TYPE
+@vput:
+	LDA z:BH_LOOP_PC
+	STA z:BH_T0
+	LDA z:BH_PAT_WAIT
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@vnext:
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #16
+	STA z:BH_PAT_WAIT
+	BRA @vseg
+@horizontal:
+	LDA #BH_TYPE_HLINE16
+	JSR BH_AG_SEGMENT_TILE
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_PAT_WAIT
+@hseg:
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #16
+	CMP z:BH_BOX_X1
+	BEQ :+
+	BCS @done
+:	LDA z:BH_PAT_WAIT
+	SEC
+	SBC BH_AG_STATE + BHAG_B
+	CMP BH_AG_STATE + BHAG_Q1
+	BCC @hnext
+	LDA z:BH_PAT_WAIT
+	STA z:BH_T0
+	LDA z:BH_LOOP_PC
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@hnext:
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #16
+	STA z:BH_PAT_WAIT
+	BRA @hseg
+@done:
+	RTS
+
+; ===========================================================================
+; B3 Hop the waves - the heart runs along the floor of the box; waves (the
+;   enemy's shape) sweep along the floor from either side and A hops the
+;   heart over them. p0 speed (1/16 px a frame), p1 frames between waves,
+;   p2 waves. A = height above the floor, B = vertical speed (px a frame,
+;   signed), C = waves still to come, D = the last side, E = frames to the
+;   next wave. Waves live in the bullet table (type, x 12.4, vx).
+; ===========================================================================
+BH_AG_HOP_INIT:
+	LDA BH_AG_STATE + BHAG_Q2
+	STA BH_AG_STATE + BHAG_C
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	LDA #900
+	STA BH_AG_STATE + BHAG_TIMER
+	JSL RAND
+	AND #1
+	STA BH_AG_STATE + BHAG_D
+	LDA #176
+	STA z:BH_T0
+	LDA #88                 ; room for the hop
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+; the floor: the heart's y while grounded (its bottom just above the instruction line)
+BH_AG_HOP_FLOOR:
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #34
+	RTS
+
+BH_AG_HOP_UPDATE:
+	JSR BH_INPUT            ; left and right; up and down are undone below
+	LDA BH_AG_STATE + BHAG_A
+	BNE @airborne
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BEQ @grounded
+	LDA #9                  ; 45 px high, 18 frames in the air
+	STA BH_AG_STATE + BHAG_B
+	LDA #SFX::CURSOR3
+	JSR BH_MG_SOUND
+@airborne:
+	LDA BH_AG_STATE + BHAG_A
+	CLC
+	ADC BH_AG_STATE + BHAG_B
+	BPL :+
+	LDA #0
+:	STA BH_AG_STATE + BHAG_A
+	DEC BH_AG_STATE + BHAG_B
+@grounded:
+	JSR BH_AG_HOP_FLOOR
+	SEC
+	SBC BH_AG_STATE + BHAG_A
+	STA z:BH_HEART_Y
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP BH_AG_RESOLVE_BY_HITS
+:	LDA BH_AG_STATE + BHAG_E
+	BEQ @spawn
+	DEC BH_AG_STATE + BHAG_E
+	BRA @move
+@spawn:
+	LDA BH_AG_STATE + BHAG_C
+	BEQ @move
+	DEC BH_AG_STATE + BHAG_C
+	LDA BH_AG_STATE + BHAG_Q1
+	STA BH_AG_STATE + BHAG_E
+	JSR BH_AG_HOP_SPAWN
+@move:
+	STZ z:BH_T6             ; waves still on the floor
+	LDX #0
+@wave:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	INC z:BH_T6
+	LDA BH_BULLETS + BHB_X,X
+	CLC
+	ADC BH_BULLETS + BHB_VX,X
+	STA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	STA z:BH_T0
+	CLC
+	ADC #16
+	CMP z:BH_BOX_X0
+	BCC @gone
+	LDA z:BH_T0
+	CMP z:BH_BOX_X1
+	BCS @gone
+	; under a heart that is not high enough? (8 px each way: a clean hop clears it)
+	LDA BH_AG_STATE + BHAG_A
+	CMP #10
+	BCS @next
+	LDA z:BH_T0
+	SEC
+	SBC z:BH_HEART_X
+	JSR BH_ABS
+	CMP #8
+	BCS @second
+	JSR BH_AG_HIT
+	BRA @next
+@second:
+	LDA BH_AG_STATE + BHAG_AMOD
+	CMP #BH_BLK_TWO
+	BNE @next
+	LDA z:BH_T0
+	SEC
+	SBC BH_AG_STATE + BHAG_H2X
+	JSR BH_ABS
+	CMP #8
+	BCS @next
+	JSR BH_AG_HIT
+	BRA @next
+@gone:
+	STZ BH_BULLETS + BHB_TYPE,X
+	DEC z:BH_T6
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @wave
+	LDA BH_AG_STATE + BHAG_C
+	BNE @done
+	LDA z:BH_T6
+	BNE @done
+	JMP BH_AG_RESOLVE_BY_HITS   ; every wave has passed
+@done:
+	RTS
+
+; a new wave from the side opposite the last one
+BH_AG_HOP_SPAWN:
+	LDX #0
+@find:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @free
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @find
+	RTS
+@free:
+	LDA BH_AG_STATE + BHAG_D
+	EOR #1
+	STA BH_AG_STATE + BHAG_D
+	BNE @from_right
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #8
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA BH_AG_STATE + BHAG_Q0
+	STA BH_BULLETS + BHB_VX,X
+	BRA @type
+@from_right:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #8
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA BH_AG_STATE + BHAG_Q0
+	EOR #$FFFF
+	INC
+	STA BH_BULLETS + BHB_VX,X
+@type:
+	STZ BH_BULLETS + BHB_VY,X
+	LDA #BH_TYPE_ROUND
+	LDY z:BH_THEME_TILE
+	CPY #$FFFF
+	BEQ :+
+	LDA #BH_TYPE_THEME0
+:	STA BH_BULLETS + BHB_TYPE,X
+	LDA #SFX::CURSOR1
+	JMP BH_MG_SOUND
+
+BH_AG_HOP_RENDER:
+	; the floor line, right above the instruction line
+	LDA #BH_TYPE_HLINE16
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT
+	STA z:BH_T5
+@seg:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #20
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	CLC
+	ADC #BH_FRAME_RIGHT
+	CMP z:BH_BOX_X1
+	BCC @seg
+	; the waves
+	LDX #0
+@wave:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	STX z:BH_T6
+	JSR BH_TILE_FOR_TYPE
+	LDX z:BH_T6
+	LDA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	STA z:BH_T0
+	JSR BH_AG_HOP_FLOOR
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @wave
+	; the A button in the top right corner, ringed while lit
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #BH_FRAME_RIGHT + 18
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP + 2
+	STA z:BH_T1
+	LDA z:BH_MG_PRESS
+	CMP #$0100
+	BCC :+
+	JSR BH_DRAW_PRESS_RING
+:	LDA #BH_TYPE_BUTTON_A
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+	JMP BH_AG_DRAW_HEART
+
+; ===========================================================================
+; B14 Beat - dots across the box, a marker hops from dot to dot at the enemy's
+;   tempo: press A as it lands. p0 beats, p1 tempo override (0 = the record),
+;   p2 tolerance in frames. A = frames to the next beat, B = the period,
+;   STEP = beats done, C = the last beat's state (0 open, 1 pressed),
+;   ARR[i] = 0 pending, 1 good, 2 missed.
+; ===========================================================================
+BH_AG_BEAT_INIT:
+	LDA BH_AG_STATE + BHAG_Q1
+	AND #$00FF
+	BNE :+
+	LDA z:BH_TEMPO
+:	TAY                     ; tempo (16 = 1.0)
+	LDA #480
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	CMP #18
+	BCS :+
+	LDA #18
+:	CMP #60
+	BCC :+
+	LDA #60
+:	STA BH_AG_STATE + BHAG_B
+	ASL
+	STA BH_AG_STATE + BHAG_A ; the first beat after two periods
+	STZ BH_AG_STATE + BHAG_C
+	LDX #0
+@clr:
+	STZ BH_AG_STATE + BHAG_ARR,X
+	INX
+	INX
+	CPX #16
+	BCC @clr
+	LDA #700
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #176
+	STA z:BH_T0
+	LDA #72
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+BH_AG_BEAT_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP BH_AG_RESOLVE_BY_HITS
+:	LDA BH_AG_STATE + BHAG_STEP
+	CMP BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	BCC @going
+	; all beats done: wait out the last tolerance window, then grade by misses
+	LDA BH_AG_STATE + BHAG_A
+	BEQ @grade
+	DEC BH_AG_STATE + BHAG_A
+	BRA @press
+@grade:
+	JMP BH_AG_RESOLVE_BY_HITS
+@going:
+	DEC BH_AG_STATE + BHAG_A
+	BNE @press
+	; a beat lands: the previous one, if never pressed, was missed
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @first
+	LDA BH_AG_STATE + BHAG_C
+	BNE @first
+	JSR @miss_previous
+@first:
+	STZ BH_AG_STATE + BHAG_C
+	INC BH_AG_STATE + BHAG_STEP
+	LDA BH_AG_STATE + BHAG_B
+	STA BH_AG_STATE + BHAG_A
+	LDA #SFX::CURSOR3
+	JSR BH_MG_SOUND
+@press:
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BEQ @done
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @early              ; before the first beat
+	LDA BH_AG_STATE + BHAG_C
+	BNE @done               ; already pressed for this beat
+	; distance to the nearest beat: since the last one (period - A) or until the next (A)
+	LDA BH_AG_STATE + BHAG_B
+	SEC
+	SBC BH_AG_STATE + BHAG_A
+	STA z:BH_T0             ; frames since the last beat
+	LDA BH_AG_STATE + BHAG_A
+	CMP z:BH_T0
+	BCS :+
+	STA z:BH_T0
+:	LDA z:BH_T0
+	CMP BH_AG_STATE + BHAG_Q2
+	AND #$00FF
+	BCS @early              ; too far from a beat
+	; good press for the last landed beat
+	LDA #1
+	STA BH_AG_STATE + BHAG_C
+	LDA BH_AG_STATE + BHAG_STEP
+	DEC
+	TAX
+	LDA #1
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_ARR,X
+	REP #PROC_FLAGS::ACCUM8
+	LDA #SFX::CURSOR2
+	JMP BH_MG_SOUND
+@early:
+	JSR BH_AG_HIT           ; an off-beat press counts as a hit
+@done:
+	RTS
+@miss_previous:
+	LDA BH_AG_STATE + BHAG_STEP
+	DEC
+	TAX
+	LDA #2
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_AG_STATE + BHAG_ARR,X
+	REP #PROC_FLAGS::ACCUM8
+	JMP BH_AG_HIT
+
+BH_AG_BEAT_RENDER:
+	JSR BH_MG_CENTRE
+	; the dots, 20 px apart, centred: pending = dot, good = spark, missed = red block
+	LDA BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	STA z:BH_T7
+	ASL
+	ASL
+	STA z:BH_T6
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T6             ; 20 * beats
+	LSR
+	STA z:BH_T6
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC z:BH_T6
+	STA z:BH_PAT_WAIT       ; first dot's x
+	LDX #0
+@dot:
+	STX z:BH_T6
+	LDA BH_AG_STATE + BHAG_ARR,X
+	AND #$00FF
+	BEQ @pending
+	CMP #1
+	BEQ @good
+	LDA #BH_TYPE_GAUGE_RED
+	BRA @type
+@good:
+	LDA #BH_TYPE_SPARK
+	BRA @type
+@pending:
+	LDA #BH_TYPE_DOT
+@type:
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6
+	ASL
+	ASL
+	STA z:BH_T0
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T0             ; 20 i
+	CLC
+	ADC z:BH_PAT_WAIT
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	CPX z:BH_T7
+	BCC @dot
+	; the marker: on the current beat's dot, popping up as the beat lands
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @label
+	DEC
+	ASL
+	ASL
+	STA z:BH_T0
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T0
+	CLC
+	ADC z:BH_PAT_WAIT
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_B
+	SEC
+	SBC BH_AG_STATE + BHAG_A ; frames since the beat
+	LSR
+	CMP #8
+	BCC :+
+	LDA #8
+:	STA z:BH_T5
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #28
+	CLC
+	ADC z:BH_T5
+	STA z:BH_T1
+	LDA z:BH_MG_PRESS
+	CMP #$0100
+	BCC :+
+	JSR BH_DRAW_PRESS_RING
+:	LDA #BH_TYPE_BUTTON_A
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+@label:
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC #24
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC #12
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; ===========================================================================
+; B16 Pick a cell - p0 cells across the box (rings on the floor); each round a
+;   tell shows the safe one for p1 frames, then every other cell strikes: be
+;   in the safe cell. p2 rounds. STEP: 0 rest, 1 tell, 2 strike; D safe cell;
+;   E frames left; C rounds left; A = cell width.
+; ===========================================================================
+BH_AG_PICK_INIT:
+	LDA BH_AG_STATE + BHAG_Q2
+	AND #$00FF
+	STA BH_AG_STATE + BHAG_C
+	LDA #40
+	STA BH_AG_STATE + BHAG_E
+	LDA #600
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #176
+	STA z:BH_T0
+	LDA #64
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+; the heart's cell -> A
+BH_AG_PICK_CELL_OF_HEART:
+	LDA z:BH_HEART_X
+	CLC
+	ADC #8
+	SEC
+	SBC z:BH_BOX_X0
+	SEC
+	SBC #8
+	BPL :+
+	LDA #0
+:	LDY BH_AG_STATE + BHAG_A
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	CMP BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	BCC :+
+	LDA BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	DEC
+:	RTS
+
+BH_AG_PICK_UPDATE:
+	JSR BH_INPUT
+	LDA BH_AG_STATE + BHAG_A
+	BNE :+
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	SEC
+	SBC #16
+	LDY BH_AG_STATE + BHAG_Q0
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	STA BH_AG_STATE + BHAG_A ; cell width
+:	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP BH_AG_RESOLVE_BY_HITS
+:	LDA BH_AG_STATE + BHAG_E
+	BEQ @phase_over
+	DEC BH_AG_STATE + BHAG_E
+	LDA BH_AG_STATE + BHAG_STEP
+	CMP #2
+	BNE @done
+	JSR BH_AG_PICK_CELL_OF_HEART
+	CMP BH_AG_STATE + BHAG_D
+	BEQ @done
+	JMP BH_AG_HIT
+@done:
+	RTS
+@phase_over:
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @rest_over
+	CMP #1
+	BEQ @tell_over
+	STZ BH_AG_STATE + BHAG_STEP
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	RTS
+@tell_over:
+	LDA #2
+	STA BH_AG_STATE + BHAG_STEP
+	LDA #16
+	STA BH_AG_STATE + BHAG_E
+	RTS
+@rest_over:
+	LDA BH_AG_STATE + BHAG_C
+	BNE @round
+	JMP BH_AG_RESOLVE_BY_HITS
+@round:
+	DEC BH_AG_STATE + BHAG_C
+	LDA BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	STA z:BH_T7
+	JSR BH_AG_RAND_BELOW
+	STA BH_AG_STATE + BHAG_D
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+	LDA BH_AG_STATE + BHAG_Q1
+	AND #$00FF
+	STA BH_AG_STATE + BHAG_E
+	LDA #SFX::CURSOR1
+	JMP BH_MG_SOUND
+
+BH_AG_PICK_RENDER:
+	; a ring at each cell's centre; the safe one shows a spark during the tell;
+	; during the strike the others fill with red blocks
+	LDA BH_AG_STATE + BHAG_A
+	BNE :+
+	JMP @heart
+:
+	STZ z:BH_LOOP_PC        ; cell index
+@cell:
+	LDA z:BH_LOOP_PC
+	CMP BH_AG_STATE + BHAG_Q0
+	AND #$00FF
+	BCC :+
+	JMP @heart
+:	LDY BH_AG_STATE + BHAG_A
+	JSL MULT168
+	CLC
+	ADC z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_PAT_WAIT       ; cell left edge
+	LDA BH_AG_STATE + BHAG_A
+	LSR
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #8
+	STA z:BH_T0             ; centred sprite x
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC z:BH_BOX_Y1
+	LSR
+	SEC
+	SBC #8
+	STA z:BH_T1
+	LDA BH_AG_STATE + BHAG_STEP
+	CMP #2
+	BEQ @strike
+	CMP #1
+	BNE @ring
+	LDA z:BH_LOOP_PC
+	CMP BH_AG_STATE + BHAG_D
+	BNE @ring
+	LDA #BH_TYPE_SPARK
+	BRA @put
+@ring:
+	LDA #BH_TYPE_RING
+	BRA @put
+@strike:
+	LDA z:BH_LOOP_PC
+	CMP BH_AG_STATE + BHAG_D
+	BEQ @ring
+	; red blocks up and down the cell
+	LDA #BH_TYPE_GAUGE_RED
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #8
+	STA z:BH_T1
+@fill:
+	JSR BH_OAM_PUT
+	LDA z:BH_T1
+	CLC
+	ADC #16
+	STA z:BH_T1
+	CLC
+	ADC #16
+	CMP z:BH_BOX_Y1
+	BCC @fill
+	BRA @next
+@put:
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+@next:
+	INC z:BH_LOOP_PC
+	JMP @cell
+@heart:
+	JMP BH_AG_DRAW_HEART
+
+; ===========================================================================
+; B10 Catch and avoid - green blocks (catch them) and the enemy's bullets
+;   (avoid them) drift in from the right; p0 good, p1 bad, p2 speed (1/16 px).
+;   Items live in the bullet table: type, x/y 12.4, vx. A = items left,
+;   C = caught. Grade: hits as usual, PERFECT only if everything was caught.
+; ===========================================================================
+BH_AG_CATCH_INIT:
+	LDA BH_AG_STATE + BHAG_Q0
+	CLC
+	ADC BH_AG_STATE + BHAG_Q1
+	STA BH_AG_STATE + BHAG_A
+	STZ BH_AG_STATE + BHAG_C
+	STZ BH_AG_STATE + BHAG_STEP  ; items not placed yet (the box is not sized until the game starts)
+	LDA #900
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #1
+	RTS
+
+; place every item beyond the right edge, 36 px apart, on a random row
+BH_AG_CATCH_PLACE:
+	LDX #0
+	STZ z:BH_T6             ; item index
+@item:
+	LDA z:BH_T6
+	CMP BH_AG_STATE + BHAG_A
+	BCS @done
+	LDA z:BH_T6
+	CMP BH_AG_STATE + BHAG_Q0
+	BCS @bad
+	LDA #BH_TYPE_GAUGE_GRN
+	BRA @type
+@bad:
+	LDA #BH_TYPE_ROUND
+	LDY z:BH_THEME_TILE
+	CPY #$FFFF
+	BEQ @type
+	LDA #BH_TYPE_THEME0
+@type:
+	STA BH_BULLETS + BHB_TYPE,X
+	; x = right edge + 24 + 36 * i (12.4)
+	LDA z:BH_T6
+	ASL
+	ASL                     ; 4i
+	STA z:BH_T2
+	ASL
+	ASL
+	ASL                     ; 32i
+	CLC
+	ADC z:BH_T2             ; 36i
+	CLC
+	ADC z:BH_BOX_X1
+	CLC
+	ADC #24
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	; y: a random row inside the frame, above the instruction line
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	SEC
+	SBC #44
+	STA z:BH_T7
+	PHX
+	JSR BH_AG_RAND_BELOW
+	PLX
+	CLC
+	ADC z:BH_BOX_Y0
+	CLC
+	ADC #8
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	LDA BH_AG_STATE + BHAG_Q2
+	EOR #$FFFF
+	INC                     ; -speed
+	STA BH_BULLETS + BHB_VX,X
+	STZ BH_BULLETS + BHB_VY,X
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	INC z:BH_T6
+	BRA @item
+@done:
+	RTS
+
+BH_AG_CATCH_UPDATE:
+	JSR BH_INPUT
+	LDA BH_AG_STATE + BHAG_STEP
+	BNE :+
+	JSR BH_AG_CATCH_PLACE
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+:	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP @finish
+:	LDA BH_AG_STATE + BHAG_A
+	BNE :+
+	JMP @finish
+:	LDX #0
+@item:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	LDA BH_BULLETS + BHB_X,X
+	CLC
+	ADC BH_BULLETS + BHB_VX,X
+	STA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	STA z:BH_T0
+	CMP z:BH_BOX_X0
+	BCS @inside
+	; drifted out on the left: gone
+	STZ BH_BULLETS + BHB_TYPE,X
+	DEC BH_AG_STATE + BHAG_A
+	BRA @next
+@inside:
+	; touching the heart? (16 x 16 boxes, within 12 px on both axes)
+	LDA z:BH_T0
+	SEC
+	SBC z:BH_HEART_X
+	JSR BH_ABS
+	CMP #12
+	BCS @next
+	LDA BH_BULLETS + BHB_Y,X
+	JSR BH_ASR4
+	SEC
+	SBC z:BH_HEART_Y
+	JSR BH_ABS
+	CMP #12
+	BCS @next
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	CMP #BH_TYPE_GAUGE_GRN
+	BNE @bad_touch
+	STZ BH_BULLETS + BHB_TYPE,X
+	DEC BH_AG_STATE + BHAG_A
+	INC BH_AG_STATE + BHAG_C
+	LDA #SFX::CURSOR2
+	PHX
+	JSR BH_MG_SOUND
+	PLX
+	BRA @next
+@bad_touch:
+	LDA z:BH_IFRAMES
+	BNE @next
+	STZ BH_BULLETS + BHB_TYPE,X    ; a bad one that hit is spent
+	DEC BH_AG_STATE + BHAG_A
+	PHX
+	JSR BH_AG_HIT
+	PLX
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @item
+	RTS
+@finish:
+	LDA BH_AG_STATE + BHAG_HITS
+	BNE @by_hits
+	LDA BH_AG_STATE + BHAG_C
+	CMP BH_AG_STATE + BHAG_Q0
+	BCS @by_hits            ; everything caught: PERFECT
+	LDA #1                  ; nothing hit but something missed: GOOD
+	JMP BH_AG_RESOLVE
+@by_hits:
+	JMP BH_AG_RESOLVE_BY_HITS
+
+BH_AG_CATCH_RENDER:
+	LDX #0
+@item:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	STX z:BH_T6
+	JSR BH_TILE_FOR_TYPE
+	LDX z:BH_T6
+	LDA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	STA z:BH_T0
+	CLC
+	ADC #16
+	CMP z:BH_BOX_X1
+	BCS @skip               ; still outside the box on the right
+	LDA BH_BULLETS + BHB_Y,X
+	JSR BH_ASR4
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@skip:
+	LDX z:BH_T6
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @item
+	JMP BH_AG_DRAW_HEART
+
+; ===========================================================================
+; B13 Counter shot - a crosshair in the box; the enemy's sprite crosses it
+;   p0 times at p1/16 px per frame (p2: 0 from the right, 1 from the left).
+;   A as it crosses: 4 px PERFECT, 10 GOOD, 16 OK; a pass without a press,
+;   or a press off target, counts as a hit. A = sprite x (12.4), C passes
+;   left, STEP 1 while crossing, D = 1 once pressed for this pass, E = wait.
+; ===========================================================================
+BH_AG_COUNTER_INIT:
+	LDA BH_AG_STATE + BHAG_Q0
+	STA BH_AG_STATE + BHAG_C
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	STZ BH_AG_STATE + BHAG_F     ; worst grade so far
+	LDA #700
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #176
+	STA z:BH_T0
+	LDA #64
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+BH_AG_COUNTER_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP @grade
+:	LDA BH_AG_STATE + BHAG_STEP
+	BNE @crossing
+	LDA BH_AG_STATE + BHAG_E
+	BEQ @next_pass
+	DEC BH_AG_STATE + BHAG_E
+	RTS
+@next_pass:
+	LDA BH_AG_STATE + BHAG_C
+	BNE @start
+@grade:
+	LDA BH_AG_STATE + BHAG_F
+	JMP BH_AG_RESOLVE
+@start:
+	DEC BH_AG_STATE + BHAG_C
+	STZ BH_AG_STATE + BHAG_D
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+	LDA BH_AG_STATE + BHAG_Q2
+	BNE @from_left
+	LDA z:BH_BOX_X1
+	BRA @have_start
+@from_left:
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #16
+@have_start:
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_AG_STATE + BHAG_A
+	RTS
+@crossing:
+	LDA BH_AG_STATE + BHAG_Q2
+	BNE @move_right
+	LDA BH_AG_STATE + BHAG_A
+	SEC
+	SBC BH_AG_STATE + BHAG_Q1
+	STA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	CLC
+	ADC #16
+	CMP z:BH_BOX_X0
+	BCC @passed
+	BRA @press
+@move_right:
+	LDA BH_AG_STATE + BHAG_A
+	CLC
+	ADC BH_AG_STATE + BHAG_Q1
+	STA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	CMP z:BH_BOX_X1
+	BCS @passed
+@press:
+	LDA BH_AG_STATE + BHAG_D
+	BNE @done
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BEQ @done
+	LDA #1
+	STA BH_AG_STATE + BHAG_D
+	; distance from the crosshair (box centre)
+	LDA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	CLC
+	ADC #8
+	STA z:BH_T0
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	LSR
+	SEC
+	SBC z:BH_T0
+	JSR BH_ABS
+	CMP #5
+	BCC @g0
+	CMP #11
+	BCC @g1
+	CMP #17
+	BCC @g2
+	JSR BH_AG_HIT
+	LDA #3
+	BRA @score
+@g2:	LDA #2
+	BRA @score
+@g1:	LDA #1
+	BRA @score
+@g0:	LDA #0
+@score:
+	CMP BH_AG_STATE + BHAG_F
+	BCC :+
+	STA BH_AG_STATE + BHAG_F
+:	JSR BH_GRADE_FEEDBACK
+	LDA #SFX::CURSOR2
+	JMP BH_MG_SOUND
+@passed:
+	STZ BH_AG_STATE + BHAG_STEP
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	LDA BH_AG_STATE + BHAG_D
+	BNE @done
+	JSR BH_AG_HIT           ; it went by uncontested
+	LDA #3
+	STA BH_AG_STATE + BHAG_F
+@done:
+	RTS
+
+BH_AG_COUNTER_RENDER:
+	JSR BH_MG_CENTRE
+	; the crosshair, ringed while A is lit
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+	STA z:BH_T1
+	LDA z:BH_MG_PRESS
+	CMP #$0100
+	BCC :+
+	JSR BH_DRAW_PRESS_RING
+:	LDA #BH_TYPE_CROSSHAIR
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+	; the crossing sprite
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @label
+	LDA #BH_TYPE_ROUND
+	JSR BH_AG_SEGMENT_TILE
+	LDA BH_AG_STATE + BHAG_A
+	JSR BH_ASR4
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@label:
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #26
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; ===========================================================================
+; B15 Face it - a spark at one edge tells where the strike comes from (p1
+;   frames), then the enemy's sprite dashes at the heart: hold the D-pad
+;   toward it as it lands. p0 strikes. D = side (0 left 1 right 2 up 3 down),
+;   STEP 0 rest / 1 tell / 2 dash, A = dash progress (px), C strikes left.
+; ===========================================================================
+BH_AG_FACE_INIT:
+	LDA BH_AG_STATE + BHAG_Q0
+	STA BH_AG_STATE + BHAG_C
+	LDA #30
+	STA BH_AG_STATE + BHAG_E
+	LDA #700
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #160
+	STA z:BH_T0
+	LDA #80
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+BH_AG_FACE_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JMP BH_AG_RESOLVE_BY_HITS
+:	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @rest
+	CMP #1
+	BEQ @tell
+	; the dash: the sprite closes 4 px a frame from 64 px out
+	LDA BH_AG_STATE + BHAG_A
+	SEC
+	SBC #4
+	STA BH_AG_STATE + BHAG_A
+	BNE @done
+	; it lands: the pad must point at it
+	LDA BH_AG_STATE + BHAG_D
+	ASL
+	TAX
+	LDA PAD_STATE
+	AND f:BH_AG_FACE_PADS,X
+	BNE @blocked
+	JSR BH_AG_HIT
+	BRA @after
+@blocked:
+	LDA #SFX::CURSOR2
+	JSR BH_MG_SOUND
+@after:
+	STZ BH_AG_STATE + BHAG_STEP
+	LDA #36
+	STA BH_AG_STATE + BHAG_E
+@done:
+	RTS
+@tell:
+	LDA BH_AG_STATE + BHAG_E
+	BEQ @dash
+	DEC BH_AG_STATE + BHAG_E
+	RTS
+@dash:
+	LDA #2
+	STA BH_AG_STATE + BHAG_STEP
+	LDA #64
+	STA BH_AG_STATE + BHAG_A
+	RTS
+@rest:
+	LDA BH_AG_STATE + BHAG_E
+	BEQ @next
+	DEC BH_AG_STATE + BHAG_E
+	RTS
+@next:
+	LDA BH_AG_STATE + BHAG_C
+	BNE @strike
+	JMP BH_AG_RESOLVE_BY_HITS
+@strike:
+	DEC BH_AG_STATE + BHAG_C
+	; the side: p2 0 = random, 1 left/right only, 2 up/down only, 3 clockwise
+	LDA BH_AG_STATE + BHAG_Q2
+	CMP #3
+	BEQ @clockwise
+	CMP #1
+	BEQ @lr
+	CMP #2
+	BEQ @ud
+	LDA #4
+	STA z:BH_T7
+	JSR BH_AG_RAND_BELOW
+	BRA @side
+@lr:	JSL RAND
+	AND #$0001
+	BRA @side
+@ud:	JSL RAND
+	AND #$0001
+	ORA #$0002
+	BRA @side
+@clockwise:
+	LDA BH_AG_STATE + BHAG_C
+	AND #$0003
+@side:
+	STA BH_AG_STATE + BHAG_D
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+	LDA BH_AG_STATE + BHAG_Q1
+	STA BH_AG_STATE + BHAG_E
+	LDA #SFX::CURSOR1
+	JMP BH_MG_SOUND
+
+BH_AG_FACE_PADS:
+	.WORD PAD::LEFT, PAD::RIGHT, PAD::UP, PAD::DOWN
+; sprite offsets from the heart per side, at distance 1
+BH_AG_FACE_DX:
+	.WORD $FFFF, 1, 0, 0
+BH_AG_FACE_DY:
+	.WORD 0, 0, $FFFF, 1
+
+BH_AG_FACE_RENDER:
+	JSR BH_AG_DRAW_HEART
+	; the shield: a ring on the side the pad points at
+	LDA PAD_STATE
+	AND #PAD::LEFT | PAD::RIGHT | PAD::UP | PAD::DOWN
+	BEQ @no_shield
+	LDX #0
+@which:
+	LDA PAD_STATE
+	AND f:BH_AG_FACE_PADS,X
+	BNE @shield
+	INX
+	INX
+	CPX #8
+	BCC @which
+	BRA @no_shield
+@shield:
+	LDA f:BH_AG_FACE_DX,X
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC z:BH_HEART_X
+	STA z:BH_T0
+	LDA f:BH_AG_FACE_DY,X
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC z:BH_HEART_Y
+	STA z:BH_T1
+	JSR BH_DRAW_RING_AT
+@no_shield:
+	LDA BH_AG_STATE + BHAG_STEP
+	BNE :+
+	RTS
+:	LDA BH_AG_STATE + BHAG_D
+	ASL
+	TAX
+	LDA BH_AG_STATE + BHAG_STEP
+	CMP #1
+	BEQ @tell
+	; the dash: the sprite A px out along the side's axis
+	LDA #BH_TYPE_ROUND
+	PHX
+	JSR BH_AG_SEGMENT_TILE
+	PLX
+	LDA f:BH_AG_FACE_DX,X
+	LDY BH_AG_STATE + BHAG_A
+	JSR BH_AG_MUL_SIGNED
+	CLC
+	ADC z:BH_HEART_X
+	STA z:BH_T0
+	LDA f:BH_AG_FACE_DY,X
+	LDY BH_AG_STATE + BHAG_A
+	JSR BH_AG_MUL_SIGNED
+	CLC
+	ADC z:BH_HEART_Y
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	BRA @done
+@tell:
+	; a blinking spark at the box edge on that side
+	LDA z:BH_FRAME
+	AND #$0004
+	BNE @done
+	LDA #BH_TYPE_SPARK
+	PHX
+	JSR BH_TILE_FOR_TYPE
+	PLX
+	JSR BH_MG_CENTRE
+	LDA f:BH_AG_FACE_DX,X
+	BEQ @tx_centre
+	BMI @tx_left
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #24
+	BRA @tx
+@tx_left:
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #8
+	BRA @tx
+@tx_centre:
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #8
+@tx:	STA z:BH_T0
+	LDA f:BH_AG_FACE_DY,X
+	BEQ @ty_centre
+	BMI @ty_top
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #24
+	BRA @ty
+@ty_top:
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #7
+	BRA @ty
+@ty_centre:
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+@ty:	STA z:BH_T1
+	JSR BH_OAM_PUT
+@done:
+	RTS
+
+; T0 = x of bar block T6 (16 px blocks from 72 px left of the centre)
+BH_AG_BAR_BLOCK_X:
+	LDA z:BH_T6
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	STA z:BH_T0
+	RTS
+
+; A (-1/0/1) * Y -> A
+BH_AG_MUL_SIGNED:
+	CMP #0
+	BEQ @zero
+	BMI @neg
+	TYA
+	RTS
+@neg:
+	TYA
+	EOR #$FFFF
+	INC
+	RTS
+@zero:
+	LDA #0
+	RTS
+
+; ===========================================================================
+; B5 Hold and release - hold A while the meter fills p0 px a frame; let go
+;   inside the green window (p2 px from the left, p1 px wide). A = fill px,
+;   STEP 1 once A was held. Overflowing or letting go outside is a MISS.
+; ===========================================================================
+BH_AG_HOLD_INIT:
+	STZ BH_AG_STATE + BHAG_A
+	LDA #600
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #176
+	STA z:BH_T0
+	LDA #72
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+BH_AG_HOLD_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	LDA #3
+	JMP BH_AG_RESOLVE
+:	LDA PAD_STATE
+	AND #PAD::A_BUTTON
+	BEQ @not_held
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
+	LDA BH_AG_STATE + BHAG_A
+	CLC
+	ADC BH_AG_STATE + BHAG_Q0
+	STA BH_AG_STATE + BHAG_A
+	CMP #144
+	BCC @done
+	JSR BH_AG_HIT           ; overflowed
+	LDA #3
+	JMP BH_AG_RESOLVE
+@not_held:
+	LDA BH_AG_STATE + BHAG_STEP
+	BEQ @done               ; never held yet
+	; released: where in the window?
+	LDA BH_AG_STATE + BHAG_A
+	SEC
+	SBC BH_AG_STATE + BHAG_Q2
+	CMP BH_AG_STATE + BHAG_Q1
+	BCS @miss               ; outside (negative wraps high)
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_Q1
+	LSR
+	SEC
+	SBC z:BH_T0
+	JSR BH_ABS              ; distance from the window's centre
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_Q1
+	LSR
+	LSR
+	CMP z:BH_T0
+	BCC @good
+	LDA #0
+	JMP BH_AG_RESOLVE
+@good:
+	LDA #1
+	JMP BH_AG_RESOLVE
+@miss:
+	JSR BH_AG_HIT
+	LDA #3
+	JMP BH_AG_RESOLVE
+@done:
+	RTS
+
+BH_AG_HOLD_RENDER:
+	JSR BH_MG_CENTRE
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #24
+	STA z:BH_T7             ; bar y
+	; the fill cursor (first: in front of the blocks)
+	LDA #BH_TYPE_CURSOR
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	CLC
+	ADC BH_AG_STATE + BHAG_A
+	SEC
+	SBC #7
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	; nine blocks: green where the window is, red elsewhere
+	LDX #0
+@block:
+	STX z:BH_T6
+	TXA
+	ASL
+	ASL
+	ASL                     ; 16 i
+	STA z:BH_T5
+	; the block's span [16i, 16i+16) overlaps the window?
+	CLC
+	ADC #16
+	CMP BH_AG_STATE + BHAG_Q2
+	BEQ @red
+	BCC @red
+	LDA BH_AG_STATE + BHAG_Q2
+	CLC
+	ADC BH_AG_STATE + BHAG_Q1
+	CMP z:BH_T5
+	BEQ @red
+	BCC @red
+	LDA #BH_TYPE_GAUGE_GRN
+	BRA @put
+@red:
+	LDA #BH_TYPE_GAUGE_RED
+@put:
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_AG_BAR_BLOCK_X
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	CPX #9
+	BCC @block
+	; the A button under the bar, ringed while held
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_T7
+	CLC
+	ADC #22
+	STA z:BH_T1
+	LDA PAD_STATE
+	AND #PAD::A_BUTTON
+	BEQ :+
+	JSR BH_DRAW_RING_AT
+:	LDA #BH_TYPE_BUTTON_A
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_T7
+	SEC
+	SBC #10
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; ===========================================================================
+; B12 Wiggle - alternate Left and Right as fast as you can: each change of
+;   direction adds 6 px to a meter that drains p1 px a frame; after p2 frames
+;   the fill decides: p0 px or more PERFECT, two thirds GOOD, a third OK.
+;   A = fill, D = the last direction pressed.
+; ===========================================================================
+BH_AG_WIGGLE_INIT:
+	STZ BH_AG_STATE + BHAG_A
+	STZ BH_AG_STATE + BHAG_D
+	LDA BH_AG_STATE + BHAG_Q2
+	STA BH_AG_STATE + BHAG_TIMER
+	LDA #176
+	STA z:BH_T0
+	LDA #64
+	STA z:BH_T1
+	LDA #1
+	RTS
+
+BH_AG_WIGGLE_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BEQ @grade
+	LDA PAD_PRESS
+	AND #PAD::LEFT | PAD::RIGHT
+	BEQ @drain
+	CMP BH_AG_STATE + BHAG_D
+	BEQ @drain              ; the same side again does not count
+	STA BH_AG_STATE + BHAG_D
+	LDA BH_AG_STATE + BHAG_A
+	CLC
+	ADC #6
+	CMP #144
+	BCC :+
+	LDA #144
+:	STA BH_AG_STATE + BHAG_A
+	; the heart shakes with the presses
+	LDA BH_AG_STATE + BHAG_D
+	AND #PAD::LEFT
+	BEQ @right
+	DEC z:BH_HEART_X
+	DEC z:BH_HEART_X
+	BRA @drain
+@right:
+	INC z:BH_HEART_X
+	INC z:BH_HEART_X
+@drain:
+	LDA BH_AG_STATE + BHAG_A
+	SEC
+	SBC BH_AG_STATE + BHAG_Q1
+	BPL :+
+	LDA #0
+:	STA BH_AG_STATE + BHAG_A
+	RTS
+@grade:
+	LDA BH_AG_STATE + BHAG_A
+	CMP BH_AG_STATE + BHAG_Q0
+	BCS @g0
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_Q0
+	LSR
+	STA z:BH_T1             ; a half
+	LDA BH_AG_STATE + BHAG_Q0
+	LSR
+	LSR                     ; a quarter
+	STA z:BH_T2
+	LDA z:BH_T0
+	CMP z:BH_T1
+	BCS @g1
+	CMP z:BH_T2
+	BCS @g2
+	JSR BH_AG_HIT
+	LDA #3
+	JMP BH_AG_RESOLVE
+@g2:	LDA #2
+	JMP BH_AG_RESOLVE
+@g1:	LDA #1
+	JMP BH_AG_RESOLVE
+@g0:	LDA #0
+	JMP BH_AG_RESOLVE
+
+BH_AG_WIGGLE_RENDER:
+	JSR BH_MG_CENTRE
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #22
+	STA z:BH_T7             ; bar y
+	; the target line (first: in front of the blocks)
+	LDA #BH_TYPE_CURSOR
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	CLC
+	ADC BH_AG_STATE + BHAG_Q0
+	SEC
+	SBC #7
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	; nine blocks: yellow to the target, green past it; the filled part is drawn, the rest dim (skipped)
+	LDX #0
+@block:
+	STX z:BH_T6
+	TXA
+	ASL
+	ASL
+	ASL
+	STA z:BH_T5
+	CMP BH_AG_STATE + BHAG_A
+	BCS @next               ; not filled this far
+	CMP BH_AG_STATE + BHAG_Q0
+	BCC @yellow
+	LDA #BH_TYPE_GAUGE_GRN
+	BRA @put
+@yellow:
+	LDA #BH_TYPE_GAUGE_YEL
+@put:
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_AG_BAR_BLOCK_X
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@next:
+	LDX z:BH_T6
+	INX
+	CPX #9
+	BCC @block
+	JMP BH_AG_DRAW_HEART
+
+; ===========================================================================
+; Modifiers - a twist laid over the standard dodge box (block 1) or over a
+;   heart-moving block: scrambled controls (7), pull (8), closing walls (9),
+;   spotlight (11), freeze (17), two hearts (20). BHAG_AMOD names the one in
+;   force (0 during an ordinary phase); the dodge engine calls the hooks
+;   below every frame.
+; ===========================================================================
+BH_AG_MOD_INIT:
+	STZ BH_AG_STATE + BHAG_WALL
+	STZ BH_AG_STATE + BHAG_FRZ
+	STZ BH_AG_STATE + BHAG_H2X
+	STZ BH_AG_STATE + BHAG_H2Y
+	LDA BH_AG_STATE + BHAG_Q3
+	STA BH_AG_STATE + BHAG_FRZT
+	LDX #0
+:	STZ BH_AG_STATE + BHAG_MODARR,X
+	INX
+	INX
+	CPX #16
+	BCC :-
+	RTS
+
+; the hint for the dodge box: the modifier's line when one is in force
+BH_AG_DODGE_HINT:
+	LDA BH_AG_STATE + BHAG_AMOD
+	BEQ @plain
+	LDA BH_AG_STATE + BHAG_HINT
+	AND #$00FF
+	RTS
+@plain:
+	LDA #6                  ; "DODGE THE BULLETS"
+	RTS
+
+; carry set when the heart moves in the current game (the dodge box or a heart block)
+BH_AG_HEART_BLOCK:
+	LDA z:BH_MODE
+	BEQ @yes
+	LDA BH_AG_STATE + BHAG_BLOCK
+	AND #$00FF
+	CMP #BH_BLK_CELLS
+	BEQ @yes
+	CMP #BH_BLK_SWEEPS
+	BEQ @yes
+	CMP #BH_BLK_CATCH
+	BEQ @yes
+	CMP #BH_BLK_PICK
+	BEQ @yes
+	CLC
+	RTS
+@yes:
+	SEC
+	RTS
+
+; a hit caused by a modifier, in whichever game is running
+BH_AG_MOD_HIT:
+	LDA z:BH_IFRAMES
+	BNE @done
+	LDA z:BH_MODE
+	BNE @block
+	JMP BH_DODGE_HIT
+@block:
+	JMP BH_AG_HIT
+@done:
+	RTS
+
+BH_AG_SWAP_HEARTS:
+	LDA z:BH_HEART_X
+	LDY BH_AG_STATE + BHAG_H2X
+	STY z:BH_HEART_X
+	STA BH_AG_STATE + BHAG_H2X
+	LDA z:BH_HEART_Y
+	LDY BH_AG_STATE + BHAG_H2Y
+	STY z:BH_HEART_Y
+	STA BH_AG_STATE + BHAG_H2Y
+	RTS
+
+; ---- PAD_STATE as the game sees it (scrambled controls) ----
+BH_AG_PAD_STATE:
+	LDA BH_AG_STATE + BHAG_AMOD
+	CMP #BH_BLK_SCRAMBLE
+	BEQ @scrambled
+	LDA PAD_STATE
+	RTS
+@scrambled:
+	LDA BH_AG_STATE + BHAG_Q3
+	CMP #3
+	BEQ @lag
+	LDA PAD_STATE
+	JMP BH_AG_SCRAMBLE
+@lag:
+	; a ring of eight frames: this frame's state in, the state of six frames ago out
+	PHX
+	LDA z:BH_FRAME
+	AND #7
+	ASL
+	TAX
+	LDA PAD_STATE
+	STA BH_AG_STATE + BHAG_MODARR,X
+	LDA z:BH_FRAME
+	CLC
+	ADC #2
+	AND #7
+	ASL
+	TAX
+	LDA BH_AG_STATE + BHAG_MODARR,X
+	PLX
+	RTS
+
+; A = pad bits -> the same with the directions mirrored or rotated (BH_T5-BH_T7 used)
+BH_AG_SCRAMBLE:
+	STA z:BH_T7
+	AND #<~(PAD::UP | PAD::DOWN | PAD::LEFT | PAD::RIGHT) | $FF00
+	AND #$F0FF
+	STA z:BH_T6
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #3
+	ASL
+	ASL
+	ASL
+	STA z:BH_T5
+	LDX #0
+@dir:
+	LDA z:BH_T7
+	AND f:BH_AG_DIR_BITS,X
+	BEQ @next
+	PHX
+	TXA
+	CLC
+	ADC z:BH_T5
+	TAX
+	LDA f:BH_AG_DIR_MAP,X
+	PLX
+	ORA z:BH_T6
+	STA z:BH_T6
+@next:
+	INX
+	INX
+	CPX #8
+	BCC @dir
+	LDA z:BH_T6
+	RTS
+
+BH_AG_DIR_BITS:
+	.WORD PAD::LEFT, PAD::RIGHT, PAD::UP, PAD::DOWN
+BH_AG_DIR_MAP:
+	.WORD PAD::RIGHT, PAD::LEFT, PAD::UP, PAD::DOWN     ; 0 mirrored left/right
+	.WORD PAD::LEFT, PAD::RIGHT, PAD::DOWN, PAD::UP     ; 1 mirrored up/down
+	.WORD PAD::UP, PAD::DOWN, PAD::RIGHT, PAD::LEFT     ; 2 a quarter turn
+	.WORD PAD::LEFT, PAD::RIGHT, PAD::UP, PAD::DOWN     ; 3 (lag: unchanged)
+
+; ---- per frame, after the heart moved ----
+BH_AG_MOD_UPDATE:
+	LDA BH_AG_STATE + BHAG_AMOD
+	BEQ @done
+	CMP #BH_BLK_PULL
+	BEQ @pull
+	CMP #BH_BLK_WALLS
+	BEQ @walls
+	CMP #BH_BLK_FREEZE
+	BEQ @freeze
+	CMP #BH_BLK_TWO
+	BEQ @two
+@done:
+	RTS
+@pull:
+	JMP BH_AG_PULL_UPDATE
+@walls:
+	JMP BH_AG_WALLS_UPDATE
+@freeze:
+	JMP BH_AG_FREEZE_UPDATE
+@two:
+	JSR BH_AG_HEART_BLOCK
+	BCC @done
+	LDA BH_AG_STATE + BHAG_Q3
+	BNE @mirror_y
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	SEC
+	SBC #16
+	SEC
+	SBC z:BH_HEART_X
+	STA BH_AG_STATE + BHAG_H2X
+	LDA z:BH_HEART_Y
+	STA BH_AG_STATE + BHAG_H2Y
+	RTS
+@mirror_y:
+	LDA z:BH_HEART_X
+	STA BH_AG_STATE + BHAG_H2X
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC z:BH_BOX_Y1
+	SEC
+	SBC #18
+	SEC
+	SBC z:BH_HEART_Y
+	STA BH_AG_STATE + BHAG_H2Y
+	RTS
+
+; pull: p3 = direction (0 left 1 right 2 up 3 down) | strength << 4 (1-3);
+;   the edge it drags toward hurts
+BH_AG_PULL_DX:
+	.WORD $FFFF, 1, 0, 0
+BH_AG_PULL_DY:
+	.WORD 0, 0, $FFFF, 1
+BH_AG_PULL_MASK:
+	.WORD $FFFF, 3, 1, 0    ; frames between steps: never / every fourth / every other / every frame
+BH_AG_PULL_UPDATE:
+	JSR BH_AG_HEART_BLOCK
+	BCS :+
+	RTS
+:	LDA BH_AG_STATE + BHAG_Q3
+	LSR
+	LSR
+	LSR
+	LSR
+	AND #3
+	ASL
+	TAX
+	LDA z:BH_FRAME
+	AND f:BH_AG_PULL_MASK,X
+	BNE @edge
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #3
+	ASL
+	TAX
+	LDA z:BH_HEART_X
+	CLC
+	ADC f:BH_AG_PULL_DX,X
+	STA z:BH_HEART_X
+	LDA z:BH_HEART_Y
+	CLC
+	ADC f:BH_AG_PULL_DY,X
+	STA z:BH_HEART_Y
+	JSR BH_CLAMP_HEART
+@edge:
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #3
+	BEQ @left
+	CMP #1
+	BEQ @right
+	CMP #2
+	BEQ @up
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #BH_FRAME_BOTTOM + 13
+	CMP z:BH_HEART_Y
+	BEQ @hit
+	RTS
+@up:
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP - 2
+	CMP z:BH_HEART_Y
+	BEQ @hit
+	RTS
+@left:
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT - 2
+	CMP z:BH_HEART_X
+	BEQ @hit
+	RTS
+@right:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #BH_FRAME_RIGHT + 14
+	CMP z:BH_HEART_X
+	BEQ @hit
+	RTS
+@hit:
+	JMP BH_AG_MOD_HIT
+
+; closing walls: p3 = 1 left and right, 2 top and bottom, 3 all four; the
+;   inset grows a pixel every fourth frame until a 40 px hole is left; a wall
+;   that advances into the heart hurts, leaning on one does not
+BH_AG_WALLS_UPDATE:
+	JSR BH_AG_HEART_BLOCK
+	BCS :+
+	RTS
+:	STZ z:BH_T7             ; 1 once the walls advanced this frame
+	LDA z:BH_FRAME
+	AND #3
+	BNE @clamp
+	; the largest inset: the smaller interior span less 40, halved
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	STA z:BH_T0
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	STA z:BH_T1
+	LDA BH_AG_STATE + BHAG_Q3
+	CMP #1
+	BEQ @use_x
+	CMP #2
+	BEQ @use_y
+	LDA z:BH_T0
+	CMP z:BH_T1
+	BCC @use_x
+@use_y:
+	LDA z:BH_T1
+	BRA @span
+@use_x:
+	LDA z:BH_T0
+@span:
+	SEC
+	SBC #56
+	LSR
+	CMP BH_AG_STATE + BHAG_WALL
+	BEQ @clamp
+	BCC @clamp
+	INC BH_AG_STATE + BHAG_WALL
+	INC z:BH_T7
+@clamp:
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #1
+	BEQ @tb
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT - 2
+	CLC
+	ADC BH_AG_STATE + BHAG_WALL
+	CMP z:BH_HEART_X
+	BCC @xmin_ok
+	BEQ @xmin_ok
+	STA z:BH_HEART_X
+	JSR @crush
+@xmin_ok:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #BH_FRAME_RIGHT + 14
+	SEC
+	SBC BH_AG_STATE + BHAG_WALL
+	CMP z:BH_HEART_X
+	BCS @xmax_ok
+	STA z:BH_HEART_X
+	JSR @crush
+@xmax_ok:
+@tb:
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #2
+	BEQ @done
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP - 2
+	CLC
+	ADC BH_AG_STATE + BHAG_WALL
+	CMP z:BH_HEART_Y
+	BCC @ymin_ok
+	BEQ @ymin_ok
+	STA z:BH_HEART_Y
+	JSR @crush
+@ymin_ok:
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #BH_FRAME_BOTTOM + 13
+	SEC
+	SBC BH_AG_STATE + BHAG_WALL
+	CMP z:BH_HEART_Y
+	BCS @done
+	STA z:BH_HEART_Y
+	JSR @crush
+@done:
+	RTS
+@crush:
+	LDA z:BH_T7
+	BEQ @lean               ; the player pushed into the wall: it just holds
+	JMP BH_AG_MOD_HIT
+@lean:
+	RTS
+
+; freeze: p3 = frames between freezes; a 20 frame warning, then 30 frames in
+;   which the heart must not move (or, in a game without a heart, no button
+;   may be pressed)
+BH_AG_FREEZE_UPDATE:
+	LDA BH_AG_STATE + BHAG_FRZT
+	BEQ @change
+	DEC BH_AG_STATE + BHAG_FRZT
+	LDA BH_AG_STATE + BHAG_FRZ
+	CMP #2
+	BNE @done
+	JSR BH_AG_HEART_BLOCK
+	BCC @buttons
+	LDA z:BH_MOVED
+	BEQ @done
+	JMP BH_AG_MOD_HIT
+@buttons:
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON | PAD::B_BUTTON | PAD::X_BUTTON | PAD::Y_BUTTON | PAD::UP | PAD::DOWN | PAD::LEFT | PAD::RIGHT
+	BEQ @done
+	JMP BH_AG_MOD_HIT
+@change:
+	LDA BH_AG_STATE + BHAG_FRZ
+	BEQ @warn
+	CMP #1
+	BEQ @frozen
+	STZ BH_AG_STATE + BHAG_FRZ
+	LDA BH_AG_STATE + BHAG_Q3
+	STA BH_AG_STATE + BHAG_FRZT
+@done:
+	RTS
+@warn:
+	LDA #1
+	STA BH_AG_STATE + BHAG_FRZ
+	LDA #20
+	STA BH_AG_STATE + BHAG_FRZT
+	LDA #SFX::CURSOR1
+	JMP BH_MG_SOUND
+@frozen:
+	LDA #2
+	STA BH_AG_STATE + BHAG_FRZ
+	LDA #30
+	STA BH_AG_STATE + BHAG_FRZT
+	LDA #SFX::CURSOR3
+	JMP BH_MG_SOUND
+
+; ---- the dodge phase: bullets against the second heart ----
+BH_AG_MOD_COLLIDE:
+	LDA BH_AG_STATE + BHAG_AMOD
+	CMP #BH_BLK_TWO
+	BNE @done
+	LDA z:BH_IFRAMES
+	BNE @done
+	JSR BH_AG_SWAP_HEARTS
+	LDX #0
+@bullet:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	JSR BH_COLLIDE_ONE
+	BCC @next
+	JSR BH_DODGE_HIT
+	BRA @restore
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @bullet
+@restore:
+	JSR BH_AG_SWAP_HEARTS
+@done:
+	RTS
+
+; carry set when the sprite at BH_T0/BH_T1 is inside the spotlight (or no spotlight is in force)
+BH_AG_IN_LIGHT:
+	LDA BH_AG_STATE + BHAG_AMOD
+	CMP #BH_BLK_SPOTLIGHT
+	BNE @in
+	LDA z:BH_T0
+	SEC
+	SBC z:BH_HEART_X
+	JSR BH_ABS
+	CMP BH_AG_STATE + BHAG_Q3
+	BCS @out
+	LDA z:BH_T1
+	SEC
+	SBC z:BH_HEART_Y
+	JSR BH_ABS
+	CMP BH_AG_STATE + BHAG_Q3
+	BCS @out
+@in:
+	SEC
+	RTS
+@out:
+	CLC
+	RTS
+
+; ---- the modifier's own sprites, after the game's ----
+BH_AG_MOD_RENDER:
+	LDA BH_AG_STATE + BHAG_AMOD
+	BEQ @done
+	CMP #BH_BLK_PULL
+	BEQ @pull
+	CMP #BH_BLK_WALLS
+	BEQ @walls
+	CMP #BH_BLK_SPOTLIGHT
+	BEQ @light
+	CMP #BH_BLK_FREEZE
+	BEQ @freeze
+	CMP #BH_BLK_TWO
+	BEQ @two
+@done:
+	RTS
+@pull:
+	JMP BH_AG_PULL_RENDER
+@walls:
+	JMP BH_AG_WALLS_RENDER
+@light:
+	JMP BH_AG_LIGHT_RENDER
+@freeze:
+	JMP BH_AG_FREEZE_RENDER
+@two:
+	JSR BH_AG_HEART_BLOCK
+	BCC @done
+	LDA z:BH_IFRAMES
+	BEQ @draw2
+	AND #4
+	BNE @done
+@draw2:
+	LDA BH_AG_STATE + BHAG_H2X
+	STA z:BH_T0
+	LDA BH_AG_STATE + BHAG_H2Y
+	STA z:BH_T1
+	LDA z:BH_PIECE_TILE + 0
+	STA z:BH_T2
+	STZ z:BH_T3
+	LDA #BH_ATTR_BASE | $40
+	STA z:BH_T4
+	JMP BH_OAM_PUT
+
+; the harmful edge: red blocks mostly under the frame, 4 px showing
+BH_AG_PULL_RENDER:
+	JSR BH_AG_HEART_BLOCK
+	BCS :+
+	RTS
+:	LDA #BH_TYPE_GAUGE_RED
+	JSR BH_TILE_FOR_TYPE
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #3
+	CMP #2
+	BCS @horizontal
+	; a column at the left or right edge
+	CMP #0
+	BNE @right
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #4
+	BRA @col
+@right:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #12
+@col:
+	STA z:BH_T5
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #8
+	STA z:BH_T6
+@col_block:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_T6
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T6
+	CLC
+	ADC #16
+	STA z:BH_T6
+	CLC
+	ADC #8
+	CMP z:BH_BOX_Y1
+	BCC @col_block
+	RTS
+@horizontal:
+	CMP #2
+	BNE @bottom
+	LDA z:BH_BOX_Y0
+	SEC
+	SBC #5
+	BRA @row
+@bottom:
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #13
+@row:
+	STA z:BH_T6
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_T5
+@row_block:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_T6
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	CLC
+	ADC #8
+	CMP z:BH_BOX_X1
+	BCC @row_block
+	RTS
+
+; the wall faces: thin lines at the inset
+BH_AG_WALLS_RENDER:
+	JSR BH_AG_HEART_BLOCK
+	BCS :+
+	RTS
+:	LDA BH_AG_STATE + BHAG_Q3
+	AND #1
+	BEQ @tb
+	LDA #BH_TYPE_VLINE
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT - 2
+	CLC
+	ADC BH_AG_STATE + BHAG_WALL
+	STA z:BH_T5
+	JSR @column
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #BH_FRAME_RIGHT
+	SEC
+	SBC BH_AG_STATE + BHAG_WALL
+	STA z:BH_T5
+	JSR @column
+@tb:
+	LDA BH_AG_STATE + BHAG_Q3
+	AND #2
+	BEQ @done
+	LDA #BH_TYPE_HLINE16
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP - 2
+	CLC
+	ADC BH_AG_STATE + BHAG_WALL
+	STA z:BH_T6
+	JSR @row
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #BH_FRAME_BOTTOM
+	SEC
+	SBC BH_AG_STATE + BHAG_WALL
+	STA z:BH_T6
+	JSR @row
+@done:
+	RTS
+@column:
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP
+	STA z:BH_T6
+@seg:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_T6
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T6
+	CLC
+	ADC #16
+	STA z:BH_T6
+	CLC
+	ADC #BH_FRAME_BOTTOM
+	CMP z:BH_BOX_Y1
+	BCC @seg
+	RTS
+@row:
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT
+	STA z:BH_T5
+@rseg:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_T6
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	CLC
+	ADC #BH_FRAME_RIGHT
+	CMP z:BH_BOX_X1
+	BCC @rseg
+	RTS
+
+; the edge of the light: four dots at the radius
+BH_AG_LIGHT_RENDER:
+	JSR BH_AG_HEART_BLOCK
+	BCS :+
+	RTS
+:	LDX #0
+@dot:
+	STX z:BH_T6
+	LDA #BH_TYPE_DOT
+	JSR BH_TILE_FOR_TYPE
+	LDX z:BH_T6
+	LDA f:BH_AG_PULL_DX,X
+	LDY BH_AG_STATE + BHAG_Q3
+	JSR BH_AG_MUL_SIGNED
+	CLC
+	ADC z:BH_HEART_X
+	STA z:BH_T0
+	LDA f:BH_AG_PULL_DY,X
+	LDY BH_AG_STATE + BHAG_Q3
+	JSR BH_AG_MUL_SIGNED
+	CLC
+	ADC z:BH_HEART_Y
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #8
+	BCC @dot
+	RTS
+
+; the warning spark, then the ring, at the top of the box (and around the heart)
+BH_AG_FREEZE_RENDER:
+	LDA BH_AG_STATE + BHAG_FRZ
+	BEQ @done
+	CMP #1
+	BEQ @warning
+	; frozen: a ring at the top, and around the heart when there is one
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	LSR
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP + 1
+	STA z:BH_T1
+	JSR BH_DRAW_RING_AT
+	JSR BH_AG_HEART_BLOCK
+	BCC @done
+	LDA z:BH_HEART_X
+	STA z:BH_T0
+	LDA z:BH_HEART_Y
+	STA z:BH_T1
+	JMP BH_DRAW_RING_AT
+@warning:
+	LDA z:BH_FRAME
+	AND #2
+	BNE @done
+	LDA #BH_TYPE_SPARK
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	LSR
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP + 1
+	STA z:BH_T1
+	JMP BH_OAM_PUT
+@done:
+	RTS
+
+; ===========================================================================
+; Arrow helpers - BH_T0/BH_T1 = position, A = direction 0 left 1 right 2 up 3 down
+; ===========================================================================
+BH_AG_DRAW_ARROW:
+	CMP #2
+	BCS @vertical
+	PHA
+	LDA #BH_TYPE_ARROW_R
+	JSR BH_TILE_FOR_TYPE
+	PLA
+	BNE @put                ; right: as drawn
+	LDA z:BH_T4
+	ORA #$40                ; left: flipped
+	STA z:BH_T4
+	BRA @put
+@vertical:
+	PHA
+	LDA #BH_TYPE_ARROW_U
+	JSR BH_TILE_FOR_TYPE
+	PLA
+	CMP #2
+	BEQ @put
+	LDA z:BH_T4
+	ORA #$80                ; down: flipped
+	STA z:BH_T4
+@put:
+	JMP BH_OAM_PUT
+
+; PAD_PRESS (scrambled when that modifier is in force) -> A = direction pressed, or -1
+BH_AG_DIR_PRESSED:
+	LDA PAD_PRESS
+	AND #PAD::UP | PAD::DOWN | PAD::LEFT | PAD::RIGHT
+	BEQ @none
+	LDY BH_AG_STATE + BHAG_AMOD
+	CPY #BH_BLK_SCRAMBLE
+	BNE :+
+	JSR BH_AG_SCRAMBLE
+:	STA z:BH_T7
+	LDX #0
+@dir:
+	LDA z:BH_T7
+	AND f:BH_AG_DIR_BITS,X
+	BNE @found
+	INX
+	INX
+	CPX #8
+	BCC @dir
+@none:
+	LDA #$FFFF
+	RTS
+@found:
+	TXA
+	LSR
+	RTS
+
+; ===========================================================================
+; B6 Arrow chain - p0 arrows to press in order before the bar (p1 x 20
+;   frames) empties. A wrong press is a hit; the chain then carries on.
+; ===========================================================================
+BH_AG_ARROWS_INIT:
+	LDA z:BH_PIECE_TILE + 2
+	CMP #$FFFF
+	BEQ @no
+	LDX #0
+@fill:
+	LDA #4
+	STA z:BH_T7
+	PHX
+	JSR BH_AG_RAND_BELOW
+	PLX
+	STA BH_AG_STATE + BHAG_ARR,X
+	INX
+	INX
+	CPX #12
+	BCC @fill
+	LDA BH_AG_STATE + BHAG_Q1
+	ASL
+	ASL
+	STA z:BH_T0
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T0             ; x 20
+	STA BH_AG_STATE + BHAG_TIMER
+	LDY #9
+	JSR BH_DIV8
+	INC
+	STA BH_AG_STATE + BHAG_B  ; frames per bar segment
+	LDA #176
+	STA z:BH_T0
+	LDA #80
+	STA z:BH_T1
+	LDA #1
+	RTS
+@no:
+	LDA #0
+	RTS
+
+BH_AG_ARROWS_UPDATE:
+	LDA BH_AG_STATE + BHAG_TIMER
+	BNE :+
+	JSR BH_AG_HIT           ; out of time
+	JMP BH_AG_RESOLVE_BY_HITS
+:	JSR BH_AG_DIR_PRESSED
+	BMI @done
+	LDX BH_AG_STATE + BHAG_STEP
+	CMP BH_AG_STATE + BHAG_ARR,X
+	BNE @wrong
+	INX
+	INX
+	STX BH_AG_STATE + BHAG_STEP
+	TXA
+	LSR
+	CMP BH_AG_STATE + BHAG_Q0
+	BCS @all_done
+	LDA #SFX::CURSOR2
+	JMP BH_MG_SOUND
+@all_done:
+	JMP BH_AG_RESOLVE_BY_HITS
+@wrong:
+	JMP BH_AG_HIT
+@done:
+	RTS
+
+BH_AG_ARROWS_RENDER:
+	JSR BH_MG_CENTRE
+	; the arrows, 20 px apart, the done ones ringed
+	LDA BH_AG_STATE + BHAG_Q0
+	ASL
+	ASL
+	ASL                     ; 8 n
+	CLC
+	ADC BH_AG_STATE + BHAG_Q0
+	ADC BH_AG_STATE + BHAG_Q0   ; 10 n = half the row
+	STA z:BH_T7
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC z:BH_T7
+	STA z:BH_T7             ; the row's left edge
+	LDX #0
+@arrow:
+	STX z:BH_T6
+	TXA
+	ASL
+	STA z:BH_T5             ; 2 X
+	ASL
+	ASL                     ; 8 X
+	CLC
+	ADC z:BH_T5             ; 10 X = 20 i (X counts by two)
+	CLC
+	ADC z:BH_T7
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #16
+	STA z:BH_T1
+	CPX BH_AG_STATE + BHAG_STEP
+	BCS @pending
+	JSR BH_DRAW_RING_AT
+	BRA @next
+@pending:
+	LDX z:BH_T6
+	LDA BH_AG_STATE + BHAG_ARR,X
+	JSR BH_AG_DRAW_ARROW
+@next:
+	LDX z:BH_T6
+	INX
+	INX
+	TXA
+	LSR
+	CMP BH_AG_STATE + BHAG_Q0
+	BCC @arrow
+	; the cursor under the current arrow
+	LDA BH_AG_STATE + BHAG_STEP
+	LSR
+	CMP BH_AG_STATE + BHAG_Q0
+	BCS @bar
+	LDA #BH_TYPE_CURSOR
+	JSR BH_TILE_FOR_TYPE
+	LDA BH_AG_STATE + BHAG_STEP
+	ASL
+	STA z:BH_T5
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T5
+	CLC
+	ADC z:BH_T7
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC #2
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@bar:
+	JSR BH_AG_DRAW_TIME_BAR
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #30
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; the time left (BHAG_TIMER, BHAG_B frames a segment) as up to nine 16 px line segments near the top
+BH_AG_DRAW_TIME_BAR:
+	LDA BH_AG_STATE + BHAG_B
+	BEQ @done
+	LDA BH_AG_STATE + BHAG_TIMER
+	BEQ @done
+	LDY BH_AG_STATE + BHAG_B
+	JSR BH_DIV8
+	INC
+	STA z:BH_T6
+	LDA #BH_TYPE_HLINE16
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	STA z:BH_T5
+@seg:
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP + 3
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	DEC z:BH_T6
+	BNE @seg
+@done:
+	RTS
+
+; ===========================================================================
+; B18 Copy - a sequence of p0 directions is shown one at a time (p1 frames
+;   each, as arrows when p2 = 1, else as a lit cell around the centre), then
+;   repeated on the D-pad. A wrong press is a hit.
+;   STEP 0 showing (A = item, E = frames left, F = 1 during the gap between
+;   items), STEP 1 repeating (A = next item, D/F = the last press and its glow).
+; ===========================================================================
+BH_AG_COPY_INIT:
+	LDA z:BH_PIECE_TILE + 2
+	CMP #$FFFF
+	BEQ @no
+	LDX #0
+@fill:
+	LDA #4
+	STA z:BH_T7
+	PHX
