+	LDY BH_AG_STATE + BHAG_D
+	BNE @plus
+	EOR #$FFFF
+	INC
+@plus:
+	CLC
+	ADC z:BH_HEART_X
+	STA BH_AG_STATE + BHAG_C
+	LDA #1
+	STA BH_AG_STATE + BHAG_STEP
