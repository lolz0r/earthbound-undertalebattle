+		BH_SPAWN BH_TYPE_THEME3, 108, -20, 0, 22
+		BH_SPAWN BH_TYPE_THEME2, 152, -20, 11, 22
+		BH_WAIT 69
+		BH_AIMED BH_TYPE_THEME3, BH_EDGE_LEFT, 29
+		BH_WAIT 5
+		BH_AIMED BH_TYPE_THEME3, BH_EDGE_LEFT, 29
+		BH_WAIT 5
