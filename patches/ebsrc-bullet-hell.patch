+		BH_AIMED BH_TYPE_THEME2, BH_EDGE_RIGHT, 36
+		BH_WAIT 10
+		BH_AIMED BH_TYPE_THEME2, BH_EDGE_RIGHT, 36
+		BH_WAIT 10
