+	LDA BH_AG_STATE + BHAG_Q1
+	STA z:BH_T6
+	LDA BH_AG_STATE + BHAG_C
+	STA z:BH_T5
+@dot:
+	DEC z:BH_T6
+	BEQ @heart
+	LDA BH_AG_STATE + BHAG_D
+	BNE @back_left
+	LDA z:BH_T5
+	CLC
+	ADC BH_AG_STATE + BHAG_B
+	BRA @dot_at
+@back_left:
+	LDA z:BH_T5
+	SEC
+	SBC BH_AG_STATE + BHAG_B
+@dot_at:
+	STA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_HEART_Y
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	BRA @dot
+@heart:
+	JMP BH_AG_DRAW_HEART
