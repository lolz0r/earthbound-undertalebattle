+	JSR BH_AG_DIR_PRESSED
+	BMI @done
+	CMP #2
+	BCS @done               ; up / down do nothing
+	CMP #0
+	BNE @right
+	LDA z:BH_HEART_X
+	SEC
+	SBC BH_AG_STATE + BHAG_B
+	BRA @moved
