@@ -0,0 +1,3166 @@
+; ---------------------------------------------------------------------------
+; Bullet-hell (Undertale-style) dodge phase for EarthBound.
+;
+; When an enemy performs an attack, BH_ENEMY_ACTION_HOOK (called from the main
+; battle routine after the "X attacks!" text) runs a real-time dodge phase:
+; a box is drawn above the party HP windows, the enemies slide up, the player's
+; heart moves inside the box and a bullet pattern plays. If the heart is never
+; hit the action is skipped ("dodged swiftly"); otherwise the original action
+; resolves as usual.
+;
+; Calling conventions:
+;   - Entry points are JSL targets. They preserve P, DB and D.
+;   - Inside the engine D = BH_DP (a 224 byte block in low RAM) and DB = $7E.
+;   - EarthBound "C" functions need D to be a C stack frame, so they are called
+;     through BH_CALL_C which temporarily restores the caller's D.
+; ---------------------------------------------------------------------------
+
+.A16
+.I16
+
+.MACRO BH_ENTER
+	PHP
+	PHB
+	PHD
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PEA $7E7E
+	PLB
+	PLB
+	TDC
+	STA a:BH_DP + BH_CALLER_D
+	LDA #.LOWORD(BH_DP)
+	TCD
+.ENDMACRO
+
+; same, but does not touch BH_CALLER_D (used by the render hook, which runs
+; nested inside WINDOW_TICK while a phase is active)
+.MACRO BH_ENTER_NESTED
+	PHP
+	PHB
+	PHD
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PEA $7E7E
+	PLB
+	PLB
+	LDA #.LOWORD(BH_DP)
+	TCD
+.ENDMACRO
+
+.MACRO BH_LEAVE
+	PLD
+	PLB
+	PLP
+	RTL
+.ENDMACRO
+
+; call an EarthBound routine with the caller's direct page (A/X/Y passed through)
+.MACRO BH_CALL_C func
+	PHD
+	PHA
+	LDA z:BH_CALLER_D
+	TCD
+	PLA
+	JSL func
+	PLD
+.ENDMACRO
+
+; ===========================================================================
+; BH_BATTLE_INIT - clear engine state; called at the start of BATTLE_ROUTINE
+; ===========================================================================
+BH_BATTLE_INIT:
+	PHP
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PHA
+	PHX
+	LDX #0
+@clear:
+	STZ a:BH_DP,X
+	INX
+	INX
+	CPX #BH_DP_SIZE
+	BCC @clear
+	LDA #$FFFF
+	STA a:BH_DP + BH_GFX_SLOT
+	PLX
+	PLA
+	PLP
+	RTL
+
+; ===========================================================================
+; BH_BATTLE_GFX_INIT - upload the sprite tiles right after the enemy sprites
+;   were loaded (screen still blanked, so the DMA is immediate and free)
+; ===========================================================================
+BH_BATTLE_GFX_INIT:
+	BH_ENTER
+	JSR BH_UPLOAD_TILES
+	BH_LEAVE
+
+; ===========================================================================
+; BH_ENEMY_ACTION_HOOK
+;   Called after the attacker's action text was shown, before the targets are
+;   processed. Returns A = 0 when the party dodged everything (the caller then
+;   skips the action), A = 1 otherwise.
+; ===========================================================================
+BH_ENEMY_ACTION_HOOK:
+	BH_ENTER
+	STZ z:BH_DMG_PCT
+	STZ z:BH_FIGHT_RESULT
+	STZ z:BH_FORCE
+	; Auto Fight = classic battles: no timing gauge, no dodge phase, the
+	; original hit/miss/SMAAAASH rolls decide everything
+	LDA GAME_STATE + game_state::auto_fight_enable
+	AND #$00FF
+	BEQ :+
+	JMP @normal
+:
+	LDX CURRENT_ATTACKER
+	LDA a:battler::ally_or_enemy,X
+	AND #$00FF
+	CMP #1
+	BEQ @enemy
+	; ---- party member: physical attacks get the FIGHT timing gauge ----
+	LDA a:battler::id,X
+	BEQL @normal
+	CMP #5
+	BCC :+                  ; only the four playable characters
+	JMP @normal
+:
+	JSR BH_ACTION_TYPE
+	CMP #ACTION_TYPE::PHYSICAL
+	BNEL @normal
+	LDA z:BH_PIECE_TILE + 6 ; the gauge piece found no sprite VRAM: classic resolution
+	CMP #$FFFF
+	BEQL @normal
+	JSR BH_PICK_ATTACK_GAME ; gauge, rhythm or focus: sets BH_DMG_PCT from the timing
+	JMP @normal
+@enemy:
+	JSR BH_ACTION_TYPE
+	BEQL @normal            ; ACTION_TYPE::NOTHING
+	CMP #ACTION_TYPE::ITEM
+	BEQL @normal
+	LDA z:BH_PIECE_TILE + 4 ; no sprite VRAM for the box pieces: classic resolution
+	CMP #$FFFF
+	BEQL @normal
+	STA z:BH_T1             ; action type
+	; find the first targeted party member
+	LDX #0
+@scan:
+	STX z:BH_T2
+	TXA
+	BH_CALL_C IS_CHAR_TARGETTED
+	CMP #0
+	BNE @found
+	LDX z:BH_T2
+	INX
+	CPX #FIRST_ENEMY_INDEX
+	BCC @scan
+	JMP @normal
+@found:
+	LDA z:BH_T2
+	LDY #.SIZEOF(battler)
+	JSL MULT168
+	CLC
+	ADC #.LOWORD(BATTLERS_TABLE)
+	STA CURRENT_TARGET
+	BH_CALL_C FIX_TARGET_NAME
+	; bullet speed from the enemy's level: 13 + level/4, at most 26 (16 = 1.0)
+	LDX CURRENT_ATTACKER
+	LDA a:battler::id,X
+	STA z:BH_T3             ; enemy id
+	LDY #.SIZEOF(enemy_data)
+	JSL MULT168
+	TAX
+	LDA f:ENEMY_CONFIGURATION_TABLE + enemy_data::level,X
+	AND #$00FF
+	LSR
+	LSR
+	CLC
+	ADC #13
+	CMP #27
+	BCC @speed_ok
+	LDA #26
+@speed_ok:
+	STA z:BH_SPEED
+	; ---- the enemy's own record: BH_ENEMY_TABLE + id * 12 ----
+	LDA z:BH_T3
+	CMP #231
+	BCC :+
+	LDA #0
+:	STA z:BH_T3
+	ASL
+	ASL
+	STA z:BH_T4             ; id*4
+	ASL
+	CLC
+	ADC z:BH_T4             ; id*12
+	TAX
+	STX z:BH_T5
+	LDA f:BH_ENEMY_TABLE + BHE_TYPE,X
+	AND #$00FF
+	STA z:BH_ENEMY_TYPE
+	LDA f:BH_ENEMY_TABLE + BHE_TYPE2,X
+	AND #$00FF
+	BNE :+
+	LDA z:BH_ENEMY_TYPE
+:	STA z:BH_ENEMY_TYPE2
+	LDA f:BH_ENEMY_TABLE + BHE_TEMPO,X
+	AND #$00FF
+	BNE :+
+	LDA #16
+:	STA z:BH_TEMPO
+	LDA f:BH_ENEMY_TABLE + BHE_BOX_W,X
+	AND #$00FF
+	STA z:BH_BOX_W_OVR
+	LDA f:BH_ENEMY_TABLE + BHE_BOX_H,X
+	AND #$00FF
+	STA z:BH_BOX_H_OVR
+	; speed = level speed * record factor / 16, kept within 8..40
+	LDA f:BH_ENEMY_TABLE + BHE_SPEED,X
+	AND #$00FF
+	BNE :+
+	LDA #16
+:	TAY
+	LDA z:BH_SPEED
+	JSL MULT168
+	LSR
+	LSR
+	LSR
+	LSR
+	CMP #8
+	BCS :+
+	LDA #8
+:	CMP #33
+	BCC :+
+	LDA #32                 ; playtests: nothing above 2.0x stays fair in a 224x88 box
+:	STA z:BH_SPEED
+	; pattern: physical/piercing attacks use the record's first program, everything else the second
+	LDX z:BH_T5
+	LDA z:BH_FORCE_PAT      ; test hook (harness playtests poke it): 1 = first program, 2 = second
+	BEQ @by_type
+	CMP #2
+	BEQ @force_psi
+	BRA @phys
+@force_psi:
+	LDA f:BH_ENEMY_TABLE + BHE_PAT_PSI,X
+	BRA @have_pat
+@by_type:
+	LDA z:BH_T1
+	CMP #ACTION_TYPE::PHYSICAL
+	BEQ @phys
+	CMP #ACTION_TYPE::PIERCING_PHYSICAL
+	BEQ @phys
+	LDA f:BH_ENEMY_TABLE + BHE_PAT_PSI,X
+	BRA @have_pat
+@phys:
+	LDA f:BH_ENEMY_TABLE + BHE_PAT_PHYS,X
+@have_pat:
+	JSR BH_SET_PATTERN
+	; ---- the attacker's own bullet sheet (uploaded at battle start) ----
+	LDA #$FFFF
+	STA z:BH_THEME_TILE
+	LDX #0
+@sheet:
+	LDA z:BH_SHEET_ID,X
+	CMP z:BH_T3
+	BNE :+
+	LDA z:BH_SHEET_TILE,X
+	STA z:BH_THEME_TILE
+:	INX
+	INX
+	CPX #8
+	BCC @sheet
+	; its four hit boxes
+	LDA z:BH_T3
+	ASL
+	ASL
+	ASL
+	TAX
+	LDA f:BH_ENEMY_HITBOXES,X
+	STA z:BH_THEME_HB
+	LDA f:BH_ENEMY_HITBOXES + 2,X
+	STA z:BH_THEME_HB + 2
+	LDA f:BH_ENEMY_HITBOXES + 4,X
+	STA z:BH_THEME_HB + 4
+	LDA f:BH_ENEMY_HITBOXES + 6,X
+	STA z:BH_THEME_HB + 6
+	LDA z:BH_THEME_HB
+	AND #$0080
+	STA z:BH_THEME_BIG      ; the sheet is one 32x32 sprite
+	; and the palette slot its sprite uses
+	LDX CURRENT_ATTACKER
+	LDA a:battler::vram_sprite_index,X
+	AND #$0003
+	STA z:BH_THEME_PAL
+	JSR BH_PICK_DEFENSE_GAME ; the dodge box or a timed block
+	LDA z:BH_HITS
+	BEQ @dodged
+	LDA z:BH_DMG_PCT
+	BNE :+
+	LDA #100
+	STA z:BH_DMG_PCT
+:	LDA #1
+	STA z:BH_FORCE          ; a hit in the box is a hit: no miss or dodge roll afterwards
+	BRA @normal
+@dodged:
+	; every bullet was dodged: "<target> dodged swiftly!"
+	PHD
+	LDA z:BH_CALLER_D
+	TCD
+	LOADPTR MSG_BTL_TATAKU_YOKETA, $0E
+	JSL DISPLAY_IN_BATTLE_TEXT
+	PLD
+	LDA #0
+	BRA @done
+@normal:
+	LDA #1
+@done:
+	STA z:BH_RESULT
+	BH_LEAVE
+
+; ---------------------------------------------------------------------------
+; BH_ACTION_TYPE - A = type of the current attacker's action (0 if none)
+; ---------------------------------------------------------------------------
+BH_ACTION_TYPE:
+	LDX CURRENT_ATTACKER
+	LDA a:battler::current_action,X
+	BEQ @none
+	STA z:BH_T0
+	ASL
+	CLC
+	ADC z:BH_T0             ; *3
+	ASL
+	ASL                     ; *12 = .SIZEOF(battle_action)
+	TAX
+	LDA f:BATTLE_ACTION_TABLE + battle_action::type,X
+	AND #$00FF
+	RTS
+@none:
+	LDA #0
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_SET_PATTERN - A = pattern index -> BH_PAT_PTR (programs live in bank $F0)
+; ---------------------------------------------------------------------------
+BH_SET_PATTERN:
+	ASL
+	TAX
+	LDA f:BH_PATTERN_TABLE,X
+	STA z:BH_PAT_PTR
+	LDA #^BH_PATTERN_TABLE
+	STA z:BH_PAT_PTR + 2    ; also clears the pad byte at $21
+	RTS
+
+; ===========================================================================
+; BH_MISS_OVERRIDE - called at the start of MISS_CALC and DETERMINE_DODGE.
+;   A = 0: roll as usual; 1: the attack always connects; 2: it always misses
+; ===========================================================================
+BH_MISS_OVERRIDE:
+	PHP
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	LDA a:BH_DP + BH_FORCE
+	PLP
+	RTL
+
+; ===========================================================================
+; BH_SMASH_OVERRIDE - called at the start of the SMAAAASH check.
+;   A = 0: no gauge was played for this action, roll as usual
+;   A = 1: the reticle hit the green zone, force a SMAAAASH
+;   A = 2: it did not, no SMAAAASH possible
+; ===========================================================================
+BH_SMASH_OVERRIDE:
+	PHP
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	LDA a:BH_DP + BH_FIGHT_RESULT
+	PLP
+	RTL
+
+; ===========================================================================
+; BH_SCALE_DAMAGE - called at the start of CALC_DAMAGE with X = damage.
+;   Applies BH_DMG_PCT (percent) to the damage, never below 1.
+; ===========================================================================
+BH_SCALE_DAMAGE:
+	PHP
+	PHB
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PEA $7E7E
+	PLB
+	PLB
+	PHA
+	PHY
+	LDA a:BH_DP + BH_DMG_PCT
+	BEQ @done
+	CMP #100
+	BEQ @done
+	TAY
+	TXA
+	CMP #400
+	BCS @big
+	JSL MULT168             ; damage * pct
+	LDY #100
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	BRA @store
+@big:
+	PHY
+	LDY #10
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	PLY
+	JSL MULT168             ; (damage/10) * pct
+	LDY #10
+	JSL DIVISION16S_DIVISOR_POSITIVE
+@store:
+	BNE @ok
+	INC
+@ok:
+	TAX
+@done:
+	PLY
+	PLA
+	PLB
+	PLP
+	RTL
+
+; ===========================================================================
+; BH_RUN_PHASE - set up and run one dodge phase; result in BH_HITS
+; ===========================================================================
+BH_RUN_PHASE:
+	JSR BH_ROLL_FREEZE
+	JSR BH_SETUP
+	JSR BH_BOX_OPEN
+	LDA #1
+	STA z:BH_PHASE
+@loop:
+	JSR BH_TICK
+	JSR BH_UPDATE
+	LDA z:BH_TIMER
+	BNE @loop
+	; phase over: close the box and let the enemies slide back down
+	STZ z:BH_PHASE
+	STZ z:BH_YSHIFT_TGT
+	JSR BH_BOX_CLOSE
+@ramp:
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	LDA z:BH_YSHIFT
+	BNE @ramp
+	JMP BH_ROLL_RESTORE
+
+; ---------------------------------------------------------------------------
+; BH_ROLL_FREEZE / BH_ROLL_RESTORE - the rolling HP/PP meters stop while a
+;   minigame plays (a hit that would be fatal only lands once the phase is
+;   over, so a quick player can still reach the menu and heal)
+; ---------------------------------------------------------------------------
+BH_ROLL_FREEZE:
+	LDA DISABLE_HPPP_ROLLING
+	AND #$00FF
+	STA z:BH_SAVED_ROLL
+	SEP #PROC_FLAGS::ACCUM8
+	LDA #1
+	STA DISABLE_HPPP_ROLLING
+	REP #PROC_FLAGS::ACCUM8
+	RTS
+
+BH_ROLL_RESTORE:
+	SEP #PROC_FLAGS::ACCUM8
+	LDA z:BH_SAVED_ROLL
+	STA DISABLE_HPPP_ROLLING
+	REP #PROC_FLAGS::ACCUM8
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_GAME_WINDOW_OPEN - open the box as one of the game's own windows: the
+;   frame with rounded corners and the interior in the player's text flavour,
+;   sized to the final rectangle BH_TBOX_*. CREATE_WINDOW reads the geometry
+;   from BHW_CFG for the borrowed id. Without a free window slot the sprite
+;   border stays.
+; ---------------------------------------------------------------------------
+BH_GAME_WINDOW_OPEN:
+	STZ z:BH_WIN_OPEN
+	LDA CURRENT_FOCUS_WINDOW
+	STA z:BH_SAVED_FOCUS
+	LDA z:BH_TBOX_X0
+	LSR
+	LSR
+	LSR
+	STA BH_BULLETS + BHW_CFG + 0
+	LDA z:BH_TBOX_Y0
+	LSR
+	LSR
+	LSR
+	STA BH_BULLETS + BHW_CFG + 2
+	LDA z:BH_TBOX_X1
+	SEC
+	SBC z:BH_TBOX_X0
+	LSR
+	LSR
+	LSR
+	STA BH_BULLETS + BHW_CFG + 4
+	LDA z:BH_TBOX_Y1
+	SEC
+	SBC z:BH_TBOX_Y0
+	LSR
+	LSR
+	LSR
+	STA BH_BULLETS + BHW_CFG + 6
+	LDA #BH_WINDOW_ID
+	BH_CALL_C REDIRECT_CREATE_WINDOW
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	LDA z:BH_SAVED_FOCUS
+	STA CURRENT_FOCUS_WINDOW  ; text keeps going to the window it went to before
+	LDA OPEN_WINDOW_TABLE + BH_WINDOW_ID * 2
+	CMP #$FFFF
+	BEQ @none
+	LDA #1
+	STA z:BH_WIN_OPEN
+	; The window drawer adds $2000 (priority bit) to every interior tile, and
+	; high-priority BG3 covers all sprites. Interior words of $E040 wrap to
+	; $0040 in that add: the blank flavour tile at low priority, which shows
+	; through the masked background and sits under the heart and bullets.
+	LDA #$E000 + BH_WINDOW_BLANK
+	JSR BH_GAME_WINDOW_FILL
+@none:
+	RTS
+
+BH_GAME_WINDOW_CLOSE:
+	LDA z:BH_WIN_OPEN
+	BEQ @done
+	STZ z:BH_WIN_OPEN
+	LDA #BH_WINDOW_BLANK    ; plain blanks again: CLOSE_WINDOW frees any other tile
+	JSR BH_GAME_WINDOW_FILL
+	LDA CURRENT_FOCUS_WINDOW
+	STA z:BH_SAVED_FOCUS
+	LDA #BH_WINDOW_ID
+	BH_CALL_C CLOSE_WINDOW
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	LDA z:BH_SAVED_FOCUS
+	STA CURRENT_FOCUS_WINDOW
+@done:
+	RTS
+
+; A = word written to every interior tile of the box window's tile buffer
+;   (the full-size interior: the window is created at BH_TBOX_* size)
+BH_GAME_WINDOW_FILL:
+	STA z:BH_T2
+	LDA z:BH_TBOX_X1
+	SEC
+	SBC z:BH_TBOX_X0
+	LSR
+	LSR
+	LSR
+	DEC
+	DEC
+	TAY                     ; interior columns
+	LDA z:BH_TBOX_Y1
+	SEC
+	SBC z:BH_TBOX_Y0
+	LSR
+	LSR
+	LSR
+	DEC
+	DEC                     ; interior rows
+	JSL MULT16
+	STA z:BH_T0             ; interior tiles (boxes are at least 3x3 tiles)
+	LDA OPEN_WINDOW_TABLE + BH_WINDOW_ID * 2
+	LDY #.SIZEOF(window_stats)
+	JSL MULT168
+	TAX
+	LDA WINDOW_STATS + window_stats::tilemap_address,X
+	TAX
+	LDA z:BH_T2
+@fill:
+	STA a:0,X
+	INX
+	INX
+	DEC z:BH_T0
+	BNE @fill
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_GAME_WINDOW_FIT - the box window follows BH_BOX_*: the rectangle is
+;   rounded outward to whole tiles (at least the 2x2 frame) and BH_BOX_* is
+;   aligned to it so the background mask matches the frame, the window's
+;   position and size are rewritten and every window is redrawn on the next
+;   tick. Nothing happens while the sprite outline is in use.
+; ---------------------------------------------------------------------------
+BH_GAME_WINDOW_FIT:
+	LDA z:BH_WIN_OPEN
+	BNE :+
+	RTS
+:	JSR BH_GAME_WINDOW_ERASE
+	LDA z:BH_BOX_X0
+	AND #$FFF8
+	STA z:BH_BOX_X0
+	LDA z:BH_BOX_X1
+	CLC
+	ADC #7
+	AND #$FFF8
+	SEC
+	SBC z:BH_BOX_X0
+	CMP #16
+	BCS :+
+	LDA #16
+:	STA z:BH_T0             ; width in px
+	CLC
+	ADC z:BH_BOX_X0
+	STA z:BH_BOX_X1
+	LDA z:BH_BOX_Y0
+	AND #$FFF8
+	STA z:BH_BOX_Y0
+	LDA z:BH_BOX_Y1
+	CLC
+	ADC #7
+	AND #$FFF8
+	SEC
+	SBC z:BH_BOX_Y0
+	CMP #16
+	BCS :+
+	LDA #16
+:	STA z:BH_T1             ; height in px
+	CLC
+	ADC z:BH_BOX_Y0
+	STA z:BH_BOX_Y1
+	LDA OPEN_WINDOW_TABLE + BH_WINDOW_ID * 2
+	LDY #.SIZEOF(window_stats)
+	JSL MULT168
+	TAX
+	LDA z:BH_BOX_X0
+	LSR
+	LSR
+	LSR
+	STA WINDOW_STATS + window_stats::window_x,X
+	LDA z:BH_BOX_Y0
+	LSR
+	LSR
+	LSR
+	STA WINDOW_STATS + window_stats::window_y,X
+	LDA z:BH_T0
+	LSR
+	LSR
+	LSR
+	DEC
+	DEC
+	STA WINDOW_STATS + window_stats::width,X
+	LDA z:BH_T1
+	LSR
+	LSR
+	LSR
+	DEC
+	DEC
+	STA WINDOW_STATS + window_stats::height,X
+	; draw the window and queue the tilemap upload now: the tick skips both
+	; while a held button makes text print instantly, and the frame must reach
+	; the screen together with the mask table (redrawing every window would
+	; render the HP meters too, which costs a whole frame)
+	LDA OPEN_WINDOW_TABLE + BH_WINDOW_ID * 2
+	BH_CALL_C UNKNOWN_C107AF
+	BH_CALL_C UNKNOWN_C2038B
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	RTS
+
+; blank the final box area in the tilemap so a shrinking frame leaves nothing behind
+BH_GAME_WINDOW_ERASE:
+	LDA z:BH_TBOX_X1
+	SEC
+	SBC z:BH_TBOX_X0
+	LSR
+	LSR
+	LSR
+	STA z:BH_T0             ; columns
+	ASL
+	STA z:BH_T2
+	LDA #64
+	SEC
+	SBC z:BH_T2
+	STA z:BH_T2             ; bytes from the end of a row to the start of the next
+	LDA z:BH_TBOX_Y1
+	SEC
+	SBC z:BH_TBOX_Y0
+	LSR
+	LSR
+	LSR
+	STA z:BH_T1             ; rows
+	LDA z:BH_TBOX_Y0
+	LSR
+	LSR
+	LSR
+	XBA                     ; * 256
+	LSR
+	LSR                     ; * 64 bytes per tilemap row
+	STA z:BH_T3
+	LDA z:BH_TBOX_X0
+	LSR
+	LSR                     ; * 2 bytes per tile
+	AND #$FFFE
+	CLC
+	ADC z:BH_T3
+	CLC
+	ADC #.LOWORD(BG2_BUFFER)
+	TAX
+@row:
+	LDY z:BH_T0
+@col:
+	STZ a:0,X
+	INX
+	INX
+	DEY
+	BNE @col
+	TXA
+	CLC
+	ADC z:BH_T2
+	TAX
+	DEC z:BH_T1
+	BNE @row
+	RTS
+
+; the sprite outline only while the box is not a game window
+BH_DRAW_BORDER_IF_NEEDED:
+	LDA z:BH_WIN_OPEN
+	BNE :+
+	JMP BH_DRAW_BORDER
+:	RTS
+
+; ---------------------------------------------------------------------------
+; BH_WINDOW_ON - black out the box interior: window 2 masks BG1/BG2 inside the
+; box, with WH2/WH3 driven per scanline by HDMA channel 7. The game's own
+; window settings (letterbox bars on window 1) are kept.
+; ---------------------------------------------------------------------------
+BH_WINDOW_ON:
+	SEP #PROC_FLAGS::ACCUM8
+	; write the table that is not in use (the PPU latches the table address at
+	; the start of each frame, so swapping tables never tears mid-frame)
+	LDA z:BH_HDMA_WHICH
+	EOR #1
+	STA z:BH_HDMA_WHICH
+	REP #PROC_FLAGS::ACCUM8
+	LDX #BH_HDMA_TABLE
+	AND #$0001
+	BEQ :+
+	LDX #BH_HDMA_TABLE_B
+:	STX z:BH_T7             ; X = DP offset of the table to fill
+	SEP #PROC_FLAGS::ACCUM8
+	; table: [y0+1 lines: empty window] [h lines: interior] [1 line: empty] [end]
+	LDA z:BH_BOX_Y0
+	INC
+	STA z:$00,X
+	LDA #$FF
+	STA z:$01,X
+	LDA #$00
+	STA z:$02,X
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	BNE :+
+	INC                     ; a zero count would end the table early
+:	STA z:$03,X
+	LDA z:BH_BOX_X0
+	INC
+	INC
+	STA z:$04,X
+	LDA z:BH_BOX_X1
+	DEC
+	DEC
+	DEC
+	STA z:$05,X
+	LDA #$01
+	STA z:$06,X
+	LDA #$FF
+	STA z:$07,X
+	LDA #$00
+	STA z:$08,X
+	STA z:$09,X
+	; point the channel at the new table (latched by the PPU at the next frame)
+	REP #PROC_FLAGS::ACCUM8
+	LDA z:BH_T7
+	CLC
+	ADC #.LOWORD(BH_DP)
+	STA f:A1T7L
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_WINDOW_ENABLE - once per phase: channel 7 setup and the window registers.
+;   (Rewriting WH2/WH3 mid-frame would blank the mask until the next HDMA
+;   entry, so this must not run every frame.)
+; ---------------------------------------------------------------------------
+BH_WINDOW_ENABLE:
+	SEP #PROC_FLAGS::ACCUM8
+	; channel 7: two registers ($2128/$2129), direct table in bank $7E
+	LDA #$01
+	STA f:DMAP7
+	LDA #$28
+	STA f:BBAD7
+	LDA #$7E
+	STA f:A1B7
+	; start with an empty window 2 so nothing is masked until HDMA takes over
+	LDA #$FF
+	STA f:WH2
+	LDA #$00
+	STA f:WH3
+	; BG1/BG2: enable window 2 (not inverted); sprites ignore window 2
+	LDA z:BH_W12SEL_MIRROR
+	AND #$BB
+	ORA #$88
+	STA f:W12SEL
+	LDA z:BH_WOBJSEL_MIRROR
+	AND #$F3
+	STA f:WOBJSEL
+	LDA z:BH_TMW_MIRROR
+	ORA #$03
+	STA f:TMW
+	LDA #BH_HDMA_CHANNEL
+	TSB HDMAEN_MIRROR
+	REP #PROC_FLAGS::ACCUM8
+	RTS
+
+BH_WINDOW_OFF:
+	SEP #PROC_FLAGS::ACCUM8
+	LDA #BH_HDMA_CHANNEL
+	TRB HDMAEN_MIRROR
+	REP #PROC_FLAGS::ACCUM8
+	JSR BH_TICK             ; let the NMI switch the HDMA channel off first
+	SEP #PROC_FLAGS::ACCUM8
+	LDA z:BH_W12SEL_MIRROR
+	STA f:W12SEL
+	LDA z:BH_WOBJSEL_MIRROR
+	STA f:WOBJSEL
+	LDA z:BH_TMW_MIRROR
+	STA f:TMW
+	LDA #$00
+	STA f:WH2
+	LDA #$FF
+	STA f:WH3
+	REP #PROC_FLAGS::ACCUM8
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_TICK - advance one frame using the battle engine's own frame routine
+;           (keeps HP meters rolling, backgrounds animating, sprites drawn)
+; ---------------------------------------------------------------------------
+BH_TICK:
+	LDA FRAME_COUNTER
+	AND #$00FF
+	STA z:BH_T7
+	BH_CALL_C WINDOW_TICK
+	LDA FRAME_COUNTER
+	AND #$00FF
+	CMP z:BH_T7
+	BNE @ticked
+	BH_CALL_C UNKNOWN_C43568     ; WINDOW_TICK bailed early: wait for a frame ourselves
+@ticked:
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_SETUP - box geometry, heart, pattern header, bullets, graphics
+; ---------------------------------------------------------------------------
+BH_SETUP:
+	; pattern header: w, h, duration
+	LDY #0
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	STA z:BH_T0             ; w
+	LDY #1
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	STA z:BH_T1             ; h
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	STA z:BH_TIMER
+	LDA z:BH_PAT_PTR
+	CLC
+	ADC #4
+	STA z:BH_PAT_PTR
+	LDA z:BH_BOX_W_OVR
+	BEQ :+
+	STA z:BH_T0
+:	LDA z:BH_BOX_H_OVR
+	BEQ :+
+	STA z:BH_T1
+:	JSR BH_SET_BOX
+	; counters
+	STZ z:BH_MODE
+	LDA #20
+	STA z:BH_PAT_WAIT       ; grace period: no bullet during the first 20 frames (human reaction time)
+	STZ z:BH_LOOP_CNT
+	STZ z:BH_HITS
+	STZ z:BH_IFRAMES
+	STZ z:BH_FRAME
+	STZ z:BH_MOVED
+	STZ z:BH_SPAWN_MODE
+	LDA z:BH_SPEED
+	BNE @speed_ok
+	LDA #16
+	STA z:BH_SPEED
+@speed_ok:
+	; free all bullets
+	LDX #0
+@clr:
+	STZ BH_BULLETS + BHB_TYPE,X
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @clr
+	; the enemies fly off the top of the screen while the box is open
+	LDA #1
+	JSR BH_CALC_YSHIFT
+	; graphics
+	JSR BH_UPLOAD_GFX
+	LDA #6
+	JMP BH_UPLOAD_HINT      ; "DODGE THE BULLETS"
+
+; ---------------------------------------------------------------------------
+; BH_SET_BOX - BH_T0 = width, BH_T1 = height -> box centred horizontally with
+;              its bottom edge fixed; heart placed in the middle
+; ---------------------------------------------------------------------------
+BH_SET_BOX:
+	; whole tiles only: the box is one of the game's windows
+	LDA z:BH_T0
+	CLC
+	ADC #7
+	AND #$FFF8
+	CMP #BH_BOX_MAX_W + 1
+	BCC :+
+	LDA #BH_BOX_MAX_W
+:	STA z:BH_T0
+	LDA z:BH_T1
+	CLC
+	ADC #7
+	AND #$FFF8
+	CMP #BH_BOX_MAX_H + 1
+	BCC :+
+	LDA #BH_BOX_MAX_H
+:	STA z:BH_T1
+	LDA z:BH_T0
+	LSR
+	STA z:BH_T2
+	LDA #128
+	SEC
+	SBC z:BH_T2
+	AND #$FFF8
+	STA z:BH_BOX_X0
+	CLC
+	ADC z:BH_T0
+	STA z:BH_BOX_X1
+	LDA #BH_BOX_BOTTOM
+	STA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_T1
+	STA z:BH_BOX_Y0
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_T2
+	SEC
+	SBC #8
+	STA z:BH_HEART_X
+	LDA z:BH_T1
+	LSR
+	CLC
+	ADC z:BH_BOX_Y0
+	SEC
+	SBC #8
+	STA z:BH_HEART_Y
+	RTS
+
+; ===========================================================================
+; BH_FIGHT_PHASE - Undertale-style attack timing: a cursor sweeps across a
+;   red/yellow/green gauge; press A near the centre for full damage.
+;   Result in BH_DMG_PCT (30..130, or 20 when the player never pressed).
+; ===========================================================================
+BH_FIGHT_PHASE:
+	JSR BH_ROLL_FREEZE
+	LDA #BH_FIGHT_BOX_W
+	STA z:BH_T0
+	LDA #BH_FIGHT_BOX_H
+	STA z:BH_T1
+	JSR BH_SET_BOX
+	LDA #1
+	STA z:BH_MODE
+	STZ z:BH_FIGHT_STATE
+	STZ z:BH_FIGHT_TIMER
+	STZ z:BH_FRAME
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_CURSOR_X
+	LDA #BH_FIGHT_CURSOR_SPEED
+	STA z:BH_FIGHT_DIR
+	STZ z:BH_FIGHT_TIME
+	LDA #20
+	STA z:BH_DMG_PCT        ; whiffed unless the player presses A
+	LDA #2
+	STA z:BH_FIGHT_RESULT   ; and no SMAAAASH either
+	STA z:BH_FORCE          ; a whiff is a miss
+	LDA #0
+	JSR BH_CALC_YSHIFT
+	JSR BH_UPLOAD_GFX
+	LDA #0
+	JSR BH_UPLOAD_HINT      ; "PRESS A IN THE GREEN"
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	INC z:BH_FRAME
+	LDA z:BH_FIGHT_STATE
+	BNEL @pressed
+	; the reticle sweeps right, bounces back left, and so on until A is pressed
+	; (or the player dithers for BH_FIGHT_TIMEOUT frames and the attack whiffs)
+	INC z:BH_FIGHT_TIME
+	LDA z:BH_FIGHT_TIME
+	CMP #BH_FIGHT_TIMEOUT
+	BCC :+
+	JMP @end
+:
+	LDA z:BH_CURSOR_X
+	CLC
+	ADC z:BH_FIGHT_DIR
+	STA z:BH_CURSOR_X
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #10
+	CMP z:BH_CURSOR_X
+	BCS @not_right
+	STA z:BH_CURSOR_X
+	LDA #.LOWORD(-BH_FIGHT_CURSOR_SPEED)
+	STA z:BH_FIGHT_DIR
+@not_right:
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #8
+	CMP z:BH_CURSOR_X
+	BCC @not_left
+	STA z:BH_CURSOR_X
+	LDA #BH_FIGHT_CURSOR_SPEED
+	STA z:BH_FIGHT_DIR
+@not_left:
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BEQL @loop
+	; pressed: inside the green zone = a guaranteed SMAAAASH at full damage; anything
+	; else can never SMAAAASH and falls off linearly from 100% to 30% at the red ends
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	LDA z:BH_CURSOR_X
+	INC
+	SEC
+	SBC #128
+	JSR BH_ABS
+	STA z:BH_T1             ; distance from the centre
+	; green and yellow always connect; red misses BH_RED_MISS_CHANCE/256 of the time
+	LDX #1
+	CMP #BH_FIGHT_YELLOW + 1
+	BCC @zone_ok
+	JSL RAND
+	CMP #BH_RED_MISS_CHANCE
+	BCS @zone_ok
+	LDX #2
+@zone_ok:
+	STX z:BH_FORCE
+	LDA z:BH_T1
+	CMP #BH_FIGHT_GREEN + 1
+	BCC @perfect
+	SEC
+	SBC #BH_FIGHT_GREEN
+	LDY #35
+	JSL MULT168
+	LDY #32
+	JSL DIVISION16S_DIVISOR_POSITIVE   ; (distance - green) * 70 / 64
+	STA z:BH_T0
+	LDA #100
+	SEC
+	SBC z:BH_T0
+	CMP #30
+	BCS @pct_ok
+	LDA #30
+	BRA @pct_ok
+@perfect:
+	LDA #1
+	STA z:BH_FIGHT_RESULT
+	LDA #100
+@pct_ok:
+	STA z:BH_DMG_PCT
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #24
+	STA z:BH_FIGHT_TIMER
+	LDA #SFX::CURSOR2
+	JSL PLAY_SOUND
+	JMP @loop
+@pressed:
+	DEC z:BH_FIGHT_TIMER
+	BNEL @loop
+@end:
+	STZ z:BH_YSHIFT_TGT
+	JSR BH_BOX_CLOSE
+	STZ z:BH_MODE
+@ramp:
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	LDA z:BH_YSHIFT
+	BNE @ramp
+	JMP BH_ROLL_RESTORE
+
+; ---------------------------------------------------------------------------
+; BH_BOX_OPEN / BH_BOX_CLOSE - grow the box out of its centre / shrink it back
+;   over BH_BOX_ANIM_FRAMES frames. BH_BOX_* must hold the final rectangle on
+;   entry to BH_BOX_OPEN; the heart and bullets are hidden while BH_ANIM != 0.
+; ---------------------------------------------------------------------------
+BH_BOX_OPEN:
+	LDA z:BH_BOX_X0
+	STA z:BH_TBOX_X0
+	LDA z:BH_BOX_Y0
+	STA z:BH_TBOX_Y0
+	LDA z:BH_BOX_X1
+	STA z:BH_TBOX_X1
+	LDA z:BH_BOX_Y1
+	STA z:BH_TBOX_Y1
+	; start from a point at the centre (box and both history entries)
+	LDA z:BH_TBOX_X0
+	CLC
+	ADC z:BH_TBOX_X1
+	LSR
+	STA z:BH_BOX_X0
+	STA z:BH_BOX_X1
+	LDA z:BH_TBOX_Y0
+	CLC
+	ADC z:BH_TBOX_Y1
+	LSR
+	STA z:BH_BOX_Y0
+	STA z:BH_BOX_Y1
+	JSR BH_WINDOW_ON        ; table for the point (masks nothing)
+	JSR BH_WINDOW_ENABLE
+	JSR BH_GAME_WINDOW_OPEN ; the game's own frame, which follows the growing box
+	LDA #1
+	STA z:BH_ANIM
+	STA z:BH_ACTIVE
+@step:
+	JSR BH_GAME_WINDOW_FIT  ; the frame for the current rectangle, and
+	LDA z:BH_ANIM
+	JSR BH_BOX_ANIM_STEP    ; its mask, then the next rectangle
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	INC z:BH_ANIM
+	LDA z:BH_ANIM
+	CMP #BH_BOX_ANIM_FRAMES + 1
+	BCC @step
+	; one more frame so the window table shows the final rectangle
+	JSR BH_GAME_WINDOW_FIT
+	JSR BH_BOX_PIPE
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	STZ z:BH_ANIM
+	RTS
+
+BH_BOX_CLOSE:
+	LDA #BH_BOX_ANIM_FRAMES
+	STA z:BH_ANIM
+@step:
+	DEC z:BH_ANIM
+	BEQ @done
+	JSR BH_GAME_WINDOW_FIT
+	LDA z:BH_ANIM
+	JSR BH_BOX_ANIM_STEP
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	BRA @step
+@done:
+	; show the smallest rectangle, then shrink to a point
+	LDA #1
+	STA z:BH_ANIM
+	JSR BH_GAME_WINDOW_FIT
+	JSR BH_BOX_PIPE
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	LDA z:BH_TBOX_X0
+	CLC
+	ADC z:BH_TBOX_X1
+	LSR
+	STA z:BH_BOX_X0
+	STA z:BH_BOX_X1
+	LDA z:BH_TBOX_Y0
+	CLC
+	ADC z:BH_TBOX_Y1
+	LSR
+	STA z:BH_BOX_Y0
+	STA z:BH_BOX_Y1
+	JSR BH_GAME_WINDOW_FIT
+	JSR BH_BOX_PIPE
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	STZ z:BH_ACTIVE
+	STZ z:BH_ANIM
+	JSR BH_WINDOW_OFF
+	JSR BH_GAME_WINDOW_CLOSE
+	; restore the full rectangle (BH_BOX_* are also used by BH_CALC_YSHIFT)
+	LDA z:BH_TBOX_X0
+	STA z:BH_BOX_X0
+	LDA z:BH_TBOX_Y0
+	STA z:BH_BOX_Y0
+	LDA z:BH_TBOX_X1
+	STA z:BH_BOX_X1
+	LDA z:BH_TBOX_Y1
+	STA z:BH_BOX_Y1
+	RTS
+
+; BH_BOX_PIPE - write the (double-buffered) window table from the current
+;   rectangle. The table takes effect on the next displayed frame, which is
+;   also when the border rendered in the next tick appears, so the table is
+;   written just before the rectangle advances.
+BH_BOX_PIPE:
+	JMP BH_WINDOW_ON
+
+; A = k (1..BH_BOX_ANIM_FRAMES): BH_BOX_* = centre +/- half extents * k / frames
+BH_BOX_ANIM_STEP:
+	STA z:BH_T6
+	JSR BH_BOX_PIPE
+	; x
+	LDA z:BH_TBOX_X1
+	SEC
+	SBC z:BH_TBOX_X0
+	LSR
+	LDY z:BH_T6
+	JSL MULT168
+	LSR
+	LSR
+	LSR                     ; half width * k / 8
+	STA z:BH_T0
+	LDA z:BH_TBOX_X0
+	CLC
+	ADC z:BH_TBOX_X1
+	LSR                     ; centre x
+	SEC
+	SBC z:BH_T0
+	STA z:BH_BOX_X0
+	CLC
+	ADC z:BH_T0
+	CLC
+	ADC z:BH_T0
+	STA z:BH_BOX_X1
+	; y
+	LDA z:BH_TBOX_Y1
+	SEC
+	SBC z:BH_TBOX_Y0
+	LSR
+	LDY z:BH_T6
+	JSL MULT168
+	LSR
+	LSR
+	LSR
+	STA z:BH_T0
+	LDA z:BH_TBOX_Y0
+	CLC
+	ADC z:BH_TBOX_Y1
+	LSR
+	SEC
+	SBC z:BH_T0
+	STA z:BH_BOX_Y0
+	CLC
+	ADC z:BH_T0
+	CLC
+	ADC z:BH_T0
+	STA z:BH_BOX_Y1
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_CALC_YSHIFT - A = 0: raise the enemies just above the box
+;                  A = 1: raise them off the top of the screen (dodge phases use
+;                         the whole area between the text and the HP windows)
+; ---------------------------------------------------------------------------
+BH_CALC_YSHIFT:
+	STA z:BH_T1
+	STZ z:BH_T0             ; max baseline
+	LDX #.LOWORD(BATTLERS_TABLE) + (FIRST_ENEMY_INDEX) * .SIZEOF(battler) ; FIRST_ENEMY_INDEX is a textual define
+@scan:
+	LDA a:battler::consciousness,X
+	AND #$00FF
+	BEQ @next
+	LDA a:battler::ally_or_enemy,X
+	AND #$00FF
+	CMP #1
+	BNE @next
+	LDA a:battler::sprite,X
+	BEQ @next
+	LDA a:battler::sprite_y,X
+	AND #$00FF
+	CMP z:BH_T0
+	BCC @next
+	STA z:BH_T0
+@next:
+	TXA
+	CLC
+	ADC #.SIZEOF(battler)
+	TAX
+	CPX #.LOWORD(BATTLERS_TABLE) + (BATTLER_COUNT) * .SIZEOF(battler)
+	BCC @scan
+	LDA z:BH_T0
+	BEQ @none
+	LDX z:BH_T1
+	BNE @hide
+	CLC
+	ADC #4
+	SEC
+	SBC z:BH_BOX_Y0
+	BCC @none               ; already above the box
+	CMP #80
+	BCC @store
+	LDA #80
+	BRA @store
+@hide:
+	CLC
+	ADC #BH_HIDE_MARGIN     ; baseline ends up above y = -32, where sprites are culled
+@store:
+	STA z:BH_YSHIFT_TGT
+	RTS
+@none:
+	STZ z:BH_YSHIFT_TGT
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_RAMP_SHIFT - move BH_YSHIFT towards BH_YSHIFT_TGT by 4 px per frame
+; ---------------------------------------------------------------------------
+BH_RAMP_SHIFT:
+	LDA z:BH_YSHIFT
+	CMP z:BH_YSHIFT_TGT
+	BEQ @done
+	BCC @up
+	; moving down: snap when within a step
+	LDA z:BH_YSHIFT_TGT
+	CLC
+	ADC #BH_RISE_STEP
+	CMP z:BH_YSHIFT
+	BCS @snap
+	LDA z:BH_YSHIFT
+	SEC
+	SBC #BH_RISE_STEP
+	STA z:BH_YSHIFT
+	RTS
+@up:
+	CLC
+	ADC #BH_RISE_STEP
+	CMP z:BH_YSHIFT_TGT
+	BCS @snap
+	STA z:BH_YSHIFT
+	RTS
+@snap:
+	LDA z:BH_YSHIFT_TGT
+	STA z:BH_YSHIFT
+@done:
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_UPLOAD_GFX - (phase start) re-upload the tiles only if the enemy sprite
+;                 slots changed since battle start; always refresh the palette
+; ---------------------------------------------------------------------------
+BH_UPLOAD_GFX:
+	LDA CURRENT_BATTLE_SPRITEMAPS_ALLOCATED
+	CMP z:BH_GFX_SLOT
+	BEQ @tiles_ok
+	JSR BH_UPLOAD_TILES
+@tiles_ok:
+	JMP BH_UPLOAD_PALETTE
+
+; ---------------------------------------------------------------------------
+; BH_UPLOAD_TILES - copy the base pieces (heart, lines, gauge, bones) into the
+;                   first unused enemy sprite VRAM slots, then each present
+;                   enemy's own bullet sheet after them
+; ---------------------------------------------------------------------------
+BH_UPLOAD_TILES:
+	; the prayer phase (group 478) keeps its BG2 tiles at VRAM $3000-$7FFF, on top of
+	; OBJ tiles $100 and up: only the first 16 sprite slots are ours to use there
+	LDA #32
+	STA z:BH_SLOT_LIMIT
+	LDA CURRENT_BATTLE_GROUP
+	CMP #ENEMY_GROUP::BOSS_GIYGAS_PHASE_DURING_PRAYER_1
+	BNE :+
+	LDA #16
+	STA z:BH_SLOT_LIMIT
+:	LDA CURRENT_BATTLE_SPRITEMAPS_ALLOCATED
+	STA z:BH_GFX_SLOT
+	STA z:BH_T6             ; first slot for our pieces: right after the enemy sprites
+	STZ z:BH_T7             ; piece*2
+@piece:
+	LDA z:BH_T7
+	LSR
+	CLC
+	ADC z:BH_T6
+	CMP z:BH_SLOT_LIMIT
+	BCS @no_room            ; sprite-heavy battle: this piece is not available
+	TAX                     ; slot
+	LDA z:BH_T7
+	XBA
+	AND #$FF00              ; piece*512
+	CLC
+	ADC #.LOWORD(BH_TILES)
+	STA z:BH_T4
+	LDA #^BH_TILES
+	STA z:BH_T5
+	JSR BH_UPLOAD_PIECE_FROM
+	BRA @store
+@no_room:
+	LDA #$FFFF
+@store:
+	LDX z:BH_T7
+	STA z:BH_PIECE_TILE,X
+	INX
+	INX
+	STX z:BH_T7
+	CPX #BH_NUM_PIECES * 2
+	BCC @piece
+	JMP BH_UPLOAD_SHEETS
+
+; A = first piece slot for our tiles (enemy slots first)
+BH_BASE_SLOT:
+	LDA z:BH_GFX_SLOT
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_UPLOAD_SHEETS - the bullet sheet of every enemy kind in this battle
+;                    (up to four), into the slots after the base pieces
+; ---------------------------------------------------------------------------
+BH_UPLOAD_SHEETS:
+	LDA #$FFFF
+	STA z:BH_SHEET_ID
+	STA z:BH_SHEET_ID + 2
+	STA z:BH_SHEET_ID + 4
+	STA z:BH_SHEET_ID + 6
+	JSR BH_BASE_SLOT
+	CLC
+	ADC #BH_NUM_PIECES
+	STA z:BH_T6             ; next free slot
+	STZ z:BH_T7             ; index into the enemy id list (bytes)
+@each:
+	LDA z:BH_T7
+	LSR
+	CMP ENEMIES_IN_BATTLE
+	BCS @done
+	LDA z:BH_T6
+	CMP z:BH_SLOT_LIMIT
+	BCS @done               ; no sprite VRAM left: those enemies use the base bullets
+	LDX z:BH_T7
+	LDA ENEMIES_IN_BATTLE_IDS,X
+	STA z:BH_T3
+	LDX #0
+@check:
+	CMP z:BH_SHEET_ID,X     ; already uploaded for an earlier enemy of the same kind?
+	BEQ @next
+	INX
+	INX
+	CPX #8
+	BCC @check
+	LDX z:BH_T7
+	LDA z:BH_T3
+	STA z:BH_SHEET_ID,X
+	; source: sheet (id & 127) * 512 in bank A (ids 0-127) or bank B (128-230)
+	LDA z:BH_T3
+	AND #$007F
+	XBA
+	ASL                     ; * 512
+	STA z:BH_T4
+	LDA z:BH_T3
+	AND #$0080
+	BNE @bank_b
+	LDA z:BH_T4
+	CLC
+	ADC #.LOWORD(BH_ENEMY_SHEETS_A)
+	STA z:BH_T4
+	LDA #^BH_ENEMY_SHEETS_A
+	BRA @have_src
+@bank_b:
+	LDA z:BH_T4
+	CLC
+	ADC #.LOWORD(BH_ENEMY_SHEETS_B)
+	STA z:BH_T4
+	LDA #^BH_ENEMY_SHEETS_B
+@have_src:
+	STA z:BH_T5
+	LDX z:BH_T6
+	JSR BH_UPLOAD_PIECE_FROM
+	LDX z:BH_T7
+	STA z:BH_SHEET_TILE,X
+	INC z:BH_T6
+@next:
+	INC z:BH_T7
+	INC z:BH_T7
+	LDA z:BH_T7
+	CMP #8
+	BCC @each
+@done:
+	LDA z:BH_T6
+	STA z:BH_SHEET_END      ; the instruction lines go right after the sheets
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_UPLOAD_PIECE_FROM - BH_T4/BH_T5 = 24-bit source of a 512-byte piece,
+;   X = piece slot -> 4 DMAs into the slot's tile rows; returns A = tile number
+; ---------------------------------------------------------------------------
+BH_UPLOAD_PIECE_FROM:
+	TXA
+	ASL
+	TAX
+	LDA f:UNKNOWN_C3F8B1,X  ; tile number of that piece slot
+	STA z:BH_T2
+	STZ z:BH_T3             ; tile row 0..3
+@row:
+	LDA z:BH_T3
+	XBA
+	LSR                     ; row*128
+	CLC
+	ADC z:BH_T4
+	STA z:$0E
+	LDA z:BH_T5
+	STA z:$10
+	; destination = $2000 + (tile + row*16) * 16 words
+	LDA z:BH_T3
+	XBA                     ; row*256
+	STA z:BH_T0
+	LDA z:BH_T2
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC z:BH_T0
+	CLC
+	ADC #$2000
+	TAY
+	LDX #128
+	LDA #0
+	SEP #PROC_FLAGS::ACCUM8
+	JSL PREPARE_VRAM_COPY
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	INC z:BH_T3
+	LDA z:BH_T3
+	CMP #4
+	BCC @row
+	LDA z:BH_T2
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_UPLOAD_PALETTE - our 16 colours into OBJ palette 7
+; ---------------------------------------------------------------------------
+BH_UPLOAD_PALETTE:
+	LDX #0
+@pal:
+	LDA f:BH_PALETTE,X
+	STA PALETTES + BH_OBJ_PALETTE,X
+	INX
+	INX
+	CPX #32
+	BCC @pal
+	LDA #$10                ; upload the OBJ palettes during the next NMI
+	JSL UNKNOWN_C0856B
+	RTS
+
+; ===========================================================================
+; BH_UPDATE - one frame of game logic
+; ===========================================================================
+BH_UPDATE:
+	INC z:BH_FRAME
+	JSR BH_RAMP_SHIFT
+	JSR BH_INPUT
+	LDA z:BH_IFRAMES
+	BEQ @noif
+	DEC z:BH_IFRAMES
+@noif:
+	JSR BH_PATTERN_STEP
+	JSR BH_BULLETS_STEP
+	LDA z:BH_TIMER
+	BEQ @notimer
+	DEC z:BH_TIMER
+@notimer:
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_INPUT - move the heart with the d-pad; hold B or X to move slowly
+; ---------------------------------------------------------------------------
+BH_INPUT:
+	LDA PAD_STATE
+	STA z:BH_T0
+	LDA #2
+	STA z:BH_HEART_SPD
+	LDA z:BH_T0
+	AND #PAD::B_BUTTON | PAD::X_BUTTON
+	BEQ @fast
+	LDA #1
+	STA z:BH_HEART_SPD
+@fast:
+	LDA z:BH_T0
+	AND #PAD::LEFT
+	BEQ @noleft
+	LDA z:BH_HEART_X
+	SEC
+	SBC z:BH_HEART_SPD
+	STA z:BH_HEART_X
+@noleft:
+	LDA z:BH_T0
+	AND #PAD::RIGHT
+	BEQ @noright
+	LDA z:BH_HEART_X
+	CLC
+	ADC z:BH_HEART_SPD
+	STA z:BH_HEART_X
+@noright:
+	LDA z:BH_T0
+	AND #PAD::UP
+	BEQ @noup
+	LDA z:BH_HEART_Y
+	SEC
+	SBC z:BH_HEART_SPD
+	STA z:BH_HEART_Y
+@noup:
+	LDA z:BH_T0
+	AND #PAD::DOWN
+	BEQ @nodown
+	LDA z:BH_HEART_Y
+	CLC
+	ADC z:BH_HEART_SPD
+	STA z:BH_HEART_Y
+@nodown:
+	STZ z:BH_MOVED
+	LDA z:BH_T0
+	AND #PAD::UP | PAD::DOWN | PAD::LEFT | PAD::RIGHT
+	BEQ @still
+	LDA #1
+	STA z:BH_MOVED
+@still:
+	; keep the heart inside the window frame (the art occupies columns 2-13,
+	; rows 2-12; the frame tiles cover 8 px on each side, see BH_FRAME_*)
+	LDA z:BH_BOX_X0
+	CLC
+	ADC #BH_FRAME_LEFT - 2
+	CMP z:BH_HEART_X
+	BCS @xmin_ok            ; the limit is at or right of the heart: use it
+	LDA z:BH_HEART_X
+@xmin_ok:
+	STA z:BH_T1
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #BH_FRAME_RIGHT + 14
+	CMP z:BH_T1
+	BCS @xmax_ok
+	STA z:BH_T1
+@xmax_ok:
+	LDA z:BH_T1
+	STA z:BH_HEART_X
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP - 2
+	CMP z:BH_HEART_Y
+	BCS @ymin_ok
+	LDA z:BH_HEART_Y
+@ymin_ok:
+	STA z:BH_T1
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #BH_FRAME_BOTTOM + 13
+	CMP z:BH_T1
+	BCS @ymax_ok
+	STA z:BH_T1
+@ymax_ok:
+	LDA z:BH_T1
+	STA z:BH_HEART_Y
+	RTS
+
+; ===========================================================================
+; Pattern interpreter
+; ===========================================================================
+BH_PATTERN_STEP:
+	LDA z:BH_PAT_WAIT
+	CMP #$FFFF
+	BEQ @ret
+	CMP #0
+	BEQ BH_PAT_EXEC
+	DEC z:BH_PAT_WAIT
+@ret:
+	RTS
+BH_PAT_EXEC:
+	LDY #0
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	CMP #BH_OP_DROP + 1
+	BCS @bad
+	ASL
+	TAX
+	JMP (.LOWORD(BH_OP_TABLE),X)
+@bad:
+	LDA #$FFFF
+	STA z:BH_PAT_WAIT
+	RTS
+
+BH_OP_TABLE:
+	.WORD .LOWORD(BH_OPC_END)
+	.WORD .LOWORD(BH_OPC_WAIT)
+	.WORD .LOWORD(BH_OPC_SPAWN)
+	.WORD .LOWORD(BH_OPC_LOOP)
+	.WORD .LOWORD(BH_OPC_ENDLOOP)
+	.WORD .LOWORD(BH_OPC_AIMED)
+	.WORD .LOWORD(BH_OPC_RAIN)
+	.WORD .LOWORD(BH_OPC_SIDE)
+	.WORD .LOWORD(BH_OPC_RWAIT)
+	.WORD .LOWORD(BH_OPC_WALL)
+	.WORD .LOWORD(BH_OPC_RISE)
+	.WORD .LOWORD(BH_OPC_RING)
+	.WORD .LOWORD(BH_OPC_WAVE)
+	.WORD .LOWORD(BH_OPC_SEEK)
+	.WORD .LOWORD(BH_OPC_DROP)
+
+; advance the pattern pointer by A bytes and continue executing
+BH_PAT_ADVANCE:
+	CLC
+	ADC z:BH_PAT_PTR
+	STA z:BH_PAT_PTR
+	STZ z:BH_SPAWN_MODE
+	JMP BH_PAT_EXEC
+
+; WAVE / SEEK / DROP: SIDE / AIMED / RAIN with a motion mode for their bullets
+BH_OPC_WAVE:
+	LDA #BH_MODE_WAVE
+	STA z:BH_SPAWN_MODE
+	JMP BH_OPC_SIDE
+BH_OPC_SEEK:
+	LDA #BH_MODE_SEEK
+	STA z:BH_SPAWN_MODE
+	JMP BH_OPC_AIMED
+BH_OPC_DROP:
+	LDA #BH_MODE_GRAVITY
+	STA z:BH_SPAWN_MODE
+	JMP BH_OPC_RAIN
+
+BH_OPC_END:
+	LDA #$FFFF
+	STA z:BH_PAT_WAIT
+	RTS
+
+BH_OPC_WAIT:
+	LDY #1
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_WAIT
+	STA z:BH_PAT_WAIT
+	LDA z:BH_PAT_PTR
+	CLC
+	ADC #2
+	STA z:BH_PAT_PTR
+	RTS
+
+BH_OPC_RWAIT:
+	LDY #1
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	STA z:BH_T0             ; min
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	SEC
+	SBC z:BH_T0
+	INC                     ; range = max - min + 1
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_T0
+	JSR BH_SCALE_WAIT
+	STA z:BH_PAT_WAIT
+	LDA z:BH_PAT_PTR
+	CLC
+	ADC #3
+	STA z:BH_PAT_PTR
+	RTS
+
+BH_OPC_LOOP:
+	LDY #1
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	STA z:BH_LOOP_CNT
+	LDA z:BH_PAT_PTR
+	CLC
+	ADC #2
+	STA z:BH_PAT_PTR
+	STA z:BH_LOOP_PC
+	JMP BH_PAT_EXEC
+
+BH_OPC_ENDLOOP:
+	DEC z:BH_LOOP_CNT
+	BEQ @exit
+	LDA z:BH_LOOP_PC
+	STA z:BH_PAT_PTR
+	JMP BH_PAT_EXEC
+@exit:
+	LDA #1
+	JMP BH_PAT_ADVANCE
+
+; SPAWN type, x, y, vx, vy
+BH_OPC_SPAWN:
+	JSR BH_ALLOC_BULLET
+	BCS @full
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	JSR BH_SIGN_EXTEND
+	CLC
+	ADC z:BH_BOX_X0
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDY #3
+	LDA [BH_PAT_PTR],Y
+	JSR BH_SIGN_EXTEND
+	CLC
+	ADC z:BH_BOX_Y0
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	LDY #4
+	LDA [BH_PAT_PTR],Y
+	STA BH_BULLETS + BHB_VX,X
+	LDY #6
+	LDA [BH_PAT_PTR],Y
+	STA BH_BULLETS + BHB_VY,X
+@full:
+	LDA #8
+	JMP BH_PAT_ADVANCE
+
+; RAIN type, speed - one bullet falling from above the box at a random x
+BH_OPC_RAIN:
+	JSR BH_ALLOC_BULLET
+	BCS @full
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	SEC
+	SBC #12
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_BOX_X0
+	SEC
+	SBC #2
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_BOX_Y0
+	SEC
+	SBC #28
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	STZ BH_BULLETS + BHB_VX,X
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	STA BH_BULLETS + BHB_VY,X
+@full:
+	LDA #3
+	JMP BH_PAT_ADVANCE
+
+; RISE type, speed - one bullet rising from below the box at a random x
+BH_OPC_RISE:
+	JSR BH_ALLOC_BULLET
+	BCS @full
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	SEC
+	SBC #12
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_BOX_X0
+	SEC
+	SBC #2
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_BOX_Y1
+	CLC
+	ADC #12
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	STZ BH_BULLETS + BHB_VX,X
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	EOR #$FFFF
+	INC
+	STA BH_BULLETS + BHB_VY,X
+@full:
+	LDA #3
+	JMP BH_PAT_ADVANCE
+
+; RING type, count, speed - `count` bullets on a circle around the heart,
+; all moving through the spot the heart occupied when the ring appeared
+BH_OPC_RING:
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	BEQL @full
+	STA z:BH_T5             ; bullets left
+	TAY
+	LDA #256
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	STA z:BH_T6             ; angle step
+	JSL RAND
+	STA z:BH_T7             ; angle (0-255)
+	LDY #3
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	CMP #35
+	BCC :+
+	LDA #34                 ; a ring needs at least ~30 frames to close on the heart
+:	STA z:BH_T4             ; speed
+@each:
+	; rings of four or more always leave a two-slot opening (at a random angle),
+	; otherwise a ring closing on a still heart cannot be escaped at all
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	CMP #4
+	BCC @spawn
+	DEC
+	DEC
+	CMP z:BH_T5
+	BCC @next
+@spawn:
+	JSR BH_ALLOC_BULLET
+	BCS @next
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	STX z:BH_T3
+	; cos and sin of the angle (signed, -127..127)
+	LDA z:BH_T7
+	CLC
+	ADC #64
+	AND #$00FF
+	TAX
+	LDA f:SINE_LOOKUP_TABLE,X
+	JSR BH_SIGN_EXTEND
+	STA z:BH_T0             ; cos
+	LDX z:BH_T7
+	LDA f:SINE_LOOKUP_TABLE,X
+	JSR BH_SIGN_EXTEND
+	STA z:BH_T1             ; sin
+	LDX z:BH_T3
+	; position: heart + 64 px along (cos, sin)  (cos/2 since cos is scaled by 128)
+	LDA z:BH_T0
+	CMP #$8000
+	ROR
+	CLC
+	ADC z:BH_HEART_X
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_T1
+	CMP #$8000
+	ROR
+	CLC
+	ADC z:BH_HEART_Y
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	; velocity: back towards the heart at `speed`
+	LDA z:BH_T0
+	JSR BH_RING_VEL
+	STA BH_BULLETS + BHB_VX,X
+	LDA z:BH_T1
+	JSR BH_RING_VEL
+	STA BH_BULLETS + BHB_VY,X
+@next:
+	LDA z:BH_T7
+	CLC
+	ADC z:BH_T6
+	AND #$00FF
+	STA z:BH_T7
+	DEC z:BH_T5
+	BEQ @full
+	JMP @each
+@full:
+	LDA #4
+	JMP BH_PAT_ADVANCE
+
+; A = trig value (-127..127) -> A = -(trig * speed / 128) (X preserved)
+BH_RING_VEL:
+	PHX
+	STA z:BH_T2
+	JSR BH_ABS
+	LDY z:BH_T4
+	JSL MULT168
+	LSR
+	LSR
+	LSR
+	LSR
+	LSR
+	LSR
+	LSR
+	LDX z:BH_T2
+	BMI @keep               ; negative trig: moving back means positive velocity
+	EOR #$FFFF
+	INC
+@keep:
+	PLX
+	RTS
+
+; SIDE type, speed - one bullet from a random side, level with the heart
+BH_OPC_SIDE:
+	JSR BH_ALLOC_BULLET
+	BCS @full
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	STA z:BH_T3             ; speed
+	; y = heart y + random(-8..8)
+	LDA #17
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_HEART_Y
+	SEC
+	SBC #8
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	STZ BH_BULLETS + BHB_VY,X
+	LDA #2
+	JSR BH_RAND_MAX
+	BNE @right
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #28
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_T3
+	STA BH_BULLETS + BHB_VX,X
+	BRA @full
+@right:
+	LDA z:BH_BOX_X1
+	CLC
+	ADC #12
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_T3
+	EOR #$FFFF
+	INC
+	STA BH_BULLETS + BHB_VX,X
+@full:
+	LDA #3
+	JMP BH_PAT_ADVANCE
+
+; AIMED type, edge, speed - one bullet from an edge, aimed at the heart
+BH_OPC_AIMED:
+	JSR BH_ALLOC_BULLET
+	BCC :+
+	JMP @full
+:
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	CMP #BH_EDGE_ANY
+	BCC @have_edge
+	LDA #4
+	JSR BH_RAND_MAX
+@have_edge:
+	STA z:BH_T4
+	; spawn position -> BH_T0 (x), BH_T1 (y), screen pixels of sprite top-left
+	CMP #BH_EDGE_TOP
+	BNE @not_top
+	LDA z:BH_BOX_Y0
+	SEC
+	SBC #28
+	STA z:BH_T1
+	JSR BH_RAND_X_ALONG_BOX
+	BRA @have_pos
+@not_top:
+	CMP #BH_EDGE_BOTTOM
+	BNE @not_bottom
+	LDA z:BH_BOX_Y1
+	CLC
+	ADC #12
+	STA z:BH_T1
+	JSR BH_RAND_X_ALONG_BOX
+	BRA @have_pos
+@not_bottom:
+	CMP #BH_EDGE_LEFT
+	BNE @right
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #28
+	STA z:BH_T0
+	JSR BH_RAND_Y_ALONG_BOX
+	BRA @have_pos
+@right:
+	LDA z:BH_BOX_X1
+	CLC
+	ADC #12
+	STA z:BH_T0
+	JSR BH_RAND_Y_ALONG_BOX
+@have_pos:
+	LDA z:BH_T0
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_T1
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	; velocity towards the heart
+	LDY #3
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	STA z:BH_T3
+	JSR BH_AIM_AT_HEART     ; uses BH_T0/T1/T3, writes VX/VY of bullet X
+@full:
+	LDA #4
+	JMP BH_PAT_ADVANCE
+
+; WALL type, gap, speed - a row of bullets across the box width falling down,
+; with a gap of `gap` pixels at a random position
+BH_OPC_WALL:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	STA z:BH_T5             ; width
+	LDY #2
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	STA z:BH_T6             ; gap
+	LDA z:BH_T5
+	SEC
+	SBC z:BH_T6
+	JSR BH_RAND_MAX
+	STA z:BH_T7             ; gap start (relative)
+	LDA #0
+	STA z:BH_T4             ; x cursor (relative)
+@col:
+	; skip columns inside the gap
+	LDA z:BH_T4
+	CMP z:BH_T7
+	BCC @place
+	SEC
+	SBC z:BH_T7
+	CMP z:BH_T6
+	BCC @skip
+@place:
+	JSR BH_ALLOC_BULLET
+	BCS @skip
+	LDY #1
+	JSR BH_READ_TYPE
+	JSR BH_SET_TYPE
+	LDA z:BH_T4
+	CLC
+	ADC z:BH_BOX_X0
+	SEC
+	SBC #4
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_X,X
+	LDA z:BH_BOX_Y0
+	SEC
+	SBC #28
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHB_Y,X
+	STZ BH_BULLETS + BHB_VX,X
+	LDY #3
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	JSR BH_SCALE_SPEED
+	STA BH_BULLETS + BHB_VY,X
+@skip:
+	LDA z:BH_T4
+	CLC
+	ADC #24
+	LDY z:BH_THEME_BIG
+	BEQ :+
+	CLC
+	ADC #16                 ; 40 px apart for 32x32 bullets
+:	STA z:BH_T4
+	CMP z:BH_T5
+	BCC @col
+	LDA #4
+	JMP BH_PAT_ADVANCE
+
+; ---------------------------------------------------------------------------
+; helpers for the opcodes
+; ---------------------------------------------------------------------------
+
+; Y = offset of a type byte in the current opcode -> A = bullet type, with
+; BH_TYPE_ENEMY/ENEMY2 replaced by the enemy record's types and the enemy's own
+; sprites replaced by base sprites when its sheet is not in VRAM (X preserved)
+BH_READ_TYPE:
+	LDA [BH_PAT_PTR],Y
+	AND #$00FF
+	CMP #BH_TYPE_ENEMY
+	BNE :+
+	LDA z:BH_ENEMY_TYPE
+:	CMP #BH_TYPE_ENEMY2
+	BNE :+
+	LDA z:BH_ENEMY_TYPE2
+:	CMP #BH_TYPE_THEME0
+	BCC @done
+	CMP #BH_TYPE_THEME3 + 1
+	BCS @done
+	LDY z:BH_THEME_TILE
+	CPY #$FFFF
+	BNE @done
+	CMP #BH_TYPE_THEME1
+	BEQ @flame
+	CMP #BH_TYPE_THEME2
+	BEQ @dot
+	LDA #BH_TYPE_ROUND
+	RTS
+@flame:
+	LDA #BH_TYPE_FLAME
+	RTS
+@dot:
+	LDA #BH_TYPE_DOT
+@done:
+	RTS
+
+; A = wait in frames -> scaled by the enemy's tempo (16 = 1.0), at least 1
+BH_SCALE_WAIT:
+	LDY z:BH_TEMPO
+	BEQ @asis
+	CPY #16
+	BEQ @asis
+	JSL MULT168
+	LSR
+	LSR
+	LSR
+	LSR
+	BNE @asis
+	LDA #1
+@asis:
+	RTS
+
+; random x along the box top/bottom -> BH_T0
+BH_RAND_X_ALONG_BOX:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_BOX_X0
+	SEC
+	SBC #8
+	STA z:BH_T0
+	RTS
+
+; random y along the box sides -> BH_T1
+BH_RAND_Y_ALONG_BOX:
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	JSR BH_RAND_MAX
+	CLC
+	ADC z:BH_BOX_Y0
+	SEC
+	SBC #8
+	STA z:BH_T1
+	RTS
+
+; A = n (1..255) -> A = random number in 0..n-1 (X preserved)
+BH_RAND_MAX:
+	PHX
+	STA z:BH_T2
+	JSL RAND                ; 0..255
+	TAY
+	LDA z:BH_T2
+	JSL MULT168             ; n * r
+	XBA
+	AND #$00FF
+	PLX
+	RTS
+
+; A = 8-bit signed value -> A = 16-bit sign extended
+BH_SIGN_EXTEND:
+	AND #$00FF
+	CMP #$0080
+	BCC @pos
+	ORA #$FF00
+@pos:
+	RTS
+
+; A = speed (1/16 px) -> scaled by BH_SPEED/16 (X preserved)
+BH_SCALE_SPEED:
+	PHX
+	LDY z:BH_SPEED
+	JSL MULT168
+	LSR
+	LSR
+	LSR
+	LSR
+	BNE @nonzero
+	LDA #1
+@nonzero:
+	CMP #41
+	BCC @ok
+	LDA #40                 ; 2.5 px/frame at most: a bullet from the near edge takes 16+ frames
+@ok:
+	PLX
+	RTS
+
+; find a free bullet slot -> X = offset, carry clear; carry set when full
+BH_ALLOC_BULLET:
+	LDX #0
+@scan:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @found
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @scan
+	SEC
+	RTS
+@found:
+	STZ BH_BULLETS + BHB_TYPE,X    ; clears type + life
+	LDA z:BH_SPAWN_MODE
+	XBA
+	AND #$FF00
+	STA BH_BULLETS + BHB_ATTR,X    ; attribute bits 0, motion mode from the opcode
+	CMP #BH_MODE_WAVE << 8
+	BNE :+
+	TXA
+	ASL
+	ASL
+	ASL
+	AND #$00FF
+	XBA
+	AND #$FF00
+	ORA BH_BULLETS + BHB_TYPE,X
+	STA BH_BULLETS + BHB_TYPE,X    ; wave phase (the life byte) differs per slot
+:	CLC
+	RTS
+
+; BH_SET_TYPE - A = bullet type, X = slot: store the type and resolve its tile,
+;   attribute and hit box once, so the per-frame loops never touch the tables.
+;   Preserves BH_T2..BH_T5 (the WALL opcode keeps its cursor in them).
+BH_SET_TYPE:
+	SEP #PROC_FLAGS::ACCUM8
+	STA BH_BULLETS + BHB_TYPE,X
+	REP #PROC_FLAGS::ACCUM8
+	AND #$00FF
+	PHA
+	LDA z:BH_T2
+	PHA
+	LDA z:BH_T3
+	PHA
+	LDA z:BH_T4
+	PHA
+	LDA z:BH_T5
+	PHA
+	LDA 9,S                 ; the type
+	JSR BH_TILE_FOR_TYPE    ; -> BH_T2 tile, BH_T4 attribute
+	LDA z:BH_T2
+	STA BH_BULLETS + BHB_TILE,X
+	SEP #PROC_FLAGS::ACCUM8
+	LDA z:BH_T4
+	STA BH_BULLETS + BHB_ATTR,X    ; byte store keeps the motion mode
+	REP #PROC_FLAGS::ACCUM8
+	LDA 9,S
+	CMP #BH_TYPE_THEME0
+	BCC @base
+	CMP #BH_TYPE_THEME3 + 1
+	BCS @base
+	SEC
+	SBC #BH_TYPE_THEME0
+	ASL
+	PHX
+	TAX
+	LDA z:BH_THEME_HB,X     ; (half width, half height) of the enemy's own sprite
+	PLX
+	BIT #$0080
+	BEQ @store
+	; one 32x32 sprite for the whole sheet: tile = sheet base, odd types are mirrored
+	AND #$FF7F
+	PHA
+	LDA z:BH_THEME_TILE
+	STA BH_BULLETS + BHB_TILE,X
+	SEP #PROC_FLAGS::ACCUM8
+	LDA BH_BULLETS + BHB_MODE,X
+	ORA #BH_MODE_BIG
+	STA BH_BULLETS + BHB_MODE,X
+	LDA 11,S                ; the type (pushed value moved the offsets by two)
+	AND #$01
+	BEQ :+
+	LDA BH_BULLETS + BHB_ATTR,X
+	ORA #$40                ; horizontal flip
+	STA BH_BULLETS + BHB_ATTR,X
+:	REP #PROC_FLAGS::ACCUM8
+	PLA
+	BRA @store
+@base:
+	DEC
+	STA z:BH_T2
+	ASL
+	CLC
+	ADC z:BH_T2
+	ASL                     ; type index * 6
+	PHX
+	TAX
+	LDA f:BH_TYPE_TABLE + 3,X
+	PLX
+@store:
+	STA BH_BULLETS + BHB_HW,X      ; writes half width and half height
+	PLA
+	STA z:BH_T5
+	PLA
+	STA z:BH_T4
+	PLA
+	STA z:BH_T3
+	PLA
+	STA z:BH_T2
+	PLA
+	RTS
+
+; Aim bullet X (at screen position BH_T0/BH_T1) at the heart with speed BH_T3.
+; The velocity magnitude uses the octagonal length approximation
+; len = max(|dx|,|dy|) + min(|dx|,|dy|)/2.
+BH_AIM_AT_HEART:
+	STX z:BH_T6
+	; dx = heart centre - bullet centre
+	LDA z:BH_HEART_X
+	SEC
+	SBC z:BH_T0
+	STA z:BH_T4             ; dx (signed)
+	LDA z:BH_HEART_Y
+	SEC
+	SBC z:BH_T1
+	STA z:BH_T5             ; dy (signed)
+	; |dx|, |dy| -> T0, T1
+	LDA z:BH_T4
+	JSR BH_ABS
+	STA z:BH_T0
+	LDA z:BH_T5
+	JSR BH_ABS
+	STA z:BH_T1
+	; len
+	CMP z:BH_T0
+	BCC @dx_bigger
+	LSR                     ; dy bigger: len = dy + dx/2
+	LDA z:BH_T0
+	LSR
+	CLC
+	ADC z:BH_T1
+	BRA @have_len
+@dx_bigger:
+	LDA z:BH_T1
+	LSR
+	CLC
+	ADC z:BH_T0
+@have_len:
+	BNE @len_ok
+	INC
+@len_ok:
+	STA z:BH_T7             ; len (>= 1)
+	; vx = |dx| * speed / len, with dx's sign
+	LDA z:BH_T0
+	LDY z:BH_T3
+	JSL MULT168
+	LDY z:BH_T7
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	LDX z:BH_T4
+	BPL @vx_pos
+	EOR #$FFFF
+	INC
+@vx_pos:
+	LDX z:BH_T6
+	STA BH_BULLETS + BHB_VX,X
+	; vy
+	LDA z:BH_T1
+	LDY z:BH_T3
+	JSL MULT168
+	LDY z:BH_T7
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	LDX z:BH_T5
+	BPL @vy_pos
+	EOR #$FFFF
+	INC
+@vy_pos:
+	LDX z:BH_T6
+	STA BH_BULLETS + BHB_VY,X
+	RTS
+
+BH_ABS:
+	BPL @pos
+	EOR #$FFFF
+	INC
+@pos:
+	RTS
+
+; ===========================================================================
+; Bullets: movement, expiry, collision with the heart
+; ===========================================================================
+BH_BULLETS_STEP:
+	LDX #0
+@bullet:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQL @next
+	; move
+	LDA BH_BULLETS + BHB_X,X
+	CLC
+	ADC BH_BULLETS + BHB_VX,X
+	STA BH_BULLETS + BHB_X,X
+	LDA BH_BULLETS + BHB_Y,X
+	CLC
+	ADC BH_BULLETS + BHB_VY,X
+	STA BH_BULLETS + BHB_Y,X
+	; special motion
+	LDA BH_BULLETS + BHB_ATTR,X
+	AND #$7F00
+	BEQ @straight
+	JSR BH_BULLET_MOTION
+	LDA BH_BULLETS + BHB_ATTR,X
+	AND #$7F00
+	CMP #BH_MODE_WAVE << 8
+	BEQ @nolife8            ; wave bullets use the life byte as their phase
+@straight:
+	; lifetime
+	SEP #PROC_FLAGS::ACCUM8
+	LDA BH_BULLETS + BHB_LIFE,X
+	BEQ @nolife
+	DEC
+	STA BH_BULLETS + BHB_LIFE,X
+	BNE @nolife
+	REP #PROC_FLAGS::ACCUM8
+	BRA @kill
+@nolife:
+	REP #PROC_FLAGS::ACCUM8
+@nolife8:
+	; off screen?  (x + 32) in 0..320, (y + 40) in 0..280  (pixels)
+	LDA BH_BULLETS + BHB_X,X
+	CLC
+	ADC #32 * 16
+	CMP #(256 + 64) * 16
+	BCS @kill
+	LDA BH_BULLETS + BHB_Y,X
+	CLC
+	ADC #40 * 16
+	CMP #(224 + 56) * 16
+	BCS @kill
+	; collision
+	LDA z:BH_IFRAMES
+	BNE @next
+	JSR BH_COLLIDE_ONE
+	BCC @next
+	; hit: the phase winds down and the attack lands (one hit is all it takes)
+	INC z:BH_HITS
+	LDA #BH_IFRAME_LEN
+	STA z:BH_IFRAMES
+	LDA #BH_HIT_WINDDOWN
+	STA z:BH_TIMER
+	LDA #$FFFF
+	STA z:BH_PAT_WAIT       ; no more spawns
+	PHX
+	LDA #SFX::TOOK_DAMAGE
+	JSL PLAY_SOUND          ; clobbers X
+	PLX
+	BRA @next
+@kill:
+	STZ BH_BULLETS + BHB_TYPE,X
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCCL @bullet
+	RTS
+
+; X = bullet offset with a motion mode: wave / seek / gravity (X preserved)
+BH_BULLET_MOTION:
+	XBA
+	AND #$007F
+	CMP #BH_MODE_WAVE
+	BEQ @wave
+	CMP #BH_MODE_SEEK
+	BEQ @seek
+	; gravity: fall faster every frame, up to 3 px/frame
+	LDA BH_BULLETS + BHB_VY,X
+	CLC
+	ADC #2
+	CMP #48
+	BCC :+
+	LDA #48
+:	STA BH_BULLETS + BHB_VY,X
+	RTS
+@wave:
+	; vy = sin(phase) * 1.4 px/frame, phase advancing 8/256 of a turn per frame
+	STX z:BH_T7
+	SEP #PROC_FLAGS::ACCUM8
+	LDA BH_BULLETS + BHB_LIFE,X
+	CLC
+	ADC #8
+	STA BH_BULLETS + BHB_LIFE,X
+	REP #PROC_FLAGS::ACCUM8
+	AND #$00FF
+	TAX
+	LDA f:SINE_LOOKUP_TABLE,X
+	JSR BH_SIGN_EXTEND
+	STA z:BH_T5
+	ASL
+	CLC
+	ADC z:BH_T5             ; * 3
+	JSR BH_ASR4             ; / 16  -> -23..23 (12.4 units)
+	LDX z:BH_T7
+	STA BH_BULLETS + BHB_VY,X
+	RTS
+@seek:
+	; steer towards the heart's centre, 2/16 px/frame^2, top speed 2 px/frame
+	LDA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	CLC
+	ADC #8
+	CMP z:BH_HEART_X
+	BCC @seek_right
+	BEQ @seek_y
+	LDA BH_BULLETS + BHB_VX,X
+	SEC
+	SBC #2
+	BPL :+
+	CMP #.LOWORD(-32)
+	BCS :+
+	LDA #.LOWORD(-32)
+:	STA BH_BULLETS + BHB_VX,X
+	BRA @seek_y
+@seek_right:
+	LDA BH_BULLETS + BHB_VX,X
+	CLC
+	ADC #2
+	BMI :+
+	CMP #32
+	BCC :+
+	LDA #32
+:	STA BH_BULLETS + BHB_VX,X
+@seek_y:
+	LDA BH_BULLETS + BHB_Y,X
+	JSR BH_ASR4
+	CLC
+	ADC #8
+	CMP z:BH_HEART_Y
+	BCC @seek_down
+	BEQ @seek_done
+	LDA BH_BULLETS + BHB_VY,X
+	SEC
+	SBC #2
+	BPL :+
+	CMP #.LOWORD(-32)
+	BCS :+
+	LDA #.LOWORD(-32)
+:	STA BH_BULLETS + BHB_VY,X
+	RTS
+@seek_down:
+	LDA BH_BULLETS + BHB_VY,X
+	CLC
+	ADC #2
+	BMI :+
+	CMP #32
+	BCC :+
+	LDA #32
+:	STA BH_BULLETS + BHB_VY,X
+@seek_done:
+	RTS
+
+; X = bullet offset -> carry set when its hit box overlaps the heart's
+BH_COLLIDE_ONE:
+	; bullet centre (8 px in for 16x16 bullets, 16 for 32x32 ones)
+	LDA BH_BULLETS + BHB_ATTR,X
+	AND #BH_MODE_BIG << 8
+	BEQ :+
+	LDA #8 * 16
+:	CLC
+	ADC #8 * 16
+	STA z:BH_T2
+	LDA BH_BULLETS + BHB_X,X
+	CLC
+	ADC z:BH_T2
+	LSR
+	LSR
+	LSR
+	LSR
+	STA z:BH_T0
+	LDA BH_BULLETS + BHB_Y,X
+	CLC
+	ADC z:BH_T2
+	LSR
+	LSR
+	LSR
+	LSR
+	STA z:BH_T1
+	; blue bullets only hurt a moving heart, orange ones only a still heart
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	CMP #BH_TYPE_BLUE
+	BNE @not_blue
+	LDA z:BH_MOVED
+	BEQL @miss
+@not_blue:
+	CMP #BH_TYPE_ORANGE
+	BNE @not_orange
+	LDA z:BH_MOVED
+	BNE @miss
+@not_orange:
+	; hit box half sizes (+ heart half size), resolved at spawn
+	LDA BH_BULLETS + BHB_HW,X
+	AND #$00FF
+	CLC
+	ADC #BH_HEART_HALF
+	STA z:BH_T2
+	LDA BH_BULLETS + BHB_HH,X
+	AND #$00FF
+	CLC
+	ADC #BH_HEART_HALF
+	STA z:BH_T3
+	; |heart centre - bullet centre| < half sizes ?
+	LDA z:BH_HEART_X
+	CLC
+	ADC #8
+	SEC
+	SBC z:BH_T0
+	JSR BH_ABS
+	CMP z:BH_T2
+	BCS @miss
+	LDA z:BH_HEART_Y
+	CLC
+	ADC #8
+	SEC
+	SBC z:BH_T1
+	JSR BH_ABS
+	CMP z:BH_T3
+	BCS @miss
+	SEC
+	RTS
+@miss:
+	CLC
+	RTS
+
+; ===========================================================================
+; BH_RENDER - append our sprites to the frame's OAM. Called from the battle
+; frame routine right after the enemy sprites were rendered.
+; ===========================================================================
+BH_RENDER:
+	BH_ENTER_NESTED
+	LDA z:BH_ACTIVE
+	BEQL @done
+	LDA z:BH_ANIM
+	BEQ @content
+	JSR BH_DRAW_BORDER_IF_NEEDED ; opening/closing: the outline only (no game window)
+	JMP @done
+@content:
+	LDA z:BH_MODE
+	BEQ @dodge
+	ASL
+	TAX
+	JSR (.LOWORD(BH_RENDER_TABLE),X)   ; gauge, rhythm, focus, mash, slots, combo
+	JSR BH_DRAW_HINT
+	JSR BH_DRAW_BORDER_IF_NEEDED
+	JMP @done
+@dodge:
+	; heart (blinks while invincible)
+	LDA z:BH_IFRAMES
+	BEQ @heart
+	AND #4
+	BNE @noheart
+@heart:
+	LDA z:BH_HEART_X
+	STA z:BH_T0
+	LDA z:BH_HEART_Y
+	STA z:BH_T1
+	LDA z:BH_PIECE_TILE + 0
+	STA z:BH_T2
+	STZ z:BH_T3
+	LDA #BH_ATTR_BASE
+	STA z:BH_T4
+	JSR BH_OAM_PUT
+@noheart:
+	; bullets
+	LDX #0
+@bullet:
+	LDA BH_BULLETS + BHB_TYPE,X
+	AND #$00FF
+	BEQ @next
+	STX z:BH_T6
+	LDA BH_BULLETS + BHB_TILE,X    ; resolved at spawn
+	STA z:BH_T2
+	LDA BH_BULLETS + BHB_ATTR,X
+	AND #BH_MODE_BIG << 8
+	BEQ :+
+	LDA #1
+:	STA z:BH_T3                    ; 32x32 sprite for big bullets
+	LDA BH_BULLETS + BHB_ATTR,X
+	AND #$00FF
+	STA z:BH_T4
+	LDA BH_BULLETS + BHB_X,X
+	JSR BH_ASR4
+	STA z:BH_T0
+	LDA BH_BULLETS + BHB_Y,X
+	JSR BH_ASR4
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+@next:
+	TXA
+	CLC
+	ADC #BH_BULLET_SIZE
+	TAX
+	CPX #BH_MAX_BULLETS * BH_BULLET_SIZE
+	BCC @bullet
+	JSR BH_DRAW_HINT
+	JSR BH_DRAW_BORDER_IF_NEEDED
+@done:
+	BH_LEAVE
+
+; ---------------------------------------------------------------------------
+; BH_TILE_FOR_TYPE - A = sprite type -> BH_T2 = tile, BH_T3 = size bit,
+;                    BH_T4 = attribute bits (X preserved)
+; ---------------------------------------------------------------------------
+BH_TILE_FOR_TYPE:
+	PHX
+	DEC
+	STA z:BH_T5
+	ASL
+	CLC
+	ADC z:BH_T5
+	ASL                     ; type index * 6
+	TAX
+	LDA f:BH_TYPE_TABLE + 1,X
+	AND #$00FF
+	STA z:BH_T2
+	LDA f:BH_TYPE_TABLE + 2,X
+	AND #$00FF
+	STA z:BH_T3
+	LDA f:BH_TYPE_TABLE + 5,X
+	AND #$00FF
+	ORA #BH_ATTR_BASE
+	STA z:BH_T4
+	LDA f:BH_TYPE_TABLE + 0,X
+	AND #$00FF
+	CMP #$80
+	BNE @base
+	; a sprite cut from the attacking enemy: its sheet, its palette
+	LDA z:BH_THEME_TILE
+	CLC
+	ADC z:BH_T2
+	STA z:BH_T2
+	LDA z:BH_THEME_PAL
+	ASL
+	ORA #$30
+	STA z:BH_T4
+	PLX
+	RTS
+@base:
+	ASL
+	TAX
+	LDA z:BH_PIECE_TILE,X
+	CLC
+	ADC z:BH_T2
+	STA z:BH_T2
+	PLX
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_RENDER_GAUGE - FIGHT timing bar: cursor first (highest priority), then
+;                   nine coloured blocks across the box
+; ---------------------------------------------------------------------------
+BH_RENDER_GAUGE:
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #(BH_FIGHT_BOX_H / 2) - 8
+	STA z:BH_T7             ; gauge y
+	; cursor (blinks after the press)
+	LDA z:BH_FIGHT_STATE
+	BEQ @cursor
+	LDA z:BH_FIGHT_TIMER
+	AND #4
+	BNE @blocks
+@cursor:
+	LDA #BH_TYPE_CURSOR
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_CURSOR_X
+	SEC
+	SBC #7
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@blocks:
+	LDX #0
+@block:
+	STX z:BH_T6
+	LDA f:BH_GAUGE_COLORS,X
+	AND #$00FF
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6
+	ASL
+	ASL
+	ASL
+	ASL
+	CLC
+	ADC z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	CPX #9
+	BCC @block
+	RTS
+
+; arithmetic shift right by 4 (12.4 fixed point -> pixels)
+BH_ASR4:
+	CMP #$8000
+	ROR
+	CMP #$8000
+	ROR
+	CMP #$8000
+	ROR
+	CMP #$8000
+	ROR
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_DRAW_BORDER - 2 px white frame built from 32x32 line pieces. The pieces
+; are placed so that their transparent area lies outside the box, keeping the
+; per-scanline sprite budget inside the box for bullets.
+; ---------------------------------------------------------------------------
+BH_DRAW_BORDER:
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	CMP #32
+	BCC @sides              ; narrower than a line piece: no top/bottom lines
+	; ---- top edge: v-flipped horizontal line pieces above the box ----
+	LDA z:BH_PIECE_TILE + 2
+	STA z:BH_T2
+	LDA #1
+	STA z:BH_T3
+	LDA #BH_ATTR_BASE | $80
+	STA z:BH_T4
+	LDA z:BH_BOX_Y0
+	SEC
+	SBC #30
+	STA z:BH_T1
+	LDA z:BH_BOX_X0
+	STA z:BH_T5
+@top:
+	LDA z:BH_T5
+	STA z:BH_T0
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #32
+	STA z:BH_T5
+	CLC
+	ADC #32
+	CMP z:BH_BOX_X1
+	BCC @top
+	BEQ @top
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #32
+	STA z:BH_T0
+	JSR BH_OAM_PUT
+	; ---- bottom edge ----
+	LDA #BH_ATTR_BASE
+	STA z:BH_T4
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #2
+	STA z:BH_T1
+	LDA z:BH_BOX_X0
+	STA z:BH_T5
+@bottom:
+	LDA z:BH_T5
+	STA z:BH_T0
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #32
+	STA z:BH_T5
+	CLC
+	ADC #32
+	CMP z:BH_BOX_X1
+	BCC @bottom
+	BEQ @bottom
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #32
+	STA z:BH_T0
+	JSR BH_OAM_PUT
+@sides:
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC z:BH_BOX_Y0
+	CMP #16
+	BCS :+
+	RTS                     ; shorter than a side piece: no side lines
+:
+	; ---- left edge: h-flipped 16x16 vertical line pieces (2 slivers each) ----
+	LDA z:BH_PIECE_TILE + 4
+	STA z:BH_T2
+	STZ z:BH_T3
+	LDA #BH_ATTR_BASE | $40
+	STA z:BH_T4
+	LDA z:BH_BOX_X0
+	SEC
+	SBC #14
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	STA z:BH_T5
+@left:
+	LDA z:BH_T5
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	CLC
+	ADC #16
+	CMP z:BH_BOX_Y1
+	BCC @left
+	BEQ @left
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #16
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	; ---- right edge ----
+	LDA #BH_ATTR_BASE
+	STA z:BH_T4
+	LDA z:BH_BOX_X1
+	SEC
+	SBC #2
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	STA z:BH_T5
+@right:
+	LDA z:BH_T5
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #16
+	STA z:BH_T5
+	CLC
+	ADC #16
+	CMP z:BH_BOX_Y1
+	BCC @right
+	BEQ @right
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #16
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_OAM_PUT - append one sprite. BH_T0 = x (signed), BH_T1 = y (signed),
+; BH_T2 = tile (0-511), BH_T3 = size bit, BH_T4 = attribute bits.
+; Follows the same OAM/high table protocol as the game's sprite renderer.
+; ---------------------------------------------------------------------------
+BH_OAM_PUT:
+	LDX OAM_ADDR
+	CPX OAM_END_ADDR
+	BCS @full
+	; y must be in -32..223
+	LDA z:BH_T1
+	CLC
+	ADC #32
+	CMP #224 + 32
+	BCS @full
+	SEP #PROC_FLAGS::ACCUM8
+	; x high byte must be $00 or $FF
+	LDA z:BH_T0 + 1
+	BEQ @x_ok
+	CMP #$FF
+	BNE @skip8
+@x_ok:
+	LDA z:BH_T0
+	STA a:oam_entry::x_coord,X
+	LDA z:BH_T1
+	STA a:oam_entry::y_coord,X
+	LDA z:BH_T2
+	STA a:oam_entry::starting_tile,X
+	LDA z:BH_T2 + 1
+	AND #$01
+	ORA z:BH_T4
+	STA a:oam_entry::flags,X
+	; high table: x bit 8, then size
+	LDA z:BH_T0 + 1
+	ROL
+	ROR OAM_HIGH_TABLE_BUFFER
+	LDA z:BH_T3
+	ROR
+	ROR OAM_HIGH_TABLE_BUFFER
+	BCC @no_flush
+	LDA OAM_HIGH_TABLE_BUFFER
+	LDY OAM_HIGH_TABLE_ADDR
+	STA a:$0000,Y
+	REP #PROC_FLAGS::ACCUM8
+	INC OAM_HIGH_TABLE_ADDR
+	SEP #PROC_FLAGS::ACCUM8
+	LDA #$80
+	STA OAM_HIGH_TABLE_BUFFER
+@no_flush:
+	REP #PROC_FLAGS::ACCUM8
+	TXA
+	CLC
+	ADC #.SIZEOF(oam_entry)
+	STA OAM_ADDR
+	RTS
+@skip8:
+	REP #PROC_FLAGS::ACCUM8
+@full:
+	RTS
diff --git a/src/battle/bullet_hell/bh_hint_table.asm b/src/battle/bullet_hell/bh_hint_table.asm
new file mode 100644
index 00000000..cf0a9927
--- /dev/null
+++ b/src/battle/bullet_hell/bh_hint_table.asm
@@ -0,0 +1,9 @@
+; generated by tools/gen_bh_gfx.py: sprites per instruction line
+BH_HINT_LEN_TABLE:
+	.BYTE 7	; PRESS A IN THE GREEN
+	.BYTE 9	; TAP THE BUTTON A NOTE HITS
+	.BYTE 9	; PRESS A WHEN THEY FRAME IT
+	.BYTE 5	; MASH ANY BUTTON
+	.BYTE 9	; PRESS A TO STOP EACH REEL
+	.BYTE 8	; HIT THE BUTTONS IN ORDER
+	.BYTE 6	; DODGE THE BULLETS
diff --git a/src/battle/bullet_hell/bh_minigames.asm b/src/battle/bullet_hell/bh_minigames.asm
new file mode 100644
index 00000000..21e3f9bf
--- /dev/null
+++ b/src/battle/bullet_hell/bh_minigames.asm
@@ -0,0 +1,1739 @@
+; ---------------------------------------------------------------------------
+; Extra minigames, picked at random per action. Every graded press floats a
+; PERFECT / GOOD / OK / MISS label (BH_DRAW_LABEL) with its own sound.
+;   BH_RHYTHM_PHASE - the A, B, X and Y buttons sit in the middle of the box in
+;                     their controller arrangement; notes drawn as the same
+;                     icons fly in from the sides (Y from the left, the others
+;                     from the right) and must be answered with their own button
+;                     as they reach it. Damage 40-100 % by accuracy, SMAAAASH
+;                     from 90 %.
+;   BH_FOCUS_PHASE  - four brackets close in on a target; press A when they
+;                     frame it. Attacks: 100/85/70/40 % damage, SMAAAASH when
+;                     perfect. Enemy attacks: a perfect block dodges the blow,
+;                     good/ok take 50/75 %.
+;   BH_MASH_PHASE   - mash A for 2.5 seconds to fill a nine-block power bar
+;                     that drains all the time; the fill is the damage.
+;   BH_SLOTS_PHASE  - three reels of cherry / bell / seven / star spin; A stops
+;                     them one by one. Three of a kind is a SMAAAASH (three
+;                     sevens hit for 120 %), a pair 85 %, nothing 60 %.
+;   BH_COMBO_PHASE  - five button icons; press them in order before the timer
+;                     bar runs out.
+; All run inside the engine's direct page, like BH_FIGHT_PHASE.
+; ---------------------------------------------------------------------------
+
+
+; ---------------------------------------------------------------------------
+; Instruction lines: pre-rendered by tools/gen_bh_gfx.py as 3 pieces of sprite
+; text each (BH_HINTS, bank $F0). A game uploads its line into the sprite slots
+; after the base pieces and the sheets and draws it along the bottom of the box.
+; ---------------------------------------------------------------------------
+.INCLUDE "battle/bullet_hell/bh_hint_table.asm"
+BH_SPRITE_OFFS:
+	.WORD 0, 2, 32, 34
+
+; A = instruction index -> its three pieces in VRAM (BH_HINT_TILE), sprite count in BH_HINT_LEN
+BH_UPLOAD_HINT:
+	STA z:BH_T7
+	LDA z:BH_SHEET_END
+	STA z:BH_T6             ; first slot: right after the enemy sheets
+	CLC
+	ADC #BH_HINT_PIECES     ; first slot after the line
+	CMP z:BH_SLOT_LIMIT
+	BEQ :+
+	BCS @no_room
+:
+	LDX z:BH_T7
+	LDA f:BH_HINT_LEN_TABLE,X
+	AND #$00FF
+	STA z:BH_HINT_LEN
+	LDA z:BH_T7
+	LDY #BH_HINT_PIECES * 2
+	JSL MULT168             ; 16 x 8 bit multiply: index * 6 ...
+	XBA
+	AND #$FF00              ; ... * 256 = index * 1536
+	CLC
+	ADC #.LOWORD(BH_HINTS)
+	STA z:BH_T4
+	LDA #^BH_HINTS
+	STA z:BH_T5
+	STZ z:BH_T1             ; piece counter (BH_UPLOAD_PIECE_FROM uses T0, T2, T3)
+@piece:
+	LDX z:BH_T6
+	JSR BH_UPLOAD_PIECE_FROM
+	LDX z:BH_T1
+	STA z:BH_HINT_TILE,X
+	INC z:BH_T6
+	LDA z:BH_T4
+	CLC
+	ADC #BH_PIECE_BYTES
+	STA z:BH_T4
+	INX
+	INX
+	STX z:BH_T1
+	CPX #BH_HINT_PIECES * 2
+	BCC @piece
+	RTS
+@no_room:
+	LDA #$FFFF
+	STA z:BH_HINT_TILE
+	STZ z:BH_HINT_LEN
+	RTS
+
+; the current instruction line, centred along the bottom of the box (skipped when it would not
+; fit). Renderer scratch only: a dodge phase's pattern fields are live while this runs.
+BH_DRAW_HINT:
+	LDA z:BH_HINT_TILE
+	CMP #$FFFF
+	BEQ @done
+	LDA z:BH_HINT_LEN
+	BEQ @done
+	LDY #15
+	JSL MULT168
+	STA z:BH_T5             ; line width
+	CLC
+	ADC #BH_FRAME_LEFT + BH_FRAME_RIGHT + 4
+	STA z:BH_T6
+	LDA z:BH_BOX_X1
+	SEC
+	SBC z:BH_BOX_X0
+	CMP z:BH_T6
+	BCC @done               ; the box is too narrow for the line
+	LDA z:BH_T5
+	LSR
+	STA z:BH_T5
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	LSR
+	SEC
+	SBC z:BH_T5
+	STA z:BH_T5             ; x
+	LDA z:BH_BOX_Y1
+	SEC
+	SBC #BH_FRAME_BOTTOM + 13
+	STA z:BH_T6             ; y: the letters (sprite rows 5-10) end above the frame
+	STZ z:BH_T7             ; sprite index
+@sprite:
+	LDA z:BH_T7
+	CMP z:BH_HINT_LEN
+	BCS @done
+	LSR
+	LSR
+	ASL
+	TAX
+	LDA z:BH_HINT_TILE,X
+	STA z:BH_T2
+	LDA z:BH_T7
+	AND #$0003
+	ASL
+	TAX
+	LDA f:BH_SPRITE_OFFS,X
+	CLC
+	ADC z:BH_T2
+	STA z:BH_T2
+	STZ z:BH_T3
+	LDA #BH_ATTR_BASE
+	STA z:BH_T4
+	LDA z:BH_T5
+	STA z:BH_T0
+	LDA z:BH_T6
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDA z:BH_T5
+	CLC
+	ADC #15
+	STA z:BH_T5
+	INC z:BH_T7
+	BRA @sprite
+@done:
+	RTS
+
+; party physical attack: one of six games (BH_FORCE_MG: 1 gauge 2 rhythm 3 focus 6 mash 7 slots 8 combo)
+BH_PICK_ATTACK_GAME:
+	LDA z:BH_FORCE_MG
+	BEQ @random
+	CMP #2
+	BEQ @rhythm
+	CMP #3
+	BEQ @focus
+	CMP #6
+	BEQ @mash
+	CMP #7
+	BEQ @slots
+	CMP #8
+	BEQ @combo
+	BRA @gauge
+@random:
+	JSL RAND
+	CMP #43
+	BCC @gauge
+	CMP #86
+	BCC @rhythm
+	CMP #128
+	BCC @focus
+	CMP #171
+	BCC @mash
+	CMP #213
+	BCC @slots
+@combo:
+	LDA z:BH_PIECE_TILE + 12        ; button icons
+	CMP #$FFFF
+	BEQ @gauge
+	JMP BH_COMBO_PHASE
+@slots:
+	LDA z:BH_PIECE_TILE + 16        ; slot symbols
+	CMP #$FFFF
+	BEQ @gauge
+	JMP BH_SLOTS_PHASE
+@mash:
+	LDA z:BH_PIECE_TILE + 12
+	CMP #$FFFF
+	BEQ @gauge
+	JMP BH_MASH_PHASE
+@focus:
+	LDA z:BH_PIECE_TILE + 10        ; brackets
+	CMP #$FFFF
+	BEQ @gauge
+	LDA #0
+	JMP BH_FOCUS_PHASE
+@rhythm:
+	LDA z:BH_PIECE_TILE + 12
+	CMP #$FFFF
+	BEQ @gauge
+	JMP BH_RHYTHM_PHASE
+@gauge:
+	JMP BH_FIGHT_PHASE
+
+; enemy attack: the dodge box (3 in 4) or a timed block (1 in 4)
+BH_PICK_DEFENSE_GAME:
+	LDA z:BH_FORCE_MG
+	CMP #4
+	BEQ @focus
+	CMP #5
+	BEQ @dodge
+	JSL RAND
+	AND #$0003
+	BEQ @focus
+@dodge:
+	JMP BH_RUN_PHASE
+@focus:
+	LDA z:BH_PIECE_TILE + 10
+	CMP #$FFFF
+	BEQ @dodge
+	LDA #1
+	JMP BH_FOCUS_PHASE
+
+; A = sound effect (X and the index width preserved)
+BH_MG_SOUND:
+	PHX
+	JSL PLAY_SOUND
+	REP #PROC_FLAGS::ACCUM8 | PROC_FLAGS::INDEX8
+	PLX
+	RTS
+
+; grade tables: 0 perfect, 1 good, 2 ok, 3 miss
+BH_GRADE_POINTS:
+	.WORD 10, 7, 4, 0
+BH_GRADE_SFX:
+	.WORD SFX::CURSOR2, SFX::CURSOR1, SFX::CURSOR3, SFX::CURSOR_INVALID
+BH_GRADE_BLOCK:
+	.WORD BH_TYPE_GAUGE_GRN, BH_TYPE_GAUGE_YEL, BH_TYPE_GAUGE_YEL, BH_TYPE_GAUGE_RED
+BH_GRADE_ATK_PCT:               ; attack damage by grade (focus, mash, combo)
+	.WORD 100, 85, 70, 40
+BH_LABEL_TYPES:                 ; up to three 16 px sprites per label, 0 = end
+	.BYTE BH_TYPE_LBL_PER, BH_TYPE_LBL_FEC, BH_TYPE_LBL_T, 0
+	.BYTE BH_TYPE_LBL_GOO, BH_TYPE_LBL_D, 0, 0
+	.BYTE BH_TYPE_LBL_OK, 0, 0, 0
+	.BYTE BH_TYPE_LBL_MIS, BH_TYPE_LBL_S, 0, 0
+BH_LANE_BUTTON:
+	.WORD PAD::A_BUTTON, PAD::B_BUTTON, PAD::X_BUTTON, PAD::Y_BUTTON
+BH_LANE_TYPE:                   ; button icon per lane
+	.WORD BH_TYPE_BUTTON_A, BH_TYPE_BUTTON_B, BH_TYPE_BUTTON_X, BH_TYPE_BUTTON_Y
+; the SNES pad diamond: A right, B bottom, X top, Y left (sprite top-left offsets from the box centre)
+BH_LANE_TX:
+	.WORD 10, .LOWORD(-8), .LOWORD(-8), .LOWORD(-26)
+BH_LANE_TY:
+	.WORD .LOWORD(-8), 10, .LOWORD(-26), .LOWORD(-8)
+BH_LANE_DIR:                    ; notes fly in against this direction: -1 = from the right, +1 = from the left
+	.WORD .LOWORD(-1), .LOWORD(-1), .LOWORD(-1), 1
+BH_LANE_LBL_X:                  ; where a lane's grade label starts (offset from the button's top-left)
+	.WORD 20, .LOWORD(-14), .LOWORD(-14), .LOWORD(-52)
+BH_LANE_LBL_Y:
+	.WORD 0, 18, .LOWORD(-18), 0
+BH_RENDER_TABLE:
+	.WORD 0, .LOWORD(BH_RENDER_GAUGE), .LOWORD(BH_RENDER_RHYTHM), .LOWORD(BH_RENDER_FOCUS)
+	.WORD .LOWORD(BH_RENDER_MASH), .LOWORD(BH_RENDER_SLOTS), .LOWORD(BH_RENDER_COMBO)
+
+; the attack outcome of a grade in A: damage percent, SMAAAASH when perfect, the usual hit roll on a miss
+BH_GRADE_ATTACK:
+	ASL
+	TAX
+	LDA f:BH_GRADE_ATK_PCT,X
+	STA z:BH_DMG_PCT
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	STZ z:BH_FORCE
+	CPX #6
+	BEQ @done
+	LDA #1
+	STA z:BH_FORCE
+	CPX #0
+	BNE @done
+	STA z:BH_FIGHT_RESULT
+@done:
+	RTS
+
+; A = grade -> the floating label and its sound (label kind/timer; the caller places it)
+BH_GRADE_FEEDBACK:
+	STA z:BH_MG_FB_KIND
+	ASL
+	TAX
+	LDA #36
+	STA z:BH_MG_FB_TIMER
+	LDA f:BH_GRADE_SFX,X
+	JMP BH_MG_SOUND
+
+; box centre -> BH_PAT_WAIT (x), BH_LOOP_CNT (y): pattern fields, idle during a minigame
+BH_MG_CENTRE:
+	LDA z:BH_BOX_X0
+	CLC
+	ADC z:BH_BOX_X1
+	LSR
+	STA z:BH_PAT_WAIT
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC z:BH_BOX_Y1
+	LSR
+	STA z:BH_LOOP_CNT
+	RTS
+
+; the label floats up from (BH_T0, BH_T1) over BH_MG_FB_TIMER frames
+BH_MG_FLOAT_LABEL:
+	LDA z:BH_MG_FB_TIMER
+	BEQ @none
+	LDA #36
+	SEC
+	SBC z:BH_MG_FB_TIMER
+	LSR
+	LSR
+	STA z:BH_T2
+	LDA z:BH_T1
+	SEC
+	SBC z:BH_T2
+	STA z:BH_T1
+	LDA z:BH_MG_FB_KIND
+	JMP BH_DRAW_LABEL
+@none:
+	RTS
+
+; the common end of a minigame: close the box, let the enemies come back, resume the HP roll
+BH_MG_FINISH:
+	STZ z:BH_YSHIFT_TGT
+	JSR BH_BOX_CLOSE
+	STZ z:BH_MODE
+@ramp:
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	LDA z:BH_YSHIFT
+	BNE @ramp
+	JMP BH_ROLL_RESTORE
+
+; the common start: box BH_T0 x BH_T1, mode in A, counters cleared, box opened
+BH_MG_START:
+	STA z:BH_MODE
+	JSR BH_ROLL_FREEZE
+	JSR BH_SET_BOX
+	STZ z:BH_FIGHT_STATE
+	STZ z:BH_FIGHT_TIMER
+	STZ z:BH_FRAME
+	STZ z:BH_MG_SCORE
+	STZ z:BH_MG_COUNT
+	STZ z:BH_MG_FB_TIMER
+	LDA #0
+	JSR BH_CALC_YSHIFT
+	JSR BH_UPLOAD_GFX
+	LDA z:BH_HINT_LEN
+	JSR BH_UPLOAD_HINT
+	JMP BH_BOX_OPEN
+
+; one frame of a minigame loop: tick, feedback timer; returns with Z set once the wind-down ended
+BH_MG_FRAME:
+	JSR BH_TICK
+	JSR BH_RAMP_SHIFT
+	INC z:BH_FRAME
+	LDA z:BH_MG_FB_TIMER
+	BEQ :+
+	DEC z:BH_MG_FB_TIMER
+:	LDA z:BH_FIGHT_STATE
+	BEQ @running
+	DEC z:BH_FIGHT_TIMER
+	BNE @running
+	LDA #0
+	RTS
+@running:
+	LDA #1
+	RTS
+
+; ---------------------------------------------------------------------------
+; BH_DRAW_LABEL - A = grade, BH_T0/BH_T1 = top-left -> PERFECT/GOOD/OK/MISS
+;   (a coloured block when the label pieces found no sprite VRAM)
+; ---------------------------------------------------------------------------
+BH_DRAW_LABEL:
+	LDX z:BH_PIECE_TILE + 14
+	CPX #$FFFF
+	BEQ @block
+	ASL
+	ASL
+	STA z:BH_LOOP_PC        ; table index
+@sprite:
+	LDX z:BH_LOOP_PC
+	LDA f:BH_LABEL_TYPES,X
+	AND #$00FF
+	BEQ @done
+	JSR BH_TILE_FOR_TYPE
+	JSR BH_OAM_PUT
+	LDA z:BH_T0
+	CLC
+	ADC #15
+	STA z:BH_T0
+	INC z:BH_LOOP_PC
+	LDA z:BH_LOOP_PC
+	AND #$0003
+	BNE @sprite
+@done:
+	RTS
+@block:
+	ASL
+	TAX
+	LDA f:BH_GRADE_BLOCK,X
+	JSR BH_TILE_FOR_TYPE
+	JMP BH_OAM_PUT
+
+; A = lane -> BH_T0/BH_T1 = its target sprite's top-left (BH_MG_CENTRE must have run)
+BH_LANE_TARGET:
+	ASL
+	TAX
+	LDA f:BH_LANE_TX,X
+	CLC
+	ADC z:BH_PAT_WAIT
+	STA z:BH_T0
+	LDA f:BH_LANE_TY,X
+	CLC
+	ADC z:BH_LOOP_CNT
+	STA z:BH_T1
+	RTS
+
+; ===========================================================================
+; BH_RHYTHM_PHASE
+; ===========================================================================
+BH_RHYTHM_PHASE:
+	LDA #1
+	STA z:BH_HINT_LEN       ; instruction line
+	LDA #BH_RHYTHM_BOX_W
+	STA z:BH_T0
+	LDA #BH_RHYTHM_BOX_H
+	STA z:BH_T1
+	LDA #2
+	JSR BH_MG_START_NOOPEN
+	LDA #20
+	STA z:BH_DMG_PCT        ; whiffed unless a note is hit
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	STA z:BH_FORCE
+	JSL RAND
+	AND #$0001
+	CLC
+	ADC #4
+	STA z:BH_MG_COUNT       ; 4 or 5 notes
+	JSL RAND
+	AND #$000F
+	CLC
+	ADC #32
+	STA z:BH_FIGHT_DIR      ; 2.0-2.9 px per frame
+	; the first note is 110 px out, the next ones 40-71 px further, each in a random lane
+	LDA #110
+	STA z:BH_T2
+	LDX #0
+	STZ z:BH_T3
+@note:
+	LDA z:BH_T2
+	ASL
+	ASL
+	ASL
+	ASL
+	STA BH_BULLETS + BHR_D,X
+	JSL RAND
+	AND #$001F
+	CLC
+	ADC #40
+	CLC
+	ADC z:BH_T2
+	STA z:BH_T2
+	JSL RAND
+	AND #$0003
+	XBA                     ; lane in the high byte
+	STA z:BH_T4
+	LDA z:BH_T3
+	CMP z:BH_MG_COUNT
+	BCC @pending
+	LDA #4                  ; unused slot
+	BRA @state
+@pending:
+	LDA #0
+@state:
+	ORA z:BH_T4
+	STA BH_BULLETS + BHR_ST,X
+	INC z:BH_T3
+	INX
+	INX
+	CPX #10
+	BCC @note
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_MG_FRAME
+	BNE @alive
+	JMP @result
+@alive:
+	LDA z:BH_FIGHT_STATE
+	BEQ @running
+	JMP @loop
+@running:
+	; ---- the notes approach; 18 px past its button a note is missed ----
+	LDX #0
+@move:
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$00FF
+	BNE @move_next
+	LDA BH_BULLETS + BHR_D,X
+	SEC
+	SBC z:BH_FIGHT_DIR
+	STA BH_BULLETS + BHR_D,X
+	CLC
+	ADC #BH_NOTE_OK * 16
+	BPL @move_next
+	LDA #3
+	JSR BH_RHYTHM_GRADE
+@move_next:
+	INX
+	INX
+	CPX #10
+	BCC @move
+	; ---- a button press judges the pending note nearest its button ----
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON | PAD::B_BUTTON | PAD::X_BUTTON | PAD::Y_BUTTON
+	BNE @press
+	JMP @check
+@press:
+	STA z:BH_T7             ; the buttons pressed
+	LDA #$7FFF
+	STA z:BH_T5             ; best distance
+	LDA #$FFFF
+	STA z:BH_T6             ; best slot
+	LDX #0
+@find:
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$00FF
+	BNE @find_next
+	LDA BH_BULLETS + BHR_D,X
+	JSR BH_ASR4
+	JSR BH_ABS
+	CMP z:BH_T5
+	BCS @find_next
+	STA z:BH_T5
+	STX z:BH_T6
+@find_next:
+	INX
+	INX
+	CPX #10
+	BCC @find
+	LDX z:BH_T6
+	BMI @check              ; no pending note
+	LDA z:BH_T5
+	CMP #BH_NOTE_OK + 1
+	BCS @check              ; nothing near its button: the press is ignored
+	LDA BH_BULLETS + BHR_ST,X
+	XBA
+	AND #$0003
+	ASL
+	TAX
+	LDA f:BH_LANE_BUTTON,X
+	LDX z:BH_T6
+	AND z:BH_T7
+	BEQ @wrong
+	LDA z:BH_T5
+	CMP #BH_NOTE_PERFECT + 1
+	BCC @perfect
+	CMP #BH_NOTE_GOOD + 1
+	BCC @good
+	LDA #2
+	BRA @grade
+@perfect:
+	LDA #0
+	BRA @grade
+@good:
+	LDA #1
+	BRA @grade
+@wrong:
+	LDA #3
+@grade:
+	JSR BH_RHYTHM_GRADE
+@check:
+	; ---- every note resolved (or 6 seconds): wind down ----
+	LDX #0
+@chk:
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$00FF
+	BEQ @still_pending
+	INX
+	INX
+	CPX #10
+	BCC @chk
+	BRA @finish
+@still_pending:
+	LDA z:BH_FRAME
+	CMP #360
+	BCC @loop_j
+@finish:
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #30
+	STA z:BH_FIGHT_TIMER
+@loop_j:
+	JMP @loop
+@result:
+	; ---- 40..100 % of the damage by points, SMAAAASH from 90 % ----
+	LDA z:BH_MG_SCORE
+	BEQ @end                ; nothing hit: the 20 % whiff and the forced miss stand
+	LDA #1
+	STA z:BH_FORCE
+	LDA z:BH_MG_SCORE
+	LDY #60
+	JSL MULT168
+	STA z:BH_T0
+	LDA z:BH_MG_COUNT
+	LDY #10
+	JSL MULT168
+	TAY
+	LDA z:BH_T0
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	CLC
+	ADC #40
+	STA z:BH_DMG_PCT
+	CMP #94
+	BCC @end
+	LDA #1
+	STA z:BH_FIGHT_RESULT
+@end:
+	JMP BH_MG_FINISH
+
+; like BH_MG_START but the caller opens the box (it fills tables first)
+BH_MG_START_NOOPEN:
+	STA z:BH_MODE
+	JSR BH_ROLL_FREEZE
+	JSR BH_SET_BOX
+	STZ z:BH_FIGHT_STATE
+	STZ z:BH_FIGHT_TIMER
+	STZ z:BH_FRAME
+	STZ z:BH_MG_SCORE
+	STZ z:BH_MG_COUNT
+	STZ z:BH_MG_FB_TIMER
+	LDA #0
+	JSR BH_CALC_YSHIFT
+	JSR BH_UPLOAD_GFX
+	LDA z:BH_HINT_LEN
+	JMP BH_UPLOAD_HINT
+
+; X = note slot (2i), A = grade -> the note's state, the score, a floating label and a sound
+BH_RHYTHM_GRADE:
+	PHX
+	STA z:BH_T1
+	INC
+	STA z:BH_T2             ; state 1-4
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$FF00
+	ORA z:BH_T2
+	STA BH_BULLETS + BHR_ST,X
+	XBA
+	AND #$0003
+	STA z:BH_MG_FB_X        ; the label floats off this lane's button
+	LDA z:BH_T1
+	ASL
+	TAX
+	LDA f:BH_GRADE_POINTS,X
+	CLC
+	ADC z:BH_MG_SCORE
+	STA z:BH_MG_SCORE
+	LDA z:BH_T1
+	JSR BH_GRADE_FEEDBACK
+	PLX
+	RTS
+
+; ---------------------------------------------------------------------------
+BH_RENDER_RHYTHM:
+	JSR BH_MG_CENTRE
+	; the four buttons in the middle
+	LDX #0
+@target:
+	STX z:BH_T6
+	LDA f:BH_LANE_TYPE,X
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6
+	LSR
+	JSR BH_LANE_TARGET
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #8
+	BCC @target
+	; pending notes inside the box, drawn as their lane's button
+	LDX #0
+@note:
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$00FF
+	BNE @note_next
+	STX z:BH_T6
+	LDA BH_BULLETS + BHR_ST,X
+	XBA
+	AND #$0003
+	STA z:BH_T7             ; lane
+	ASL
+	TAX
+	LDA f:BH_LANE_TYPE,X
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T7
+	JSR BH_LANE_TARGET      ; T0/T1 = the button; the note sits d px out along the lane
+	LDX z:BH_T6
+	LDA BH_BULLETS + BHR_D,X
+	JSR BH_ASR4
+	STA z:BH_T5
+	LDA z:BH_T7
+	ASL
+	TAX
+	LDA f:BH_LANE_DIR,X
+	BMI @from_right
+	LDA z:BH_T0
+	SEC
+	SBC z:BH_T5
+	BRA @have_x
+@from_right:
+	LDA z:BH_T0
+	CLC
+	ADC z:BH_T5
+@have_x:
+	STA z:BH_T0
+	CLC
+	ADC #16
+	CMP z:BH_BOX_X1
+	BCS @note_restore
+	LDA z:BH_T0
+	CMP z:BH_BOX_X0
+	BCC @note_restore
+	JSR BH_OAM_PUT
+@note_restore:
+	LDX z:BH_T6
+@note_next:
+	INX
+	INX
+	CPX #10
+	BCC @note
+	; the grade label floating up from the graded lane's button
+	LDA z:BH_MG_FB_TIMER
+	BEQ @strip
+	LDA z:BH_MG_FB_X
+	JSR BH_LANE_TARGET
+	LDA z:BH_MG_FB_X
+	ASL
+	TAX
+	LDA z:BH_T0
+	CLC
+	ADC f:BH_LANE_LBL_X,X
+	STA z:BH_T0
+	LDA z:BH_T1
+	CLC
+	ADC f:BH_LANE_LBL_Y,X
+	STA z:BH_T1
+	JSR BH_MG_FLOAT_LABEL
+@strip:
+	; results in the top-left corner: green / yellow / red block per graded note
+	LDX #0
+@res:
+	TXA
+	LSR
+	CMP z:BH_MG_COUNT
+	BCS @res_done
+	LDA BH_BULLETS + BHR_ST,X
+	AND #$00FF
+	BEQ @res_next
+	STX z:BH_T6
+	DEC
+	ASL
+	TAX
+	LDA f:BH_GRADE_BLOCK,X
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6             ; 2i
+	ASL                     ; 4i
+	STA z:BH_T0
+	ASL
+	ASL                     ; 16i
+	CLC
+	ADC z:BH_T0             ; 20i
+	CLC
+	ADC z:BH_BOX_X0
+	CLC
+	ADC #8
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #BH_FRAME_TOP + 1
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+@res_next:
+	INX
+	INX
+	CPX #10
+	BCC @res
+@res_done:
+	RTS
+
+; ===========================================================================
+; BH_FOCUS_PHASE - A = 0: attack (crosshair, damage bonus)  1: block an enemy
+; ===========================================================================
+BH_FOCUS_PHASE:
+	PHA
+	LDA #2
+	STA z:BH_HINT_LEN
+	LDA #BH_FOCUS_BOX_W
+	STA z:BH_T0
+	LDA #BH_FOCUS_BOX_H
+	STA z:BH_T1
+	LDA #3
+	JSR BH_MG_START_NOOPEN
+	PLA
+	STA z:BH_MG_COUNT       ; 1 = block
+	LDA #3
+	STA z:BH_MG_SCORE       ; a miss until proven otherwise
+	LDA #BH_FOCUS_START * 16
+	STA z:BH_MG_DIST
+	JSL RAND
+	AND #$0003
+	CLC
+	ADC #8
+	STA z:BH_FIGHT_DIR      ; 0.5-0.7 px per frame: 35-48 frames to focus
+	LDA z:BH_MG_COUNT
+	BNE @block_init
+	LDA #40
+	STA z:BH_DMG_PCT        ; attack: 40 % unless timed
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	STZ z:BH_FORCE          ; and the usual hit roll
+	BRA @init_done
+@block_init:
+	LDA #1
+	STA z:BH_HITS           ; the blow lands unless the block is perfect
+	LDA #100
+	STA z:BH_DMG_PCT
+@init_done:
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_MG_FRAME
+	BEQ @end
+	LDA z:BH_FIGHT_STATE
+	BNE @loop
+	LDA z:BH_FRAME
+	CMP #12
+	BCC @loop               ; the brackets hold still for a moment first
+	LDA z:BH_MG_DIST
+	SEC
+	SBC z:BH_FIGHT_DIR
+	STA z:BH_MG_DIST
+	CLC
+	ADC #4 * 16
+	BPL @not_passed
+	LDA #3                  ; the brackets went through the target: a miss
+	JSR BH_FOCUS_RESOLVE
+	BRA @loop
+@not_passed:
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BEQ @loop
+	LDA z:BH_MG_DIST
+	JSR BH_ASR4
+	SEC
+	SBC #BH_FOCUS_TARGET
+	JSR BH_ABS
+	CMP #BH_FOCUS_PERFECT + 1
+	BCC @perfect
+	CMP #BH_FOCUS_GOOD + 1
+	BCC @good
+	CMP #BH_FOCUS_OK + 1
+	BCC @ok
+	LDA #3
+	BRA @resolve
+@perfect:
+	LDA #0
+	BRA @resolve
+@good:
+	LDA #1
+	BRA @resolve
+@ok:
+	LDA #2
+@resolve:
+	JSR BH_FOCUS_RESOLVE
+	BRA @loop
+@end:
+	JMP BH_MG_FINISH
+
+; A = result (0 perfect, 1 good, 2 ok, 3 miss): label, sound and the outcome
+BH_FOCUS_RESOLVE:
+	STA z:BH_MG_SCORE
+	JSR BH_GRADE_FEEDBACK
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #36
+	STA z:BH_FIGHT_TIMER
+	LDA z:BH_MG_COUNT
+	BNE @block
+	LDA z:BH_MG_SCORE
+	JMP BH_GRADE_ATTACK
+@block:
+	; enemy attack: dodged / 50 % / 75 % / 100 %
+	LDA z:BH_MG_SCORE
+	ASL
+	TAX
+	LDA f:BH_FOCUS_DEF_PCT,X
+	STA z:BH_DMG_PCT
+	BNE @done
+	STZ z:BH_HITS           ; a perfect block: the attack is dodged
+@done:
+	RTS
+
+BH_FOCUS_DEF_PCT:
+	.WORD 0, 50, 75, 100
+
+; ---------------------------------------------------------------------------
+BH_RENDER_FOCUS:
+	JSR BH_MG_CENTRE
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #4                  ; a little high, so the widest brackets clear the hint line
+	STA z:BH_LOOP_CNT
+	; the target: heart (block) or crosshair (attack); a spark once a perfect press landed
+	LDA z:BH_FIGHT_STATE
+	BEQ @target
+	LDA z:BH_MG_SCORE
+	BEQ @spark
+	LDA z:BH_FIGHT_TIMER
+	AND #4
+	BNE @brackets
+@target:
+	LDA #BH_TYPE_CROSSHAIR
+	LDX z:BH_MG_COUNT
+	BEQ @put_target
+	LDA #BH_TYPE_HEART
+	BRA @put_target
+@spark:
+	LDA #BH_TYPE_SPARK
+@put_target:
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@brackets:
+	LDA z:BH_MG_DIST
+	JSR BH_ASR4
+	STA z:BH_T7             ; distance in px
+	LDA #BH_TYPE_BRACKET
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T4
+	STA z:BH_LOOP_PC        ; base attribute
+	; top left
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC z:BH_T7
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	; top right (h-flip)
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC z:BH_T7
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC z:BH_T7
+	STA z:BH_T1
+	LDA z:BH_LOOP_PC
+	ORA #$40
+	STA z:BH_T4
+	JSR BH_OAM_PUT
+	; bottom left (v-flip)
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC z:BH_T7
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC z:BH_T7
+	SEC
+	SBC #16
+	STA z:BH_T1
+	LDA z:BH_LOOP_PC
+	ORA #$80
+	STA z:BH_T4
+	JSR BH_OAM_PUT
+	; bottom right (both)
+	LDA z:BH_PAT_WAIT
+	CLC
+	ADC z:BH_T7
+	SEC
+	SBC #16
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC z:BH_T7
+	SEC
+	SBC #16
+	STA z:BH_T1
+	LDA z:BH_LOOP_PC
+	ORA #$C0
+	STA z:BH_T4
+	JSR BH_OAM_PUT
+	; the grade label floating up above the target
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #22
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #28
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; ===========================================================================
+; BH_MASH_PHASE - mash any face button: +14 per press, -1 per frame, nine
+;   blocks of 16. The bar's edge moves with every press, the prompt shows the
+;   button just pressed and jumps, OK / GOOD / PERFECT pop as the bar crosses
+;   40 / 90 / 130, and a full bar sparks.
+; ===========================================================================
+BH_MASH_PHASE:
+	LDA #3
+	STA z:BH_HINT_LEN
+	LDA #BH_FIGHT_BOX_W
+	STA z:BH_T0
+	LDA #72
+	STA z:BH_T1
+	LDA #4
+	JSR BH_MG_START
+	LDA #20
+	STA z:BH_DMG_PCT        ; a whiff until a press
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	STA z:BH_FORCE
+	STZ z:BH_FIGHT_TIME     ; highest threshold announced so far
+	STZ z:BH_FIGHT_DIR      ; prompt jump frames
+	STZ z:BH_MG_FB_X        ; button shown by the prompt (lane: A B X Y)
+@loop:
+	JSR BH_MG_FRAME
+	BNE @alive
+	JMP @end
+@alive:
+	LDA z:BH_FIGHT_STATE
+	BNE @loop
+	LDA z:BH_FIGHT_DIR
+	BEQ :+
+	DEC z:BH_FIGHT_DIR
+:	; drain
+	LDA z:BH_MG_SCORE
+	BEQ :+
+	DEC z:BH_MG_SCORE
+:	LDA PAD_PRESS
+	AND #PAD::A_BUTTON | PAD::B_BUTTON | PAD::X_BUTTON | PAD::Y_BUTTON
+	BEQ @no_press
+	STA z:BH_T7
+	INC z:BH_MG_COUNT
+	; which button: the prompt takes its icon
+	LDX #0
+@which:
+	LDA f:BH_LANE_BUTTON,X
+	AND z:BH_T7
+	BNE @found
+	INX
+	INX
+	CPX #8
+	BCC @which
+	LDX #0
+@found:
+	TXA
+	LSR
+	STA z:BH_MG_FB_X
+	LDA #6
+	STA z:BH_FIGHT_DIR      ; the prompt jumps
+	LDA z:BH_MG_SCORE
+	CLC
+	ADC #14
+	CMP #BH_MASH_FULL
+	BCC :+
+	LDA #BH_MASH_FULL
+:	STA z:BH_MG_SCORE
+	; a threshold crossed announces itself (OK / GOOD / PERFECT); otherwise a tick
+	CMP #130
+	BCC @try_good
+	LDX #3
+	BRA @announce
+@try_good:
+	CMP #90
+	BCC @try_ok
+	LDX #2
+	BRA @announce
+@try_ok:
+	CMP #40
+	BCC @tick
+	LDX #1
+@announce:
+	CPX z:BH_FIGHT_TIME
+	BEQ @tick
+	BCC @tick
+	STX z:BH_FIGHT_TIME
+	LDA #3
+	STX z:BH_T6
+	SEC
+	SBC z:BH_T6             ; level 1/2/3 -> grade 2/1/0
+	JSR BH_GRADE_FEEDBACK
+	BRA @no_press
+@tick:
+	LDA #SFX::CURSOR3
+	JSR BH_MG_SOUND
+@no_press:
+	LDA z:BH_FRAME
+	CMP #BH_MASH_FRAMES
+	BCC @loop_j
+	; ---- time is up: grade the fill ----
+	LDA z:BH_MG_COUNT
+	BNE :+
+	LDA #3                  ; never pressed: the whiff stands, say so
+	JSR BH_GRADE_FEEDBACK
+	BRA @finish
+:	LDA z:BH_MG_SCORE
+	CMP #130
+	BCS @g0
+	CMP #90
+	BCS @g1
+	CMP #40
+	BCS @g2
+	LDA #3
+	BRA @grade
+@g0:
+	LDA #0
+	BRA @grade
+@g1:
+	LDA #1
+	BRA @grade
+@g2:
+	LDA #2
+@grade:
+	PHA
+	JSR BH_GRADE_ATTACK
+	PLA
+	JSR BH_GRADE_FEEDBACK
+@finish:
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #36
+	STA z:BH_FIGHT_TIMER
+@loop_j:
+	JMP @loop
+@end:
+	JMP BH_MG_FINISH
+
+; ---------------------------------------------------------------------------
+BH_RENDER_MASH:
+	JSR BH_MG_CENTRE
+	; the nine-block bar (red, yellow, green thirds), filled blocks only
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC #6
+	STA z:BH_T7             ; bar y
+	LDX #0
+@block:
+	STX z:BH_T6
+	TXA
+	ASL
+	ASL
+	ASL                     ; 16 * i
+	CLC
+	ADC #16
+	CMP z:BH_MG_SCORE
+	BEQ :+
+	BCS @bar_done           ; not filled this far
+:	LDA #BH_TYPE_GAUGE_RED
+	CPX #6
+	BCC :+
+	LDA #BH_TYPE_GAUGE_YEL
+	CPX #12
+	BCC :+
+	LDA #BH_TYPE_GAUGE_GRN
+:	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6
+	ASL
+	ASL
+	ASL                     ; 16 * i
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #18
+	BCC @block
+@bar_done:
+	; the bar's edge: a line at the exact fill, moving with every press
+	LDA z:BH_FIGHT_STATE
+	BNE @prompt
+	LDA z:BH_MG_SCORE
+	BEQ @prompt
+	CMP #BH_MASH_FULL
+	BCS @prompt
+	LDA #BH_TYPE_CURSOR
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #72 + 7
+	CLC
+	ADC z:BH_MG_SCORE
+	STA z:BH_T0
+	LDA z:BH_T7
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@prompt:
+	; the button just pressed bounces above the bar and jumps on each press; a spark once full
+	LDA z:BH_FIGHT_STATE
+	BNE @label
+	LDX z:BH_MG_SCORE
+	CPX #BH_MASH_FULL
+	BEQ @spark
+	LDA z:BH_MG_FB_X
+	ASL
+	TAX
+	LDA f:BH_LANE_TYPE,X
+	BRA @put_prompt
+@spark:
+	LDA #BH_TYPE_SPARK
+@put_prompt:
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #8
+	STA z:BH_T0
+	LDA z:BH_FRAME
+	LSR
+	LSR
+	AND #$0003              ; 0..3 idle bounce
+	CLC
+	ADC z:BH_FIGHT_DIR      ; plus the jump after a press
+	STA z:BH_T1
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #18
+	SEC
+	SBC z:BH_T1
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@label:
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #22
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #4
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+
+; ===========================================================================
+; BH_SLOTS_PHASE - three reels, A stops the next spinning one
+; ===========================================================================
+BH_SLOTS_PHASE:
+	LDA #4
+	STA z:BH_HINT_LEN
+	LDA #160
+	STA z:BH_T0
+	LDA #88
+	STA z:BH_T1
+	LDA #5
+	JSR BH_MG_START_NOOPEN
+	LDA #1
+	STA z:BH_FORCE          ; the attack always connects; the reels set the damage
+	LDX #0
+@reel:
+	JSL RAND
+	AND #$0003
+	STA BH_BULLETS + BHS_SYM,X
+	STZ BH_BULLETS + BHS_STOP,X
+	INX
+	INX
+	CPX #6
+	BCC @reel
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_MG_FRAME
+	BNE @alive
+	JMP @end
+@alive:
+	LDA z:BH_FIGHT_STATE
+	BNE @loop
+	; spin: a reel advances every BH_SLOTS_STEP frames, the reels staggered by two
+	LDX #0
+@spin:
+	LDA BH_BULLETS + BHS_STOP,X
+	BNE @spin_next
+	TXA
+	CLC
+	ADC z:BH_FRAME
+	STA z:BH_T0
+	LDA #0
+@mod:
+	LDA z:BH_T0
+	SEC
+	SBC #BH_SLOTS_STEP
+	STA z:BH_T0
+	BPL @mod
+	CLC
+	ADC #BH_SLOTS_STEP      ; frame mod 6
+	BNE @spin_next
+	LDA BH_BULLETS + BHS_SYM,X
+	INC
+	AND #$0003
+	STA BH_BULLETS + BHS_SYM,X
+@spin_next:
+	INX
+	INX
+	CPX #6
+	BCC @spin
+	; A (or the time limit) stops the next reel
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON
+	BNE @stop
+	LDA z:BH_FRAME
+	CMP #BH_SLOTS_FRAMES
+	BCC @loop
+@stop:
+	LDA z:BH_MG_COUNT
+	ASL
+	TAX
+	LDA #1
+	STA BH_BULLETS + BHS_STOP,X
+	TXA
+	LSR
+	STA z:BH_MG_FB_X        ; that reel bounces
+	LDA #12
+	STA z:BH_MG_FB_TIMER
+	LDA #SFX::CURSOR1
+	JSR BH_MG_SOUND
+	INC z:BH_MG_COUNT
+	LDA z:BH_MG_COUNT
+	CMP #3
+	BEQ @all_stopped
+	JMP @loop
+@all_stopped:
+	; three of a kind: perfect (sevens 120 %); a pair: good; nothing: ok (60 %)
+	LDA BH_BULLETS + BHS_SYM + 0
+	CMP BH_BULLETS + BHS_SYM + 2
+	BNE @not_three
+	CMP BH_BULLETS + BHS_SYM + 4
+	BNE @pair
+	LDA #0
+	JSR BH_GRADE_ATTACK
+	LDA BH_BULLETS + BHS_SYM + 0
+	CMP #2                  ; seven
+	BNE @fb0
+	LDA #120
+	STA z:BH_DMG_PCT
+@fb0:
+	LDA #0
+	BRA @feedback
+@not_three:
+	CMP BH_BULLETS + BHS_SYM + 4
+	BEQ @pair
+	LDA BH_BULLETS + BHS_SYM + 2
+	CMP BH_BULLETS + BHS_SYM + 4
+	BEQ @pair
+	LDA #2
+	JSR BH_GRADE_ATTACK
+	LDA #60
+	STA z:BH_DMG_PCT
+	LDA #1
+	STA z:BH_FORCE
+	LDA #2
+	BRA @feedback
+@pair:
+	LDA #1
+	JSR BH_GRADE_ATTACK
+	LDA #1
+@feedback:
+	JSR BH_GRADE_FEEDBACK
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #40
+	STA z:BH_FIGHT_TIMER
+	JMP @loop
+@end:
+	JMP BH_MG_FINISH
+
+; ---------------------------------------------------------------------------
+BH_RENDER_SLOTS:
+	JSR BH_MG_CENTRE
+	LDX #0
+@reel:
+	STX z:BH_T6
+	LDA BH_BULLETS + BHS_SYM,X
+	CLC
+	ADC #BH_TYPE_SLOT_CHERRY
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6             ; 2r
+	ASL
+	ASL
+	ASL
+	ASL                     ; 32 r
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #40
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	SEC
+	SBC #8
+	STA z:BH_T1
+	; a spinning reel jitters, a freshly stopped one bounces
+	LDX z:BH_T6
+	LDA BH_BULLETS + BHS_STOP,X
+	BNE @stopped
+	LDA z:BH_FRAME
+	AND #$0002
+	BEQ @put
+	INC z:BH_T1
+	BRA @put
+@stopped:
+	LDA z:BH_MG_FB_TIMER
+	BEQ @put
+	LDA z:BH_T6
+	LSR
+	CMP z:BH_MG_FB_X
+	BNE @put
+	LDA z:BH_MG_FB_TIMER
+	LSR
+	LSR
+	STA z:BH_T5
+	LDA z:BH_T1
+	SEC
+	SBC z:BH_T5
+	STA z:BH_T1
+@put:
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #6
+	BCC @reel
+	; the cursor line under the reel that stops next
+	LDA z:BH_FIGHT_STATE
+	BNE @label
+	LDA z:BH_MG_COUNT
+	CMP #3
+	BCS @label
+	LDA z:BH_FRAME
+	AND #$0008
+	BNE @label
+	LDA #BH_TYPE_BUTTON_A
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_MG_COUNT
+	ASL
+	ASL
+	ASL
+	ASL
+	ASL                     ; 32 r
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #40
+	STA z:BH_T0
+	LDA z:BH_LOOP_CNT
+	CLC
+	ADC #10
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+@label:
+	LDA z:BH_FIGHT_STATE
+	BEQ @done
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #22
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #4
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
+@done:
+	RTS
+
+; ===========================================================================
+; BH_COMBO_PHASE - press the five shown buttons in order before the bar empties
+; ===========================================================================
+BH_COMBO_PHASE:
+	LDA #5
+	STA z:BH_HINT_LEN
+	LDA #160
+	STA z:BH_T0
+	LDA #80
+	STA z:BH_T1
+	LDA #6
+	JSR BH_MG_START_NOOPEN
+	LDA #20
+	STA z:BH_DMG_PCT        ; a whiff until a press
+	LDA #2
+	STA z:BH_FIGHT_RESULT
+	STA z:BH_FORCE
+	STZ z:BH_FIGHT_TIME     ; next step
+	LDX #0
+@step:
+	JSL RAND
+	AND #$0003
+	STA BH_BULLETS + BHC_SEQ,X
+	STZ BH_BULLETS + BHC_ST,X
+	INX
+	INX
+	CPX #10
+	BCC @step
+	JSR BH_BOX_OPEN
+@loop:
+	JSR BH_MG_FRAME
+	BNE @alive
+	JMP @end
+@alive:
+	LDA z:BH_FIGHT_STATE
+	BNE @loop
+	LDA z:BH_FRAME
+	CMP #BH_COMBO_FRAMES
+	BCS @timeout
+	LDA PAD_PRESS
+	AND #PAD::A_BUTTON | PAD::B_BUTTON | PAD::X_BUTTON | PAD::Y_BUTTON
+	BEQ @loop
+	STA z:BH_T7
+	INC z:BH_MG_COUNT       ; presses
+	LDA z:BH_FIGHT_TIME
+	ASL
+	TAX
+	LDA BH_BULLETS + BHC_SEQ,X
+	ASL
+	TAY
+	PHX
+	TYX
+	LDA f:BH_LANE_BUTTON,X
+	PLX
+	CMP z:BH_T7             ; exactly that button
+	BNE @wrong
+	LDA #1
+	STA BH_BULLETS + BHC_ST,X
+	INC z:BH_MG_SCORE
+	LDA #SFX::CURSOR2
+	BRA @advance
+@wrong:
+	LDA #2
+	STA BH_BULLETS + BHC_ST,X
+	LDA #SFX::CURSOR_INVALID
+@advance:
+	JSR BH_MG_SOUND
+	INC z:BH_FIGHT_TIME
+	LDA z:BH_FIGHT_TIME
+	CMP #5
+	BCC @loop
+	BRA @grade_it
+@timeout:
+	; the steps left are out of time
+	LDA z:BH_FIGHT_TIME
+	ASL
+	TAX
+@late:
+	CPX #10
+	BCS @grade_it
+	LDA #3
+	STA BH_BULLETS + BHC_ST,X
+	INX
+	INX
+	BRA @late
+@grade_it:
+	LDA z:BH_MG_COUNT
+	BNE :+
+	LDA #3                  ; never pressed: the whiff stands, say so
+	JSR BH_GRADE_FEEDBACK
+	BRA @finish
+:
+	LDA z:BH_MG_SCORE
+	CMP #5
+	BEQ @g0
+	CMP #4
+	BEQ @g1
+	CMP #2
+	BCS @g2
+	LDA #3
+	BRA @grade
+@g0:
+	LDA #0
+	BRA @grade
+@g1:
+	LDA #1
+	BRA @grade
+@g2:
+	LDA #2
+@grade:
+	PHA
+	JSR BH_GRADE_ATTACK
+	PLA
+	JSR BH_GRADE_FEEDBACK
+@finish:
+	LDA #1
+	STA z:BH_FIGHT_STATE
+	LDA #36
+	STA z:BH_FIGHT_TIMER
+	JMP @loop
+@end:
+	JMP BH_MG_FINISH
+
+; ---------------------------------------------------------------------------
+BH_RENDER_COMBO:
+	JSR BH_MG_CENTRE
+	; the five steps: pending = its button (the next one bounces), right = spark, wrong/late = red block
+	LDX #0
+@icon:
+	STX z:BH_T6
+	LDA BH_BULLETS + BHC_ST,X
+	BEQ @pending
+	CMP #1
+	BEQ @spark
+	LDA #BH_TYPE_GAUGE_RED
+	BRA @have_type
+@spark:
+	LDA #BH_TYPE_SPARK
+	BRA @have_type
+@pending:
+	LDA BH_BULLETS + BHC_SEQ,X
+	ASL
+	TAX
+	LDA f:BH_LANE_TYPE,X
+@have_type:
+	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6             ; 2i
+	ASL
+	ASL
+	ASL                     ; 16i
+	STA z:BH_T0
+	LDA z:BH_T6
+	ASL                     ; 4i
+	CLC
+	ADC z:BH_T0             ; 20i
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #48
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #8
+	STA z:BH_T1
+	; the next step bounces while the game runs
+	LDA z:BH_FIGHT_STATE
+	BNE @put
+	LDA z:BH_T6
+	LSR
+	CMP z:BH_FIGHT_TIME
+	BNE @put
+	LDA z:BH_FRAME
+	LSR
+	LSR
+	AND #$0003
+	STA z:BH_T5
+	LDA z:BH_T1
+	SEC
+	SBC z:BH_T5
+	STA z:BH_T1
+@put:
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #10
+	BCC @icon
+	; the timer bar: one block per 20 frames left, red when short
+	LDA z:BH_FIGHT_STATE
+	BNE @label
+	LDA #BH_COMBO_FRAMES
+	SEC
+	SBC z:BH_FRAME
+	BCC @label
+	LDY #20
+	JSL DIVISION16S_DIVISOR_POSITIVE
+	STA z:BH_T7             ; blocks left (0-9)
+	BEQ @label
+	LDX #0
+@bar:
+	STX z:BH_T6
+	TXA
+	LSR
+	CMP z:BH_T7
+	BCS @label
+	LDA #BH_TYPE_GAUGE_GRN
+	LDX z:BH_T7
+	CPX #6
+	BCS :+
+	LDA #BH_TYPE_GAUGE_YEL
+	CPX #3
+	BCS :+
+	LDA #BH_TYPE_GAUGE_RED
+:	JSR BH_TILE_FOR_TYPE
+	LDA z:BH_T6
+	ASL
+	ASL
+	ASL                     ; 16i
+	CLC
+	ADC z:BH_PAT_WAIT
+	SEC
+	SBC #72
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #30
+	STA z:BH_T1
+	JSR BH_OAM_PUT
+	LDX z:BH_T6
+	INX
+	INX
+	CPX #18
+	BCC @bar
+@label:
+	LDA z:BH_PAT_WAIT
+	SEC
+	SBC #22
+	STA z:BH_T0
+	LDA z:BH_BOX_Y0
+	CLC
+	ADC #48
+	STA z:BH_T1
+	JMP BH_MG_FLOAT_LABEL
diff --git a/src/battle/bullet_hell/bh_window_hook.asm b/src/battle/bullet_hell/bh_window_hook.asm
new file mode 100644
index 00000000..d88dec69
--- /dev/null
+++ b/src/battle/bullet_hell/bh_window_hook.asm
@@ -0,0 +1,14 @@
+; ---------------------------------------------------------------------------
+; BH_WINDOW_CONFIG_PTR - called by CREATE_WINDOW in place of its
+;   LOADPTR WINDOW_CONFIGURATION_TABLE, @VIRTUAL06 (Y = window id, D = its
+;   stack frame, so the pointer goes to $06). The dodge box borrows window id
+;   $24 (the naming-screen confirmation, never open in battle) and its
+;   geometry lives in RAM at BH_BULLETS + BHW_CFG. Sits at the end of bank $C1
+;   so the rest of the bank keeps its original layout.
+; ---------------------------------------------------------------------------
+BH_WINDOW_CONFIG_PTR:
+	LOADPTR WINDOW_CONFIGURATION_TABLE, $06
+	CPY #WINDOW::FILE_SELECT_NAMING_CONFIRMATION_MESSAGE
+	BNE :+
+	LOADPTR BH_BULLETS + BHW_CFG - WINDOW::FILE_SELECT_NAMING_CONFIRMATION_MESSAGE * 8, $06
+:	RTS
