+; ===========================================================================
+; B19 Count steps - a ring sits p1 steps left or right of the heart; every
+;   Left / Right press moves the heart one step (p0 px, less when the box is
+;   too small); A (or the timer, p2 frames) settles it: the steps still
+;   between them grade it. D = direction, B = step px, C = the ring's x.
+; ===========================================================================
+BH_AG_STEPS_INIT:
+	LDA BH_AG_STATE + BHAG_Q0
+	STA BH_AG_STATE + BHAG_B
+	LDA BH_AG_STATE + BHAG_Q1
+	CMP #5
+	BCC :+
+	LDA #12
+	STA BH_AG_STATE + BHAG_B
+:	LDA BH_AG_STATE + BHAG_Q2
+	STA BH_AG_STATE + BHAG_TIMER
