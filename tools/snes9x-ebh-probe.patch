+/* ebharness probe: the 65816 registers after the last retro_run (pc = PBPC, s, d, db, a, x, y, p) */
+extern "C" RETRO_API void ebh_get_cpu(uint32_t *out)
+{
+    out[0] = Registers.PBPC;
+    out[1] = Registers.S.W;
+    out[2] = Registers.D.W;
+    out[3] = Registers.DB;
+    out[4] = Registers.A.W;
+    out[5] = Registers.X.W;
+    out[6] = Registers.Y.W;
+    out[7] = Registers.P.W;
+}
